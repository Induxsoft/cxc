#include "dkli.dkh"
#!
module
{
	if not(isset("@http_context")) && isset("@crud_context") { ref @http_context = @@(@crud_context,"&http") }

	//* ======================================== [ CONSTANTS ]
	//#region cxc.destino
	@CXC_DESTINO_APLICACION_INT_FINANCIEROS = 1
    @CXC_DESTINO_APLICACION_INT_MORATORIOS = 2
    @CXC_DESTINO_APLICACION_BONIFICACIONES = 3
    @CXC_DESTINO_APLICACION_PAGOS = 4
	//#endregion

	// Formato de presentación
	@THOUSANDS_SEPARATOR = ","
	@DECIMAL_SEPARATOR = "."
	@DECIMAL_PRECISION = 2

	//
	@curr_ndt = ndatetime.now()
    @curr_year = ndatetime.year(@curr_ndt)
    @curr_month = ndatetime.month(@curr_ndt)
    @curr_day = ndatetime.day(@curr_ndt)

	/**
	* Clave Primaria (PK) de la divisa predeterminada
	* 0 : Se obtiene la divisa de las variables globales (glovalbar), 1 por defecto si no existe.
	*/
	@IDIVISA_PREDETERMINADA = 0

	// Ubicacion predeterminada
	@IPAIS = 1 //"México"
	@IESTADO = 7 //"Chiapas"
	@ICIUDAD = 396//"Tuxtla Gutiérrez"

	// Formato de moneda (dkl)
	@FMT_MONEY = "$ "+"#"+@THOUSANDS_SEPARATOR+"0"+@DECIMAL_SEPARATOR+padright("",@DECIMAL_PRECISION,"0")

	//* ======================================== [ _STATIC RESOURCES ]
	@CSS_MAIN = "/$/cxc/css/main.css"
	@JS_CLIENTES = "/$/cxc/js/clientes.js"
	@JS_DOCUMENTOS = "/$/cxc/js/documentos.js"
	@JS_BS_MODALS = "/$/cxc/js/modals.js"
	@JS_FILTER = "/$/cxc/js/filter.js"

	//* ======================================== [ _PACKAGE ]
	@CXC_MENU = "/!/cxc/"
	@BATCH_TASKMAN="/!/batch/taskman/"

	@efectivo_retiro="/!/efectivo/movcuenta/retiro/rel_efect_mov/?importe=@importe&divisa=@divisa&tcambio=@tcambio&cuenta=@cuenta&s=@search"
	@efectivo_deposito="/!/efectivo/movcuenta/deposito/rel_efect_mov/?importe=@importe&divisa=@divisa&tcambio=@tcambio&cuenta=@cuenta&s=@search"
	
	//bitacora
	@URL_BITACORA="/!/webshell/log/DET01D/@guid/"
	//#region services
	@CXC_BUSCAR_CLIENTE = "/!/cxc/clientes/?_view=buscar-cliente&search=@search"
	@CXC_BUSCAR_CONTACTO = "/!/cxc/clientes/?_view=buscar-contacto&search=@search"
	@CXC_BUSCAR_EDOPROV = "/!/cxc/clientes/?_view=buscar-edoprov&search=@search"
	@CXC_BUSCAR_CIUDAD = "/!/cxc/clientes/?_view=buscar-ciudad&search=@search"
	@CXC_BUSCAR_TCLIENTE = "/!/cxc/clientes/?_view=buscar-tcliente&search=@search"
	//#endregion

	//#region cxc_clientes
	@CXC_CLIENTES = "/!/cxc/clientes/"
	@CTE_AGREGAR = "/!/cxc/clientes/_new/"
	@CTE_CONSULTAR = "/!/cxc/clientes/{_cliente}/"
	@CTE_EDO_CTA = "/!/cxc/clientes/{_cliente}/balance/"
	@CTE_DOCS_XCOBRAR = "/!/cxc/clientes/{_cliente}/pendientes/"
	@CTE_COBROS_XAPLICAR = "/!/cxc/clientes/{_cliente}/xaplicar/"
	@CTE_COBROS = "/!/cxc/clientes/{_cliente}/cobrar/"
	@CTE_BONIFICACIONES = "/!/cxc/clientes/{_cliente}/bonificacion/"
	//#endregion

	@CTE_AGREGAR_TIPO = "/!/cxc/clientes/_new/tipo"

	//#region cxc_docs
	@CXC_DOCUMENTOS = "/!/cxc/documentos/"
	@DOC_AGREGAR = "/!/cxc/documentos/_new/"
	@DOC_CONSULTAR = "/!/cxc/documentos/{_documento}/"
	@DOC_COBROS = "/!/cxc/documentos/{_documento}/cobrar/"
	@DOC_BONIFICACIONES = "/!/cxc/documentos/{_documento}/bonificacion/"
	@DOC_INTMORATORIOS = "/!/cxc/documentos/{_documento}/intmoratorios/"
	@DOC_APLICAR_ABONOS = "/!/cxc/documentos/{_documento}/aplicar/"
	//#endregion

	// Número máximo de filas a mostrar en lista
	@default_max_rows=250

	// Rutas estáticas (using include)
	@PATH_DATE_FILTER = ""
	@PATH_PRINT_LIST = "compras/_lib/print_list.dk"
	@URL_BUSCAR_PRODUCTO = "/!/cxc/precioventa/?_view=buscar-producto&search=@search"
	//json
	@REGIMEN_FISCAL="./cxc/_static/json/sat.c_RegimenFiscal.json"
}