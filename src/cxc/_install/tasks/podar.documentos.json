{
    "ff": {
        "control":"date",
        "required":"true",
        "caption":"Fecha de corte",
        "wrp_attr": {
            "class":"col-auto"
        }
    },
    "truncate": {
        "control":"bool",
        "caption":"Truncar datos",
        "source": {
            "type":"query",
            "query":"SELECT sys_pk, CONCAT(codigo,' - ',descripcion) descripcion FROM categoria WHERE NOT IFNULL(sys_deleted,0) AND tipo=3 ORDER BY codigo;",
            "keyfield":"sys_pk",
            "showfield":"descripcion"
        },
        "wrp_attr": {
            "class":"col-auto form-check align-self-center"
        }
    }
}