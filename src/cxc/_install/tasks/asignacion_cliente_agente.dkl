#include "dkli.dkh"
#!
program ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "dbr.security.dkl"
    #include "batch.v12.dkl"

    do @context.begin(@batch_context)

    @qname = @("$qname")
    @token = @("$job/token")

    function getClient(&db,cte)
    {
        cte >> params
        ref cliente = dbr.rec(db,"
            SELECT
                c.sys_pk
            FROM cliente c
            WHERE (c.sys_guid = @cte OR c.codigo = @cte)
        ",params)

        return cliente
    }
    function getAgente(&db,cod)
    {
        cod >> params
        ref agente = dbr.rec(db,"
            SELECT
                c.sys_pk
            FROM agente c
            WHERE (c.sys_guid = @cte OR c.codigo = @cod)
        ",params)

        return agente
    }
    function between(value,min,max)
    {
        return value >= min && value <= max
    }
    function updatePercent(value)
    {
        new params
        {
            @"token":@token
        }
        new data
        {
            @"percentage":value
            @"progress_type":2
        }
        do dbr.update(batch.openDB(),"job",data,"sys_guid=@token",params)
    }
    function import(&db,&data)
    {
        length = list.count(data)
        if length < 1 
        {
            do batch.saveLog(@token,"Nada para importar.")
            do updatePercent(100)
            return
        }

        do batch.saveLog(@token,"> Relacionando agentes...")

        progress = (100 / length)
        affected_rows = 0
        percent = 0

        for i = 0; i < length
        {
            ref item = record.caseinsensitive(list.obj(data,i))
            codcliente=trim(@@(item,"$cliente"))
            codagente=trim(@@(item,"$agente"))

            ref cliente=getClient(db,codcliente)
            if isnull(cliente){do rise_error(512,"No se encontro información del 'cliente' proporcionado.")}

            new data_cliente
            {
                @"agente*":@null
            }
            if codagente!=""
            {
                ref agente=getAgente(db,codagente)
                if isnull(agente){do rise_error(512,"No se encontro información del 'agente' proporcionado.")}
                data_cliente<"agente">:@@(agente,"#sys_pk")
            }

            do dbr.update(db,"cliente",data_cliente,"sys_pk=@sys_pk",cliente)
            
            affected_rows = affected_rows + 1

            exception
            {
                code = last_error_code()
                error = last_error()
                
                if between(code,511,589) 
                {
                    do pop_exception()
                    do batch.saveLog(@token,error +"\r\n"+ to.json(item))
                }
                else 
                {
                    do rise_error(code,error)
                }
            }

            percent = percent + progress
            do updatePercent(percent)
        }

        do batch.saveLog(@token,"** Agentes relacionados ("+str(affected_rows)+"/"+str(length)+")")
    }
    //#region >FUNCIONES
    ref lib_csv = _import_library("devkron.serialize.csv.dll")
    do _map_function(lib_csv,"devkron.serialize.csv.csvHelper","CsvRead","csv.read","System.String,System.String","*")
    do _map_function(lib_csv,"devkron.serialize.csv.csvHelper","CsvWrite","csv.write","System.String,*System.Object","void")
    

    module "Inicio"
    {
        //#region >INICIO
        fsrc = @("$params/archivo")

        if fsrc == "" { do rise_error(511,"El 'Archivo a importar' es requerido.") }
        if not(file.exists(fsrc)) { do rise_error(512,"No se encontro el archivo a importar.") }
        if file.extension(fsrc)!=".csv" { do rise_error(513,"Se esperaba un archivo de tipo `csv`.") }

        do batch.v12.grant("GB2B") //GB2B - Permitir asignación masiva de agentes
        ref db = @("&database")
        ref data = csv.read(fsrc,"")
        
        do import(db,data)

        if file.exists(fsrc) { do file.delete(fsrc) }

        exception
        {
            code = last_error_code()
            error = last_error()

            if file.exists(fsrc) { do file.delete(fsrc) }
            if isset("db") {
                if dbr.in_transaction(db) { do dbr.rollback(db) }
            }
            do rise_error(code,error)
        }
    }
    do @context.end()
}