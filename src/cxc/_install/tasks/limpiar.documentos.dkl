#include "dkli.dkh"
#!
program "Limpiar movimientos por cobrar"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "dbr.security.dkl"
    #include "batch.v12.dkl"

    do @context.begin(@batch_context)

    module "Contantes"
    {
        //#region >CONTANTES
        do errordet(@false)

        @qname = @("$qname")
        @token = @("$job/token")
    }
    module "Funciones"
    {
        //#region >FUNCIONES
        function UpdatePercent(value)
        {
            new params
            {
                @"token":@("$job/token")
            }
            new data
            {
                @"percentage":value
                @"progress_type":2
            }
            do dbr.update(batch.openDB(),"job",data,"sys_guid=@token",params)
        }
    }
    module "Ejecución"
    {
        //#region >EJECUCIÓN
        do batch.v12.grant("GBF2") //GBF2 - Limpiar movimientos por cobrar
        
        ref params = @("&params")
        ref db = @("&database")

        icliente = @@(params,"#icliente")
        confirmed = parse.bool(@@(params,"$confirm_GBF2"))
        
        if not(confirmed) { do rise_error(511,"No se confirmo la acción.") }
        params<"icliente"> : icliente

        do dbr.begin(db)

        if icliente > 0 {
            cliente = dbr.str(db,"select concat(codigo,' - ',nombre) from cliente where sys_pk = @icliente",params)
            do batch.saveLog(@token,"> "+cliente)
        }

        do batch.saveLog(@token,"Limpiando aplicaciones de movimientos por cobrar...")
        do dbr.execute(db,"
            DELETE apl
            FROM aplcxc apl
                JOIN dcxc cxc ON (apl.fk_dcxc_aplicadoa = cxc.sys_pk OR apl.aplicadoa = cxc.sys_pk)
            WHERE IF(@icliente < 1, TRUE, cxc.icliente = @icliente)
        ",params)
        do UpdatePercent(33)

        codeblock "Quitar relación. ut_cfd -> dcxc"
        {
            if dbr.str(db,"SHOW TABLES LIKE 'ut_cfd';",@null) != ""
            {
                do batch.saveLog(@token,"Limpiando relación: ut_cfd -> dcxc")
                do dbr.execute(db,"
                    UPDATE ut_cfd cfd
                        INNER JOIN dcxc cxc ON cfd.uf_idcxc = cxc.sys_pk
                    SET cfd.uf_idcxc = NULL
                    WHERE IF(@icliente < 1, TRUE, cxc.icliente = @icliente)
                ",params)
            }
            exception
            {
                error = last_error()
                do pop_exception()
                do batch.saveLog(@token,"No fue posible desvincular los documentos timbrados: "+error)
            }
        }

        do batch.saveLog(@token,"Limpiando movimientos por cobrar...")
        do dbr.execute(db,"DELETE FROM dcxc WHERE IF(@icliente < 1, TRUE, icliente = @icliente)",params)
        do UpdatePercent(66)

        do batch.saveLog(@token,"Limpiando saldo(s) de cliente(s)...")
        do dbr.execute(db,"UPDATE cliente SET saldo = 0 WHERE IF(@icliente < 1, TRUE, sys_pk = @icliente)",params)
        do UpdatePercent(99)

        do dbr.commit(db)
        do UpdatePercent(100)
        do batch.saveLog(@token,"**Operación completada.")

        exception
        {
            code = last_error_code()
            error = last_error()

            if isset("db") {
                if dbr.in_transaction(db) { do dbr.rollback(db) }
            }
            do rise_error(code,error)
        }
    }

    do @context.end()
}