#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)

    ref documento = ifnull(@("&./dcxc"), record.create())

    @_entities_type = @("$parameters/_entities_type")
    @_entity_id     = @("$parameters/_entity_id")
    @is_new         = (@_entity_id == "_new")
    @form_id        = "frm_"+@_entities_type

    // Serializar datos del documento para el InputKey (data-value)
    documento_json = to.json(documento)

    function printNavButtons()
    {
        cls = "btn btn-main-action btn-sm border-secondary induxsoft-corners"
        #$
        button(class="#<cls>" type="submit" form="#<@form_id>" title="Guardar"){$"Guardar"}
        #!
    }
    point buttons to printNavButtons

    new nav_config
    {
        @"title": ifstr(@is_new,"Agregar","Editar") + " contacto de cobranza"
        @"buttons*": buttons
        member @"hidden"
        {
            @"copy":  @true
            @"csv":   @true
            @"print": @true
            @"send":  @true
        }
    }

    #$
    div(class="container-lg" id="view")
    {
        section(id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$
        }

        section(id="work_area" style="overflow-y:auto; overflow-x:hidden;")
        {
            #!
            error = @("$error/message")
            if error != ""
            {
                #$
                div(class="alert alert-danger alert-dismissible fade show mb-2 pb-1" role="alert")
                {
                    div(class="w-100 overflow-auto pb-2"){$"#<error>"}
                    button(type="button" class="btn-close" "data-bs-dismiss"="alert" "aria-label"="Close"){""}
                }
                #!
            }
            #$

            form(class="px-1" action="./" method="POST" id="#<@form_id>")
            {
                input(type="hidden" name="sys_pk"     value="#<@('#./sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@('#./sys_recver')>")
                #!
                do uie.print_from_url_field()
                #$

                div(class="row g-3")
                {
                    // Documento
                    div(class="col-12")
                    {
                        label(class="form-label" "for"="idoc"){$"Documento por cobrar al que aplica el acuerdo"}
                        "input-key"(
                            id="idoc"
                            name="idoc"
                            "data-key"="sys_pk"
                            "data-search"="referencia"
                            "data-text"="cliente_nombre"
                            "data-value"="#<documento_json>"
                            "data-source"="/!/cxc/acuerdo-pago/?_action=search-document-with-balance&search=@search"
                            columns="referencia,cliente_nombre,moneda,total,saldo,vencimiento"
                            colcaptions="Documento,Cliente,Moneda,Total,Saldo,Vencimiento"
                            required=""
                        ){$""}

                        div(id="document-info"){""}
                    }
                    // Fecha acuerdo
                    div(class="col-md-3")
                    {
                        label(class="form-label" "for"="fecha_acuerdo"){"Fecha acuerdo"}
                        input(class="form-control rounded-0" type="date" name="fecha_acuerdo" value="#<@('$./fecha_acuerdo')>" id="fecha_acuerdo")
                    }
                    // Monto acuerdo
                    div(class="col-md-3")
                    {
                        label(class="form-label" "for"="monto_acuerdo"){"Monto acuerdo"}
                        input(class="form-control rounded-0" type="number" name="monto_acuerdo" value="#<@('#./monto_acuerdo')>" id="monto_acuerdo" min="0" step="0.01")
                    }
                    // Fecha pago
                    div(class="col-md-3")
                    {
                        label(class="form-label" "for"="fecha_pago"){"Fecha pago"}
                        input(class="form-control rounded-0" type="date" name="fecha_pago" value="#<@('$./fecha_pago')>" id="fecha_pago")
                    }
                    // Cumplido
                    div(class="col-md-3 align-self-end pt-2")
                    {
                        #!
                        checked = ifstr(@("#./cumplido"), "checked", "")
                        #$
                        div(class="form-check")
                        {
                            input(class="form-check-input" type="checkbox" name="cumplido" id="cumplido" "#<checked>"="")
                            label(class="form-check-label" "for"="cumplido"){"Cumplido"}
                        }
                    }
                    // Notas
                    div(class="col-12")
                    {
                        label(class="form-label" "for"="notas"){"Notas"}
                        textarea(class="form-control rounded-0" name="notas" id="notas" rows="3"){$"#<@('$./notas')>"}
                    }
                    // Contacto
                    div(class="col-12 col-md-6")
                    {
                        label(class="form-label" "for"="contacto"){"Contacto"}
                        input(class="form-control rounded-0" type="text" name="contacto" id="contacto" value="#<@('$./contacto')>" maxlength="80")
                    }
                }
            }
        }

        section(id="bottom_area")
        {
            div(id="_custom_area")
            {
                script(src="/$/cxc/js/acuerdo_pago.js"){""}
                script(type="text/javascript")
                {$'
                    document.addEventListener("DOMContentLoaded", () => {
                        // Script injection
                        #<@@(@crud_context,"$script")>
                    });
                '}
            }
        }
    }
    #!

    do @context.end()
}
