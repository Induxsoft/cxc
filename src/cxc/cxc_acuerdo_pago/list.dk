#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"

    do @context.begin(@crud_context)

    ref data   = ifnull(@("&./data"),  list.create())
    ref titles = ifnull(@("&./titles"), record.create())

    @_entities_type = @("$parameters/_entities_type")

    table_id   = "tbl_"+@_entities_type
    tbtn_style = "cursor:pointer; text-decoration:none; border:none; outline:none; padding: 0px 8px; background-color:#F5F5F5; color:#000000;"

    new table_definition
    {
        @"datatable*": data
        member @"columns"
        {
            member @"cliente_codigo" { @"caption":"Cód. cliente" }
            member @"cliente_nombre" { @"caption":"Cliente" }
            member @"referencia" { @"caption":"Documento" }
            member @"saldo"
            {
                @"caption":"Saldo"
                @"align":"end"
                @"format": @true
                @"thousandssep": @true
                @"decs": 2
            }
            member @"moneda"
            {
                @"caption":"Moneda"
                @"align":"center"
            }
            member @"fecha_acuerdo"
            {
                @"caption":"F. Acuerdo"
                @"align":"center"
            }
            member @"monto_acuerdo"
            {
                @"caption":"Monto"
                @"align":"end"
                @"format": @true
                @"thousandssep": @true
                @"decs": 2
            }
            member @"fecha_pago"
            {
                @"caption":"F. Pago"
                @"align":"center"
            }
            member @"vigente"
            {
                @"caption":"Vigente"
                @"align":"center"
            }
            member @"cumplido"
            {
                @"caption":"Cumplido"
                @"align":"center"
            }
        }
        @"table_footer": "Mostrando los primeros # registros"
    }

    new nav_config
    {
        @"title":          "Acuerdos de pago"
        @"urlexit":        "/"
        @"actions*":       ifnull(@("&./itemactions"), list.create())
        @"reports*":       ifnull(@("&./itemreports"), list.create())
        @"jscurrentcontext": "getCurrentContext"
    }

    new date_range
    {
        @"start": @("$parameters/fi")
        @"end": @("$parameters/ff")
    }

    new fil_vigentes
    {
        @"id": "vigentes"
        @"text_field": "const"
        @"value_field": "id"
        @"datatable*": from.json('[
            { "id":-1, "const": "(Vigentes / Vencidos)" },
            { "id": 1, "const": "Vigentes" },
            { "id": 0, "const": "Vencidos" }
        ]')
        @"selected": @("parameters/vigentes")
        member "attributes"
        {
            @"class": "form-select rounded-0"
            @"name": "vigentes"
            @"onchange": "filter(this)"
        }
    }

    new fil_cumplidos
    {
        @"id": "cumplidos"
        @"text_field": "const"
        @"value_field": "id"
        @"datatable*": from.json('[
            { "id":-1, "const": "(Cumplidos / Pendientes)" },
            { "id": 1, "const": "Cumplidos" },
            { "id": 0, "const": "Pendientes" }
        ]')
        @"selected": @("parameters/cumplidos")
        member "attributes"
        {
            @"class": "form-select rounded-0"
            @"name": "cumplidos"
            @"onchange": "filter(this)"
        }
    }

    #$
    div(class="container-fluid" id="view")
    {
        section(id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$

            form(class="mb-1 d-flex gap-2 align-items-center" action="./" method="GET" id="form-filter")
            {
                div(class="d-flex align-items-center gap-2 flex-wrap w-100 py-1")
                {
                    div(class="d-flex gap-2")
                    {
                        div
                        {
                            "date-range"(class="w-100" "hidden-input-name-start"="fi" "hidden-input-name-end"="ff" data='#<to.json(date_range)>'){""}
                        }
                        div{ #! do uie.dbSelect(fil_vigentes) } #$
                        div{ #! do uie.dbSelect(fil_cumplidos) } #$
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-text"(
                            class="w-100"
                            "text-field"="search"
                            value="#<@('$parameters/search')>"
                            placeholder="Buscar por cliente o referencia del documento ..."
                            "form"="#form-filter"
                            "auto-submit"="true"
                        ){$""}
                    }
                }
            }
        }

        section(id="work_area")
        {
            div(class="show-on-print")
            {
                p(class="text-center my-0"){$"#<@@(titles,'$title')>"}
                p(class="text-center my-0"){$"#<@@(titles,'$subtitle')>"}
                p(class="text-center my-0"){$"#<@@(titles,'$subtitle_2')>"}

                div(class="row")
                {
                    div(class="col-3 text-start")
                    {
                        small(class="d-block"){$"#<cut(@('$http/session/user/name'),25)>"}
                        small(class="d-block"){$"#<date_str(now(),'dd/MMM/yyyy')>"}
                    }
                    div(class="col-6 text-center")
                    {
                        h4{$"Acuerdos de pago"}
                    }
                    div(class="col-3 text-end")
                    {
                        small(class="d-block" id="lbl_filter_1"){$""}
                        small(class="d-block" id="lbl_filter_2"){$""}
                    }
                }
            }

            #!
            do uie.dbeditable(table_definition, table_id)
            #$

            div(class="show-on-print")
            {
                p(class="fixed-bottom text-center my-1"){$"#<@@(titles,'$footer')>"}
            }
        }

        section(id="bottom_area")
        {
            div(id="_custom_area")
            {
                script(type="text/javascript")
                {$'
                    function filter(ff) { ff.form.submit(); }

                    function getCurrentContext() {
                        const table = document.getElementById("#<table_id>");
                        const id = (table?.DataArray[table.CurrentRowIndex()]?.sys_pk ?? "");
                        return { item_id: id, context: {} };
                    }

                    document.addEventListener("DOMContentLoaded", () => {
                        const date_range = document.querySelector("date-range");

                        date_range.onChanging = (oldData,newData) => { date_range.setData(newData) };
                        date_range.onChange = (data) => { filter(date_range._hiddenInputStr) };

                        #<@@(@crud_context,"script")>
                    });
                '}
            }
        }
    }
    #!

    do @context.end()
}
