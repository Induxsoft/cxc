#include "dkli.dkh"
#!
module "Reportes de Cuentas por Cobrar"
{
    prepareView::&db,&params,&data
    {
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }

        sql_tiposcliente = "SELECT sys_pk, descripcion FROM tipocliente WHERE NOT IFNULL(sys_deleted,0)"

        switch @@(@http_context,"$request/get/_entity_id")
        {
            case "antiguedad-saldos"
            {
                using data
                {
                    @"list_tipos*": dbr.list(db,sql_tiposcliente,@null)
                }
                break
            }
        }

        do prepareDefaultReportData(db,data)
    }

    prepareDefaultReportData::&db,&data
    {
        using data
        {
            member @"titles"
            {
                @"title": dbr.vars.getd(db,"FXCA108","")
                @"subtitle": dbr.vars.getd(db,"FXCA109","")
                @"subtitle_2": dbr.vars.getd(db,"FXCA110","")
                @"footer": dbr.vars.getd(db,"FXCA111","")
            }
        }
    }

    antiguedadSaldos::&db,&params
    {
        do dbr.apps.action.grant("GB30")

        sql_antiguedad_saldo = "
        SELECT
            dcxc.sys_pk,
            DATE_FORMAT(dcxc.aplicacion,'%d/%m/%Y') AS aplicacion,
            DATE_FORMAT(dcxc.fecha,'%d/%m/%Y') AS fecha,
            dcxc.referencia,
            z.codigo,
            z.nombre,
            z.rfc,
            z.telefonos,
            cdocumentos.const AS documento,
            DATEDIFF(@fil_fcorte, dcxc.aplicacion) AS dias,
            (dcxc.debe + dcxc.intmoratorios - dcxc.bonificaciones - dcxc.pagos) AS saldo
        FROM
            (
                cliente z
                INNER JOIN (
                    cdocumentos
                    INNER JOIN dcxc ON cdocumentos.id = dcxc.documento
                ) ON z.sys_pk = dcxc.icliente
            )
        WHERE
            dcxc.aplicable <> 0
            AND (dcxc.debe + dcxc.intmoratorios - dcxc.bonificaciones - dcxc.pagos) <> 0
            #<conditions>
        ORDER BY z.nombre;
        "

        conditions = ""
        if not(field.exist(params,"fil_fcorte")) { params<"fil_fcorte"> : hoy("yyyy-MM-dd") }
        if replace(@@(params,"$fil_tipo"),"*","") != "" { conditions = conditions + " AND z.tipo = @fil_tipo" }

        new data
        {
            @"list*": dbr.list(db,ftext(sql_antiguedad_saldo),params)
        }
        do prepareView(db,params,data)

        return data

        exception{ do catch() }
    }

    origenAplicacion::&db,&params
    {
        do dbr.apps.action.grant("GB31")

        sql = "
        select
            a.destino,
            a.sys_pk kapp,
            x.aplicacion fapl,
            x.referencia origen,
            y.fecha fdoc,
            y.aplicacion fcxp,
            y.referencia aplicacion,
            if(a.destino=3,a.importe,0) bonificaciones,
            if(a.destino=4,a.importe,0) pagos,
            c.codigo,
            c.nombre,
            y.debe as importe,
            y.bonificaciones as ac_bonificaciones,
            y.pagos as ac_pagos,
            (y.debe + y.intmoratorios - y.bonificaciones - y.pagos) as saldo
        from aplcxc a
            inner join dcxc x on a.fk_dcxc_aplicadoa=x.sys_pk
            inner join dcxc y on a.aplicadoa=y.sys_pk 
            inner join cliente c on y.icliente=c.sys_pk
        where y.fecha between @finicio and @ffinal
        order by y.fecha, y.sys_pk, x.aplicacion
        ;"

        new data
        {
            @"data*": dbr.list(db,sql,params)
        }
        do prepareView(db,params,data)

        return data

        exception{ do catch() }
    }

    NotImplemented::&db,&params { do rise_error(404,"Reporte no implementado") }

    catch::
    {
        do errordet(@false)
        code = last_error_code()
        error = last_error()

        if isset("@@_action_context"){ do dbr.apps.action.log() }
        do rise_error(code,error)
    }
}