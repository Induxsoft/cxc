#include "dkli.dkh"
#!
module ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)

    ref entity = ifnull(@("&./entity"),record.create())
    ref detail = ifnull(@("&./details"),list.create())

    @_entity_id = @("$parameters/_entity_id")
    @is_new = (@_entity_id == "_new")

    fn_print_buttons::
    {
        act_btn_cls = "btn btn-sm border-secondary induxsoft-corners btn-main-action"
        
        #$
        button(class="#<act_btn_cls>" type="button" id="btn_guardar"  title="Aceptar"){$"#<@ICON_SAVE>"}
        #!
    }
    point print_buttons to fn_print_buttons
    new nav_config
    {
        @"title":"Precios de venta [ "+@("$./cliente/codigo")+" - "+@("$./cliente/nombre")+"]"
        @"buttons*": print_buttons
        @"urlexit": @CXC_CLIENTES
        @"print_mode": 0 // 0-window.print(), 1-v12PrintHTML()
        member @"hidden"{@"send":@true}
    }

    do AutoFillRows(detail,10)

    #$ div(class="container-lg v12-form-view" id="view")
    {
        script(src="#<@JS_CLIENTES>"){""}
        section(id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$
        }
        section(id="work_area")
        {
            form(action="." mehtod="POST" id="form_precioventa")
            {
                input(type="hidden" class="induxsoft-form-control" id="data_array" name="data_array")

                div(class="")
                {
                    div(class="d-flex justify-content-end")
                    {
                        button(type="button" class="control btn btn-sm btn-main-action d-flex align-items-center justify-content-center gap-2 no-shadow induxsoft-corners" onclick="cliente.precioventa.addRow()")
                        {
                            $'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2"/>
                            </svg>'
                            "Agregar fila"
                        }
                        button(type="button" class="control btn btn-sm btn-main-action d-flex align-items-center justify-content-center gap-2 no-shadow induxsoft-corners" onclick="cliente.precioventa.deleteRow()")
                        {
                            $'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                            <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5"/>
                            </svg>'
                            "Eliminar fila"
                        }
                    }
                    
                    div(class="mt-2" id="div_tbl_productos" style="display:flex;width:auto;min-width:100%;")
                    {
                        div
                        {
                            "input-key"(id="ik_producto" "data-key"="sys_pk" "data-search"="codigo" "data-text"="descripcion" "data-source"="#<@URL_BUSCAR_PRODUCTO>" columns="codigo,descripcion,divisa" colcaptions="Código,Descripción,Divisa" "box-title-text"="Seleccione un producto de la lista" "hidden-input"="false" "control-styles"="#container{display:none !important;}"){$""}
                        }

                        "edit-table"(id="tbl_precioventa" data="#<to.json(detail)>" class="printable-element" style="width:100%;"
                        "auto-confirm"="true"
                        "row-height"="1.2rem"
                        "control-styles"="")
                        {
                            "edit-thead"
                            {
                                "edit-tr"
                                {
                                    "edit-th"(type="NoEditable" field="codigo"  button="true"){$"Código"}
                                    "edit-th"(type="NoEditable" field="descripcion" button="true"){$"Descripción"}
                                    "edit-th"(type="NoEditable" field="costo" prefix="$ " textalign="end" format="true" thousandssep="true" decs="#<@DECIMAL_PRECISION>"){$"Costo"}
                                    "edit-th"(type="Number" field="precio" prefix="$ " textalign="end" format="true" thousandssep="true" decs="#<@DECIMAL_PRECISION>"){$"Precio"}
                                    "edit-th"(type="Number" field="limite" textalign="center"){$"Venta mínima"}
                                    "edit-th"(type="NoEditable" field="unidad"){$"Unidad"}
                                }
                            }
                        }
                    }
                }
            }
        }
        script
        {
            $'
            document.addEventListener("DOMContentLoaded",()=>
            {
                cliente.precioventa.init();
            });
            '
        }
        style
        {
            $'
            #v12FormBar_title
            {
                overflow: visible !important;
            }
            '
        }
    }
}