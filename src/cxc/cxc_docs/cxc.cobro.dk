#include "dkli.dkh"
#!
module "cxc.cobro.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"
    #include "dbr.dkh"
    #include "dbr.vars.dkl"

    do @context.begin(@crud_context)
    
    ref formData = ifnull(@("&./form"),record.create())
    ref infoDoc = ifnull(@("&./infoDoc"),record.create())
    ref cuentas = ifnull(@("&./cuentas"),list.create())
    ref categorias = ifnull(@("&./categorias"),list.create())
    ref docDepositos = ifnull(@('&./docDepositos'),list.create())
    ref docCobros = ifnull(@('&./docCobros'),list.create())
    ref dvsPred = ifnull(@("&./dvsPred"),record.create())

    @DECIMAL_PRECISION = @("#./decimals")
    @IDIVISA_PREDETERMINADA = field.dnum(dvsPred,"sys_pk",0)
    cDIVISA_PRED = field.dstr(dvsPred,"codigo","MXN")
    tCAMBIO_PRED = field.dnum(dvsPred,"tcambio",1)
    num_step = "0."+padright("",(@DECIMAL_PRECISION-1),"0")+"1"

    new sel_cuenta_deposito
    {
        @"datatable*": cuentas
        @"id": "sel_cuenta_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "cuenta_deposito"
        }
        new member "attr_options"
        {
            @"data-divisa": "#<@@(row,'$divisa')>"
            @"data-tcambio": "#<@@(row,'#tcambio')>"
        }
        @"value_field": "sys_pk"
        @"text_field": "nombre"
        @"selected": form("cuenta_deposito","nm",@null)
    }

    new sel_categoria_deposito
    {
        @"datatable*": categorias
        @"id": "sel_categoria_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "categoria_deposito"
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": form("categoria_deposito","nm",@null)
    }

    new sel_documento_deposito
    {
        @"datatable*": docDepositos
        @"id": "sel_documento_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento_deposito"
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento_deposito","nm",@null)
    }

    new sel_documento_cobro
    {
        @"datatable*": docCobros
        @"id": "sel_documento_cobro"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento_cobro"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento_cobro","nm",@null)
    }

    fn_print_buttons::
    {
        act_btn_cls = "btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"
        
        #$
        button(class="#<act_btn_cls>" type="button" id="btn_save"){$"#<@ICON_SAVE> Guardar"}
        #!
    }
    point print_buttons to fn_print_buttons
    new nav_config
    {
        @"title": "Cobrar documento"
        @"buttons*": print_buttons
        // @"urlexit": "javascript:window.history.back();"
        member @"hidden" { @"print": @true }
    }

    #$
    div(class="container-md")
    {
        #!
        do uie.printV12FormBar(nav_config)
        #$

        div(class="alert alert-danger overflow-auto mb-2 #<ifstr(@('$error/message')!='','','d-none')>" id="frm_alerts"){$"#<@('error/message')>"}
        form(action="." method="post" id="form_cobro")
        {
            input(type="hidden" name="pkparent" value="#<@@(infoDoc,'#sys_pk')>")
            input(type="hidden" name="icliente" value="#<@@(infoDoc,'#icliente')>")
            ##
            do uie.print_from_url_field()
            ##

            div(class="row")
            {
                div(class="col-lg-8") {
                    div(class="row")
                    {
                        div(class="col-lg-4 col-md-4") {
                            p(class="mb-0") {
                                b{$"Cliente: "}
                                $"#<@@(infoDoc,'$cliente')>"
                            }
                        }
                        div(class="col-lg-4 col-md-4") {
                            p(class="mb-0") {
                                b{$"Divisa: "}
                                $"#<@@(infoDoc,'$divisa')>"
                            }
                        }
                        div(class="col-lg-4 col-md-4") {
                            p(class="mb-0") {
                                b{$"Tipo de cambio: "}
                                $"#<@@(infoDoc,'$tipocambio')>"
                            }
                        }
                        div(class="col-lg-6 col-md-6 col-sm-12") {
                            p(class="mb-0") {
                                b{$"Referencia del documento: "}
                                $"#<@@(infoDoc,'$referencia')>"
                            }
                        }
                        div(class="col-lg-6 col-md-6 col-sm-12") {
                            p(class="mb-0") {
                                b{$"Vencimiento: "}
                                $"#<@@(infoDoc,'$aplicacion')>"
                            }
                        }
                    }
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Capital:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" value="#<@@(infoDoc,'#debe')>" id="capital" disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Intereses Financieros:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" value="#<@@(infoDoc,'#intfinancieros')>" id="intfin" disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Intereses Moratorios:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" value="#<@@(infoDoc,'#intmoratorios')>" id="intmor" disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Bonificaciones:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" value="#<@@(infoDoc,'#bonificaciones')>" id="bonificaciones" disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Pagos:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" value="#<@@(infoDoc,'#pagos')>" id="pagos" disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Saldo:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" value="#<@@(infoDoc,'#saldo')>" id="saldo" disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }
                    
                    hr{}
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    h6(class="tex-no-break m-0"){$"Información bancaria"}

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_cuenta_deposito"){$"Cuenta:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_cuenta_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_categoria_deposito"){$"Categoria:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_categoria_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_documento_deposito"){$"Documento deposito:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_documento_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center d-none" id="div_tcambio_deposito")
                    {
                        label(class="col-auto col-form-label" "for"="txt_tcambio_deposito"){$"Tipo de cambio:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm") {
                                input(
                                    class="form-control rounded-0 induxsoft-num-field mw-100"
                                    type="number" name="tcambio_deposito" value="#<form('tcambio_deposito','nm',@null)>"
                                    id="txt_tcambio_deposito" min="1" step="#<num_step>" required="true"
                                    onkeypress="return InduxsoftNumberFields.filterFloat(event,this,#<@DECIMAL_PRECISION>)"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                )
                                span(class="input-group-text rounded-0" id="spn_tcambio_deposito"){$"#<cDIVISA_PRED>"}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center d-none" id="div_importe_deposito")
                    {
                        label(class="col-auto col-form-label" "for"="txt_importe_deposito"){$"Importe:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm"){
                                input(
                                    class="form-control rounded-0 induxsoft-num-field mw-100"
                                    type="number" name="importe_deposito" value="#<form('importe_deposito','nm',@null)>"
                                    id="txt_importe_deposito" step="#<num_step>"
                                    onkeypress="return InduxsoftNumberFields.filterFloat(event,this,#<@DECIMAL_PRECISION>)"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                )
                                span(class="input-group-text rounded-0" id="spn_importe_deposito"){$""}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        div(class="col-6") {
                            div(class="form-check") {
                                input(class="form-check-input" type="checkbox" name="conciliado" id="ch_conciliado" checked="checked")
                                label(class="form-check-label" "for"="ch_conciliado"){$"Conciliado"}
                            }
                        }
                    }

                    hr{}

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_documento_cobro"){$"Tipo de documento:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_documento_cobro)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_referencia"){$"Referencia:"}
                        div(class="col-6") {
                            input(type="text" class="form-control form-control-sm rounded-0" name="referencia" id="txt_referencia" value="#<form('referencia','tx',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_faplicacion"){$"Fecha de pago:"}
                        div(class="col-6") {
                            input(type="date" class="form-control form-control-sm rounded-0" name="faplicacion" id="txt_faplicacion" value="#<form('faplicacion','dt',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_fdoc"){$"Fecha de emisión:"}
                        div(class="col-6") {
                            input(type="date" class="form-control form-control-sm rounded-0" name="fecha" id="txt_fdoc" value="#<form('fecha','dt',@null)>" required="true")
                        }
                    }

                    

                    div(class="row d-flex justify-content-end align-items-center d-none" id="div_tcambio")
                    {
                        label(class="col-auto col-form-label" "for"="txt_tcambio"){$"Tipo de cambio:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm") {
                                input(
                                    class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100"
                                    type="number" name="tipocambio" value="#<form('tipocambio','nm',infoDoc)>"
                                    id="txt_tcambio" min="1" step="#<num_step>" required="true"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                )
                                span(class="input-group-text rounded-0"){$"#<cDIVISA_PRED> = 1 #<@@(infoDoc,'$divisa')>"}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_importe"){$"Importe:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm") {
                                input(
                                    class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100 validate-number"
                                    type="number" name="importe" value="#<@@(infoDoc,'#saldo')>"
                                    id="txt_importe" min="1" step="#<num_step>" required="true"
                                    onkeypress="return InduxsoftNumberFields.filterFloat(event,this,#<@DECIMAL_PRECISION>)"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                )
                                span(class="input-group-text rounded-0"){$"#<@@(infoDoc,'$divisa')>"}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_notas"){$"Notas:"}
                        div(class="col-6") {
                            textarea(class="form-control form-control-sm rounded-0" name="notas" id="txt_notas" required="true")
                            {
                                #!
                                concepto = form("notas","tx",@null)
                                if concepto == "" { concepto = "Cobro a documento " + @@(infoDoc,"$referencia") }
                                #$
                                $"#<concepto>"
                            }
                        }
                    }

                    hr{}
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label"){$"Nuevo saldo:"}
                        div(class="col-4") {
                            #!
                            saldo = @@(infoDoc,"#saldo")
                            importe = form("importe","nm",@null)
                            nuevo_saldo = round(saldo - importe, @DECIMAL_PRECISION)
                            #$
                            input(
                                class="form-control form-control-sm rounded-0 text-end"
                                type="number" name="nuevo_saldo" value="#<nuevo_saldo>"
                                id="txt_nuevo_saldo"
                                disabled="disabled"
                                readonly="readonly"
                            )
                        }
                    }
                }
            }
        }

        div
        {
            script(src="#<@JS_DOCUMENTOS>"){$""}
            script(src="#<@JS_CLIENTES>"){$""}

            script(type="text/javascript")
            {$'
                document.addEventListener("DOMContentLoaded", () => {
                    documento.cobro.dtCxC = #<to.json(infoDoc)>;
                    documento.cobro.dvsPred = #<to.json(dvsPred)>;
                    documento.cobro.decimals = #<@DECIMAL_PRECISION>;
                    documento.cobro.init();
                    documento.cobro.pedirTCambio();
                    InduxsoftNumberFields.Init();
                });
            '}
        }
    }
}