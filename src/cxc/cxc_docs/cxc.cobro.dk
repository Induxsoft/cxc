#include "dkli.dkh"
#!
module "cxc.cobro.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)
    
    fmoneda = "$ #,0.00"
    ref infoDoc = ifnull(@("&./infoDoc"),record.create())
    ref cuentas = ifnull(@("&./cuentas"),list.create())
    ref categorias = ifnull(@("&./categorias"),list.create())
    ref docDepositos = ifnull(@('&./docDepositos'),list.create())
    ref docCobros = ifnull(@('&./docCobros'),list.create())

    new sel_cuenta_deposito
    {
        @"datatable*": cuentas
        @"id": "sel_cuenta_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "cuenta_deposito"
        }
        @"value_field": "sys_pk"
        @"text_field": "nombre"
        @"selected": @('$input/cuenta_deposito')
    }

    new sel_categoria_deposito
    {
        @"datatable*": categorias
        @"id": "sel_categoria_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "categoria_deposito"
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @('$input/categoria_deposito')
    }

    new sel_documento_deposito
    {
        @"datatable*": docDepositos
        @"id": "sel_documento_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento_deposito"
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @('$input/documento_deposito')
    }

    new sel_documento_cobro
    {
        @"datatable*": docCobros
        @"id": "sel_documento_cobro"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento_cobro"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @('$input/documento_cobro')
    }

    #$
    div(class="container")
    {
        div(class="row container-section m-0 px-0 py-2 my-2 border-bottom sticky-top bg-white" id="main_action_bar")
        {
            div(class="col-4 d-flex align-items-center p-0") { h1(class="h5 text-primary tex-no-break m-0"){$"Cobrar documento"} }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn_save"){$"#<@ICON_SAVE> Guardar"}
                a(href="#<@CXC_DOCUMENTOS>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Salir"){$"#<@ICON_X_LG>"}
            }
        }

        form(action="." method="post" id="form_cobrar")
        {
            input(type="hidden" name="pkparent" value="#<@@(infoDoc,'#sys_pk')>")
            input(type="hidden" name="icliente" value="#<@@(infoDoc,'#icliente')>")
            input(type="hidden" name="destino" value="#<@CXC_DESTINO_APLICACION_PAGOS>")

            div(class="row")
            {
                div(class="col-lg-8 col-12 d-flex gap-2") {
                    p(class="mb-0") {
                        b{$"Cliente: "}
                        $"#<@@(infoDoc,'$cliente')>"
                    }
                }
                div(class="col-lg-4"){$""}
                div(class="col-lg-4 col-md-6 col-sm-12") {
                    p(class="mb-0") {
                        b{$"Referencia del documento: "}
                        $"#<@@(infoDoc,'$referencia')>"
                    }
                }
                div(class="col-lg-4 col-md-6 col-sm-12") {
                    p(class="mb-0") {
                        b{$"Vencimiento: "}
                        $"#<@@(infoDoc,'$fultmoratorios')>"
                    }
                }
                div(class="col-lg-4"){$""}
                div(class="col-lg-4 col-md-6 col-sm-12") {
                    p(class="mb-0") {
                        b{$"Divisa: "}
                        $"#<@@(infoDoc,'$divisa')>"
                    }
                }
                div(class="col-lg-4 col-md-6 col-sm-12") {
                    p(class="mb-0") {
                        b{$"Tipo de cambio: "}
                        $"#<@@(infoDoc,'$tipocambio')>"
                    }
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Capital:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#haber'),fmoneda)>"
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Intereses Financieros:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#intereses_financieros'),fmoneda)>"
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Intereses Moratorios:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#intereses_moratorios'),fmoneda)>"
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Bonificaciones:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#bonificaciones'),fmoneda)>"
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Saldo:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#saldo'),fmoneda)>"
                        }
                    }
                    
                    hr{}
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    h6(class="text-primary position-absolute"){$"Información bancaria"}

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_cuenta_deposito"){$"Cuenta:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_cuenta_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_categoria_deposito"){$"Categoria:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_categoria_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_documento_deposito"){$"Documento deposito:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_documento_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        // label(class="col-auto col-form-label" "for"=""){$""}
                        div(class="col-6") {
                            div(class="form-check") {
                                input(class="form-check-input" type="checkbox" name="conciliado" id="ch_conciliado" checked="checked")
                                label(class="form-check-label" "for"="ch_conciliado"){$"Conciliado"}
                            }
                        }
                    }

                    hr{}

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_documento_cobro"){$"Tipo de documento:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_documento_cobro)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_referencia"){$"Referencia:"}
                        div(class="col-6") {
                            input(type="text" class="form-control form-control-sm rounded-0" name="referencia" id="txt_referencia" value="#<@('$input/referencia')>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_fdoc"){$"Fecha del documento:"}
                        div(class="col-6") {
                            input(type="date" class="form-control form-control-sm rounded-0" name="fecha_documento" id="txt_fdoc" value="#<form('fecha_documento','dt',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_faplicacion"){$"Fecha de aplicación:"}
                        div(class="col-6") {
                            input(type="date" class="form-control form-control-sm rounded-0" name="fecha_aplicacion" id="txt_faplicacion" value="#<form('fecha_aplicacion','dt',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_tcambio"){$"Tipo de cambio:"}
                        div(class="col-6") {
                            input(type="number" class="form-control form-control-sm rounded-0" name="tcambio" min="1" step="0.000001" id="txt_tcambio" value="#<@('#input/tcambio')>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_importe"){$"Importe:"}
                        div(class="col-6") {
                            input(type="number" class="form-control form-control-sm rounded-0" name="importe" min="1" step="0.000001" id="txt_importe" value="#<@('#input/importe')>")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_notas"){$"Notas:"}
                        div(class="col-6") {
                            textarea(class="form-control form-control-sm rounded-0" name="notas" id="txt_notas" required="true")
                            {
                                #!
                                if @('$input/notas') == "" {#$ $"Cobro de documento con referencia #<@@(infoDoc,'$referencia')>" #!}
                                else {#$ $"#<@('$input/notas')>" }
                            }
                        }
                    }

                    hr{}
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label"){$"Nuevo saldo:"}
                        div(class="col-4") {
                            input(type="number" class="form-control form-control-sm rounded-0" name="nuevo_saldo" id="txt_nuevo_saldo" value="" disabled="disabled" readonly="readonly")
                        }
                    }

                    /* div(class="d-flex gap-1 justify-content-end")
                    {
                        button(type="submit" class="btn btn-primary"){$"Aceptar"}
                        button(type="reset" class="btn btn-danger"){$"Cancelar"}
                    } */
                }
            }
        }

        p{$"#<@('$error/message')>"}

        script
        {$'
            window.onload = function(){
                let txt_importe = document.getElementById("txt_importe");
                let form_cobrar = document.getElementById("form_cobrar");
                let btnSave = document.getElementById("btn_save");
                
                txt_importe.addEventListener("input",function(data) {
                    let saldo = #<@@(infoDoc,"#saldo")>;
                    let txt_nvosaldo = document.getElementById("txt_nuevo_saldo");
                    
                    txt_nvosaldo.value = Math.sub(saldo,Number(txt_importe.value));
                });

                btnSave.addEventListener("click", () => {
                    if (!form_cobrar.reportValidity()) return;
                    form_cobrar.submit();
                });

                form_cobrar.addEventListener("reset", () => {
                    window.location.href = "#<@CXC_DOCUMENTOS>";
                });
            }
        '}
    }
}