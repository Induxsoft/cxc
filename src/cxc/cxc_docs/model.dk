            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cxc.blank::&db,&params
    {
        do dbr.apps.action.grant("GB10")

        new data {}
        do cxc.prepareView(db,params,data)
        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cxc.update::&db,&params,&data
    {
        do rise_error(500,"Acción no implementada.")
    }

    cxc.delete::&db,&params
    {
        do rise_error(500,"Acción no implementada")
    }
    prepare_filter::list
    {
        new record
        {
            @"id": "-1"
            @"const": "Todos"
        }
        do list.ins(list, 0, record)
        return list
    }
}