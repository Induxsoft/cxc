    cxc.obtenerDocumentosPorAplicar::&db,&params
    {
        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            doc.const AS documento,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            (IFNULL(cxc.debe,0) - IFNULL(cxc.xaplicar,0)) AS aplicado,
            IFNULL(cxc.xaplicar,0) AS xaplicar,
            cxc.icliente
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
        WHERE cxc.sys_pk = @_entity_id
            AND IFNULL(cxc.xaplicar,0) > 0;
        "
        ref xaplicar = dbr.rec(db,sql,params)

        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            doc.const AS documento,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion,'%Y-%m-%d') AS aplicacion,
            IFNULL(cxc.bonificaciones,0) AS bonificaciones,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.intmoratorios,0) AS int_moratorios,
            IFNULL(cxc.pagos,0) AS pagos,
            (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS saldo,
            0 AS aplicar,
            (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS sfinal
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
        WHERE cxc.icliente = @icliente
            AND (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) > 0;
        "
        ref pendientes = dbr.list(db,sql,xaplicar)

        new result
        {
            @"xaplicar*": xaplicar
            @"pendientes*": pendientes
        }

        return result
    }

    cxc.aplicarCobros::&db,&params,&data
    {
        ref aplicacion = ifnull(@@(data,"&aplicacion"),list.create())

        go foreach.lobj(value:dst) with(aplicacion)
        {
            dst<"aplicado"> : 0
            do dbr.begin(db)

            new aplcxc
            {
                @"sys_pk": 0
                @"sys_guid": uuid()
                @"sys_dtcreated*": now()
                @"sys_timestamp*": now()
                @"destino": 4 //pagos
                @"fecha*": now()
                @"importe": @@(dst,"#aplicar")
                @"aplicadoa": @@(dst,"#id_origen")
                @"fk_dcxc_aplicadoa": @@(dst,"#id_destino")
                @"sys_recver": 0
            }
            do dbr.insert(db,"aplcxc",aplcxc)

            // Aumentar en pago al documento a aplicar
            sql = "
            UPDATE dcxc 
                SET pagos = (IFNULL(pagos,0) + @aplicar) 
            WHERE sys_pk = @id_destino
                AND ((IFNULL(debe,0) + IFNULL(intmoratorios,0) - IFNULL(bonificaciones,0) - IFNULL(pagos,0) - @aplicar) >= 0);
            "
            if not(dbr.execute(db,sql,dst)) { do rise_error(1,"Documento destino no encontrado o el importe a aplicar es mayor al saldo del documento.") }
            // Disminuir en xaplicar al documento de origen
            sql = "
            UPDATE dcxc 
                SET xaplicar = (IFNULL(xaplicar,0) - @aplicar)
            WHERE sys_pk = @id_origen
                AND (IFNULL(debe,0) - (IFNULL(debe,0) - IFNULL(xaplicar,0)) - @aplicar) >= 0;
            "
            if not(dbr.execute(db,sql,dst)) { do rise_error(2,"Documento origen no encontrado o el importe aplicado es mayor al saldo disponible por aplicar.") }

            do dbr.commit(db)
            dst<"aplicado"> : @@(dst,"#aplicar")
            
            exception
            {
                if dbr.in_transaction(db) { do dbr.rollback(db) }
                dst<"error"> : last_error()
            }
        }

        return aplicacion
    }

    cxc.vFields::field
    {
        switch field
        {
            case "codigo" { return "cte.codigo" }
            case "cliente" { return "cte.nombre" }
            case "documento" { return "doc.const" }
            case "referencia" { return "cxc.referencia" }
            case "emision" { return "cxc.fecha" }
            case "aplicacion" { return "cxc.aplicacion" }
            case "debe" { return "cxc.debe" }
            case "haber" { return "cxc.haber" }
            case "divisa" { return "dvs.codigo" }
            default { return "" }
        }
    }

    cxc.list::&db,&params
    {
        fformat = "yyyy-MM-dd"

        cliente = trim(@@(params,"$cliente"))
        orderby = cxc.vFields(tolower(trim(@@(params,"$orderby"))))
        direction = toupper(trim(@@(params,"$direction")))
        fi_emision = date_format(trim(@@(params,"$fie")), fformat)
        ff_emision = date_format(trim(@@(params,"$ffe")), fformat)
        fi_aplicacion = date_format(trim(@@(params,"$fia")), fformat)
        ff_aplicacion = date_format(trim(@@(params,"$ffa")), fformat)
        recent = field.dnum(params,"recent",250)

        if not(field.exist(params,"orderby")) && not(field.exist(params,"recent")) {
            orderby = "aplicacion"
            recent = 250
        }
        if not(field.exist(params,"orderby")) && field.exist(params,"recent") {
            orderby = "cxc.sys_dtcreated"
        }
        if direction != "ASC" || direction != "DESC" { direction = "DESC" }

        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            cte.sys_pk AS icliente,
            cte.codigo AS ccliente,
            cte.nombre AS cliente,
            doc.const AS documento,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha, '%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion, '%Y-%m-%d') AS aplicacion,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            dvs.codigo AS divisa
        FROM dcxc AS cxc 
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
            INNER JOIN cliente AS cte ON cte.sys_pk = cxc.icliente
            INNER JOIN divisa AS dvs ON dvs.sys_pk = cte.idivisa
        WHERE TRUE"

        if cliente != "" {
            sql = sql + " AND (
                cte.sys_pk = @cliente
                OR cte.sys_guid = @cliente
                OR cte.codigo = @cliente
            )"
        }
        
        if fi_emision != "" && ff_emision != "" && fi_aplicacion == "" && ff_aplicacion == "" { sql = sql + " AND DATE(cxc.fecha) BETWEEN @fie AND @ffe" }
        if fi_emision == "" && ff_emision == "" && fi_aplicacion != "" && ff_aplicacion != "" { sql = sql + " AND DATE(cxc.aplicacion) BETWEEN @fia AND @ffa" }

        if orderby != "" { sql = sql + " ORDER BY "+orderby+" "+direction }

        if fi_emision == "" && ff_emision == "" && fi_aplicacion == "" && ff_aplicacion == "" { sql = sql + " LIMIT "+str(recent)+";" }

        query = trim(sql)
        return dbr.list(db,query,params)
    }

    cxc.read::&db,&params
    {
        ref data = cxc.obtenerDocumento(db,params)
        do cxc.prepareView(db,params,data)
        return data
    }

    cxc.blank::&db,&params
    {
        new data {}
        do cxc.prepareView(db,params,data)
        return data
    }
}