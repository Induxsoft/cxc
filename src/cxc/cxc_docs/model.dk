            @"relacionadoa": 0
            @"tasamoratorios": 0.0
            @"tipocambio": @@(data,"#tcambio")
            @"xaplicar": 0.0
            @"icliente": @@(data,"#icliente")
            @"sys_recver": 0
        }
        do dbr.insert(db,"dcxc",bonificacion)

        new p { @"id_doc": id_doc }
        fk_dcxc_aplicadoa = dbr.num(db,"SELECT sys_pk FROM dcxc WHERE sys_guid = @id_doc;",p)

        new aplcxc
        {
            @"sys_pk": 0
            @"sys_guid": uuid()
            @"sys_dtcreated*": now()
            @"sys_timestamp*": now()
