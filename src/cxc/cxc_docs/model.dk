    cxc.getConditionFilter::&params
    {
        // fdr_init
        if not(field.exist(params,"fdr_mode")) { params<"fdr_mode"> : "month" }
        // [month]
        if not(field.exist(params,"fdr_year")) { params<"fdr_year"> : @curr_year }
        if not(field.exist(params,"fdr_month")) { params<"fdr_month"> : @curr_month }
        // [lastdays]
        if not(field.exist(params,"fdr_range")) { params<"fdr_range"> : 30 }
        // [range]
        if not(field.exist(params,"fdr_from")) { params<"fdr_from"> : "" }
        if not(field.exist(params,"fdr_to")) { params<"fdr_to"> : "" }
        //#endregion

        conditions = ""

        //#region filter-date-range
        new vnt_date_fields
        {
            @"1": "cxc.fecha" // Emisión
            @"2": "cxc.aplicacion" // Vencimiento
        }
        fdr_field = @@(vnt_date_fields,str(@@(params,"#fil_fdr_field")))
        if trim(fdr_field)==""{fdr_field=@@(vnt_date_fields,"1")}
        
        switch @@(params,"$fdr_mode")
        {
            case "month"
            {
                curr_ndt = ndatetime.now()
                curr_year = ndatetime.year(curr_ndt)
                curr_month = ndatetime.month(curr_ndt)
                curr_day = ndatetime.day(curr_ndt)

                if not(field.exist(params,"fdr_year")) { params<"fdr_year"> : curr_year }
                if not(field.exist(params,"fdr_month")) { params<"fdr_month"> : curr_month }

                conditions = conditions + " AND YEAR(#<fdr_field>) = @fdr_year AND MONTH(#<fdr_field>) = @fdr_month"
                break
            }
            case "lastdays"
            {
                if not(field.exist(params,"fdr_range")) { params<"fdr_range"> : 30 } // Últimos 30 días

                conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN ADDDATE(DATE(NOW()), INTERVAL -@fdr_range DAY) AND DATE(NOW())"
                break
            }
            case "range"
            {
                if not(field.exist(params,"fdr_from"))
                {
                    curr_ndt = ndatetime.now()
                    subt_ndt = ndatetime.add(curr_ndt, -30, "d")
                    ult_30_days = ndatetime.tostr(subt_ndt, "yyyy-MM-dd")

                    params<"fdr_from"> : ult_30_days
                }
                if not(field.exist(params,"fdr_to")) { params<"fdr_to"> : date_str(now(),"yyyy-MM-dd") }

                if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN @fdr_from AND @fdr_to"
                }
                else if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) == ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) >= @fdr_from"
                }
                else if trim(@@(params,"$fdr_from")) == "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) <= @fdr_to"
                }

                break
            }
        }

        if @@(params,"$s") != "" {
            conditions = conditions + " AND cxc.referencia LIKE CONCAT('%',@s,'%')"
        }

        conditions=ftext(conditions)
        params<"fdr_field">:fdr_field
        params<"conditions">:conditions

        return conditions
    }

    cxc.obtenerDocumentosPorAplicar::&db,&params
    {
        do errordet(@false)
        
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }
        params<"year">: ifstr(trim(@@(params,"year"))!="", @@(params,"year"), str(ndatetime.year(ndatetime.now())))
        params<"month">: ifstr(trim(@@(params,"month"))!="", @@(params,"month"), str(ndatetime.month(ndatetime.now())))

        conditions = cxc.getConditionFilter(params)
        
        sql_xaplicar = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            doc.const AS documento,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            (IFNULL(cxc.haber,0) - IFNULL(cxc.xaplicar,0)) AS aplicado,
            IFNULL(cxc.xaplicar,0) AS xaplicar,
            cxc.icliente,
            ((select count(a.sys_pk) from aplcxc a where a.fk_dcxc_aplicadoa = cxc.sys_pk and (ifnull(a.uf_cfdi,'')!='' and a.uf_cfdi!='0')) > 0) has_cfdi
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
        WHERE cxc.sys_pk = @_entity_id
            AND IFNULL(cxc.haber,0) > 0
            -- AND IFNULL(cxc.xaplicar,0) > 0
        "
        // Documento por aplicar
        ref xaplicar = dbr.rec(db,sql_xaplicar,params)

        if @@(xaplicar,"#haber") <= 0 { do rise_error(500,"No es posible aplicar el documento proporcionado") }
        
        using params
        {
            @"idocumento": @@(xaplicar,"#sys_pk")
            @"icliente": @@(xaplicar,"#icliente")
        }

        sql_pendientes = ftext("
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            doc.const AS documento,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion,'%Y-%m-%d') AS aplicacion,
            IFNULL(cxc.bonificaciones,0) AS bonificaciones,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.intmoratorios,0) AS int_moratorios,
            IFNULL(cxc.pagos,0) AS pagos,
            (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS saldo,
            0 AS aplicar,
            (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS sfinal
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
            LEFT JOIN aplcxc AS mor ON mor.fk_dcxc_aplicadoa = cxc.sys_pk AND mor.destino = #<@CXC_DESTINO_APLICACION_INT_MORATORIOS>
        WHERE cxc.icliente = @icliente
            AND (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) > 0
            AND NOT IFNULL(mor.sys_pk,0)
            #<conditions>
        ")
        // AND IF(IFNULL(@s,'')='', true, cxc.referencia LIKE CONCAT('%',@s,'%'))
        // AND IF(IFNULL(@year,'')='', true, YEAR(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=@year)
        // AND IF(IFNULL(@month,'')='', true, (YEAR(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=IFNULL(@year,YEAR(NOW())) AND MONTH(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=@month))
        // AND IF(IFNULL(@range,'-99')='-99', true, (DATE(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion)) BETWEEN DATE_ADD(NOW(), INTERVAL -"+str(@@(params,"#range"))+" DAY) AND NOW()))
        // AND IF(IFNULL(@datefrom,'')='', true, (DATE(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion)) BETWEEN DATE(@datefrom) AND DATE(@dateto)))
        
        // Documentos con saldo del cliente
        ref pendientes = dbr.list(db,ftext(sql_pendientes),params)

        sql_aplicados = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            doc.const AS documento,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion,'%Y-%m-%d') AS aplicacion,
            IFNULL(cxc.bonificaciones,0) AS bonificaciones,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.intmoratorios,0) AS int_moratorios,
            IFNULL(cxc.pagos,0) AS pagos,
            (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS saldo,
            SUM(IFNULL(apl.importe,0)) AS aplicado,
            ((IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) + SUM(IFNULL(apl.importe,0))) AS santerior
        FROM aplcxc AS apl
            INNER JOIN dcxc AS cxc ON apl.aplicadoa = cxc.sys_pk
            INNER JOIN cdocumentos AS doc ON cxc.documento = doc.id
        WHERE apl.fk_dcxc_aplicadoa = @idocumento
        GROUP BY cxc.sys_pk
        "
        // Documentos con importes aplicados del documento por aplicar
        ref aplicados = dbr.list(db,sql_aplicados,params)

        new result
        {
            @"xaplicar*": xaplicar
            @"pendientes*": pendientes
            @"aplicados*": aplicados
        }

        return result
    }

    cxc.aplicarCobros::&db,&params,&data
    {
        if @@(params,"$_act") == "desaplicar" { return erp.cxc.movimientos.desaplicarCobros(db,params) }

        @use_transaction = @false

        do dbr.apps.action.pre("GB16")
        //do dbr.begin(db)

        ref aplicacion = ifnull(@@(data,"&aplicacion"),list.create())

        go foreach.lobj(value:dst) with(aplicacion)
        {
            if @@(dst,"#aplicar") > 0
            {
                do dbr.begin(db)

                dst<"aplicado"> : 0

                // Aumentar en pago al documento a aplicar
                sql_aumentar_pago = "
                UPDATE dcxc 
                    SET pagos = (IFNULL(pagos,0) + @aplicar) 
                WHERE sys_pk = @id_destino
                    AND ((IFNULL(debe,0) + IFNULL(intmoratorios,0) - IFNULL(bonificaciones,0) - IFNULL(pagos,0) - @aplicar) >= 0);
                "
                if not(dbr.execute(db,sql_aumentar_pago,dst)) { do rise_error(1,"Documento destino no encontrado o el importe a aplicar es mayor al saldo del documento.") }
                
                // Disminuir en xaplicar al documento de origen
                sql_disminuir_xaplicar = "
                UPDATE dcxc 
                    SET xaplicar = (IFNULL(xaplicar,0) - @aplicar)
                WHERE sys_pk = @id_origen
                    AND (IFNULL(debe,0) - (IFNULL(debe,0) - IFNULL(xaplicar,0)) - @aplicar) >= 0;
                "
                if not(dbr.execute(db,sql_disminuir_xaplicar,dst)) { do rise_error(2,"Documento origen no encontrado o el importe aplicado es mayor al saldo disponible por aplicar.") }

                // Crear registro de aplicado
                new aplcxc
                {
                    @"sys_pk": 0
                    @"sys_guid": uuid()
                    @"sys_dtcreated*": now()
                    @"sys_timestamp*": now()
                    @"sys_recver": 0
                    @"destino": 4 //pagos
                    @"fecha*": now()
                    @"importe": @@(dst,"#aplicar")
                    @"aplicadoa": @@(dst,"#id_destino")
                    @"fk_dcxc_aplicadoa": @@(dst,"#id_origen")
                }
                do dbr.insert(db,"aplcxc",aplcxc)

                dst<"aplicado"> : @@(dst,"#aplicar")

                do dbr.apps.action.pos(dst)
                do dbr.commit(db)
                
                exception
                {
                    if dbr.in_transaction(db) { do dbr.rollback(db) }
                    dst<"error"> : last_error()
                }
            }
        }

        //do dbr.apps.action.pos(aplicacion)
        //do dbr.commit(db)
        do dbr.apps.action.ext(aplicacion)

        return aplicacion

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cxc.vFields::field
    {
        switch field
        {
            case "codigo" { return "cte.codigo" }
            case "cliente" { return "cte.nombre" }
            case "documento" { return "doc.const" }
            case "referencia" { return "cxc.referencia" }
            case "emision" { return "cxc.fecha" }
            case "aplicacion" { return "cxc.aplicacion" }
            case "debe" { return "cxc.debe" }
            case "haber" { return "cxc.haber" }
            case "divisa" { return "dvs.codigo" }
            default { return "" }
        }
    }

    cxc.list::&db,&params
    {
        do dbr.apps.action.grant("GB10")
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }

        params<"year">: ifstr(trim(@@(params,"year"))!="", @@(params,"year"), str(ndatetime.year(ndatetime.now())))
        params<"month">: ifstr(trim(@@(params,"month"))!="", @@(params,"month"), str(ndatetime.month(ndatetime.now())))

        fformat = "yyyy-MM-dd"

        cliente = trim(@@(params,"$cliente"))
        orderby = cxc.vFields(tolower(trim(@@(params,"$orderby"))))
        direction = toupper(trim(@@(params,"$direction")))
        fi_emision = date_format(trim(@@(params,"$fie")), fformat)
        ff_emision = date_format(trim(@@(params,"$ffe")), fformat)
        fi_aplicacion = date_format(trim(@@(params,"$fia")), fformat)
        ff_aplicacion = date_format(trim(@@(params,"$ffa")), fformat)
        recent = field.dnum(params,"recent",250)

        if not(field.exist(params,"orderby")) && not(field.exist(params,"recent")) {
            orderby = "aplicacion"
            recent = 250
        }
        if not(field.exist(params,"orderby")) && field.exist(params,"recent") {
            orderby = "cxc.sys_dtcreated"
        }
        if direction != "ASC" || direction != "DESC" { direction = "DESC" }

        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            cte.sys_pk AS icliente,
            cte.codigo AS ccliente,
            CONCAT('[',cte.codigo,'] ',cte.nombre) AS cliente,
            doc.const AS documento,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha, '%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion, '%Y-%m-%d') AS aplicacion,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.intmoratorios,0) AS intmor,
            IFNULL(cxc.bonificaciones,0) AS bonificacion,
            IFNULL(cxc.pagos,0)pagos,
            (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS saldo,
            dvs.codigo AS divisa
        FROM dcxc AS cxc 
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
            INNER JOIN cliente AS cte ON cte.sys_pk = cxc.icliente
            INNER JOIN divisa AS dvs ON dvs.sys_pk = cte.idivisa
        WHERE TRUE"

        if cliente != "" {
            sql = sql + " AND (
                cte.sys_pk = @cliente
                OR cte.sys_guid = @cliente
                OR cte.codigo = @cliente
            )"
        }
        
        // if fi_emision != "" && ff_emision != "" && fi_aplicacion == "" && ff_aplicacion == "" { sql = sql + " AND DATE(cxc.fecha) BETWEEN @fie AND @ffe" }
        // if fi_emision == "" && ff_emision == "" && fi_aplicacion != "" && ff_aplicacion != "" { sql = sql + " AND DATE(cxc.aplicacion) BETWEEN @fia AND @ffa" }

        // if orderby != "" { sql = sql + " ORDER BY "+orderby+" "+direction }

        // if fi_emision == "" && ff_emision == "" && fi_aplicacion == "" && ff_aplicacion == "" { sql = sql + " LIMIT "+str(recent)+";" }

        sql = sql + ftext("
                AND IF(IFNULL(@s,'')='', true, (cxc.referencia LIKE CONCAT('%',@s,'%') OR cte.nombre LIKE CONCAT('%',@s,'%') OR cte.codigo LIKE CONCAT('%',@s,'%') OR cte.rfc LIKE CONCAT('%',@s,'%')))
                AND IF(IFNULL(@year,'')='', true, YEAR(IF(IFNULL(@tdate,'0')='0', cxc.fecha, cxc.aplicacion))=@year)
                AND IF(IFNULL(@month,'')='', true, (YEAR(IF(IFNULL(@tdate,'0')='0', cxc.fecha, cxc.aplicacion))=IFNULL(@year,YEAR(NOW())) AND MONTH(IF(IFNULL(@tdate,'0')='0', cxc.fecha, cxc.aplicacion))=@month))
                AND IF(IFNULL(@range,'-99')='-99', true, (DATE(IF(IFNULL(@tdate,'0')='0', cxc.fecha, cxc.aplicacion)) BETWEEN DATE_ADD(NOW(), INTERVAL -"+str(@@(params,"#range"))+" DAY) AND NOW()))
                AND IF(IFNULL(@datefrom,'')='' AND IFNULL(@dateto,'')='', true, (DATE(IF(IFNULL(@tdate,'0')='0', cxc.fecha, cxc.aplicacion)) BETWEEN DATE(@datefrom) AND DATE(@dateto)))
                AND IF(IFNULL(@cdoc,'-1')='-1', true, doc.id = @cdoc)
            ORDER BY cxc.fecha
            LIMIT #<@default_max_rows>;
        ")

        query = trim(sql)

        sql_cdocumentos = "SELECT d.id, d.const FROM cdocumentos d INNER JOIN cfg_cxc_docs cd ON d.id=cd.documento ORDER BY d.id;"
        ref cdocumentos = dbr.list(db, sql_cdocumentos, @null)

        new response
        {
            @"docs*": dbr.list(db, ftext(query), params)
            @"cdocumentos*": prepare_filter(cdocumentos)
        }
        do setPrintTitles(db,response)

        return response

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cxc.read::&db,&params
    {
        do dbr.apps.action.grant("GB10")
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }

        ref data = entity.read(db,params)
        do cxc.prepareView(db,params,data)
        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cxc.blank::&db,&params
    {
        do dbr.apps.action.grant("GB10")
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }

        do cxc.validateAplicable(db,params)
        
        new data {}
        do cxc.prepareView(db,params,data)
        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cxc.update::&db,&params,&data
    {
        do rise_error(500,"Acción no implementada.")
    }

    cxc.delete::&db,&params
    {
        @use_transaction = @false
        do dbr.apps.action.pre("GB19")
        do dbr.begin(db)
        
        ref dcxc = dbr.rec(db,"select sys_pk, documento, ifnull(debe,0) debe, ifnull(haber,0) haber, pagos, bonificaciones, icliente, iventa, imovcaja, imovcuenta from dcxc where sys_pk = @_entity_id;",params)
        
        if isnull(dcxc) { do rise_error(511,"No se encontró datos del documento") }
        /**
        * 5 - cNota_de_crédito = Bonificación
        * 19 - cRecibo = Pago
        */
        isPaymentOrBonus = (@@(dcxc,"#documento") == 5 || @@(dcxc,"#documento") == 19)
        if isPaymentOrBonus
        {
            aplicados = dbr.num(db,"select count(*) from aplcxc where fk_dcxc_aplicadoa = @sys_pk",dcxc)
            if aplicados > 0 { do rise_error(512,"No es posible eliminar, el documento ya fue aplicado.") }
        }
        else
        {
            aplicados = @@(dcxc,"#pagos") + @@(dcxc,"#bonificaciones") 
            if aplicados > 0 { do rise_error(512,"No es posible eliminar, el documento ya fue aplicado") }

            if @@(dcxc,"#iventa") > 0 { do rise_error(513,"No es posible eliminar, El documento esta relacionado a una venta") }
            if @@(dcxc,"#imovcaja") > 0 { do rise_error(514,"No es posible eliminar, El documento tiene un movimiento de caja") }
            if @@(dcxc,"#imovcuenta") > 0 { do rise_error(515,"No es posible eliminar, El documento tiene un movimiento de cuenta") }
        }

        ref entity = entity.delete(db,params)
        if isPaymentOrBonus && @@(dcxc,"#imovcuenta") > 0 { do dbr.delete(db,"movcuenta","sys_pk = @imovcuenta",dcxc) }

        r = dbr.execute(db,"update cliente set saldo = (ifnull(saldo,0) - @debe + @haber) where sys_pk = @icliente",dcxc)
        if r < 1 { do rise_error(500,"No se logró afectar el saldo del cliente, revise sus datos") }

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)
        
        return entity

        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    
    prepare_filter::list
    {
        new record
        {
            @"id": "-1"
            @"const": "Todos"
        }
        do list.ins(list, 0, record)
        return list
    }
    cxc.validateAplicable::&db,&params
    {
        if @@(params,"#pkparent")>0{params<"doc">:@@(params,"#pkparent")}
        else{params<"doc">:@@(params,"#_entity_id")}
        
        if @@(params,"#doc")<1{return}
        
        aplicable=dbr.num(db,"select IFNULL(aplicable,0) from dcxc where sys_pk=@doc",params)
        if not(aplicable){do rise_error(500,"El documento proporcionado no es aplicable")}
    }
}