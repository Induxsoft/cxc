#include "dkli.dkh"
#!
module "model"
{
    @table_name = "dcxc"
    @read_query = "
    SELECT
        cxc.sys_pk,
        cxc.sys_guid,
        DATE_FORMAT(cxc.sys_dtcreated,'%Y-%m-%d %H:%i:%s') AS sys_dtcreated,
        DATE_FORMAT(cxc.sys_timestamp,'%Y-%m-%d %H:%i:%s') AS sys_timestamp,
        IFNULL(cxc.sys_recver,0) AS sys_recver,
        cxc.aplicable,
        cxc.referencia,
        cxc.documento,
        DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
        DATE_FORMAT(cxc.fultmoratorios,'%Y-%m-%d') AS fultmoratorios,
        DATE_FORMAT(cxc.aplicacion,'%Y-%m-%d') AS aplicacion,
        ROUND(IFNULL(cxc.debe,0),@decimals) AS debe,
        ROUND(IFNULL(cxc.haber,0),@decimals) AS haber,
        ROUND(IFNULL(cxc.intfinancieros,0),@decimals) AS intfinancieros,
        ROUND(IFNULL(cxc.intmoratorios,0),@decimals) AS intmoratorios,
        ROUND(IFNULL(cxc.pagos,0),@decimals) AS pagos,
        ROUND(IFNULL(cxc.bonificaciones,0),@decimals) AS bonificaciones,
        ROUND((IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)),@decimals) AS saldo,
        ROUND(cxc.tipocambio,@decimals) tipocambio,
        cxc.xaplicar,
        cxc.icliente,
        cxc.notas,
        cte.codigo AS ccliente,
        cte.nombre AS cliente,
        cte.saldo AS saldo_cliente,
        dvs.codigo AS divisa
    FROM dcxc AS cxc
        INNER JOIN cliente AS cte ON cte.sys_pk = cxc.icliente
        INNER JOIN divisa AS dvs ON dvs.sys_pk = cte.idivisa
    WHERE cxc.#<@keyfield> = @_entity_id
    "

    function setPrintTitles(&db,&data)
    {
        using data
        {
            member @"titles"
            {
                @"title": dbr.vars.getd(db,"FXCA108","")
                @"subtitle": dbr.vars.getd(db,"FXCA109","")
                @"subtitle_2": dbr.vars.getd(db,"FXCA110","")
                @"footer": dbr.vars.getd(db,"FXCA111","")
            }
        }
    }

    cxc.get.folio::&db,&params
    {
        ref itm_block=dbr.rec(db,"SELECT sys_pk, serie FROM blockdocumentos WHERE NOT IFNULL(sys_deleted,0) AND activo AND sys_pk = @block",params)
        new data{}
        data<"folio">:dbr.folios.get_new(db,@@(itm_block,"#sys_pk"))
        reference=dbr.autocode.reference(@@(itm_block,"$serie"),data.folio,dbr.autocode.get.mascara(db,@@(itm_block,"#sys_pk")),parse.num(dbr.vars.getd(db,"ventas_fix_ref_size",8)))
                    
        data<"referencia">:reference

        return data
    }

    cxc.prepareView::&db,&params,&data
    {
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }

        switch @@(params,"$_view")
        {
            case ""
            {
                sql_get_cliente = "
                SELECT 
                    cte.sys_pk,
                    cte.codigo,
                    cte.nombre,
                    tpc.descripcion AS tipo,
                    dvs.codigo AS divisa,
                    dvs.tcambio
                FROM cliente AS cte 
                    INNER JOIN tipocliente AS tpc ON tpc.sys_pk = cte.tipo
                    INNER JOIN divisa AS dvs ON dvs.sys_pk = cte.idivisa
                WHERE cte.sys_pk = @icliente
                "
                sql_documentos = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxc_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.pagable,0);"

                if @@(params,"$_entity_id") == "_new"
                {
                    icliente = @@(data,"#form/icliente")
                    if icliente < 1 { icliente = @@(params,"#icliente") }

                    new p { @"icliente": icliente }

                    data<"infoCliente*"> : dbr.rec(db,sql_get_cliente,p)
                    data<"documentos*"> : dbr.list(db,sql_documentos,@null)
                }
                else 
                {
                    
                    ref info_dcxc = record.copy(data,"*")
                    do record.clear(data)
                    new p { @"icliente": @@(info_dcxc,"#icliente") }
                    ref info_clte = dbr.rec(db,sql_get_cliente,p)

                    data<"infoDoc*"> : info_dcxc
                    data<"infoCliente*"> : info_clte
                    data<"documentos*"> : dbr.list(db,sql_documentos,@null)
                }
                break
            }
            case "cobrar"
            {
                ref dcxc = entity.read(db,params)
                if @@(dcxc,"#debe") <= 0 { do rise_error(500,"No es posible cobrar el documento proporcionado") }

                sql_cuentas = "SELECT c.sys_pk, d.codigo AS divisa, d.tcambio, CONCAT(c.nombre,' (',d.codigo,')') nombre FROM chequera c INNER JOIN divisa d ON d.sys_pk = c.idivisa WHERE NOT IFNULL(c.sys_deleted,0) ORDER BY c.sys_pk;"
                sql_categorias = "SELECT sys_pk,descripcion FROM categoria WHERE tipo = 1 AND NOT IFNULL(sys_deleted,0) ORDER BY sys_pk;"
                sql_doc_cobros = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxc_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.apl_pago,0);"
                sql_doc_depositos = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_chq_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.depositos,0);"
                qry_list_series = "SELECT b.sys_pk, serie
                                FROM blockdocumentos  b
                                INNER JOIN cfg_cxc_docs AS cfg ON  b.documento=cfg.documento
                                WHERE NOT IFNULL(b.sys_deleted,0) 
                                AND activo 
                                AND IFNULL(cfg.apl_pago,0);"

                data<"infoDoc*"> : dcxc
                data<"cuentas*"> : dbr.list(db,sql_cuentas,@null)
                data<"categorias*"> : dbr.list(db,sql_categorias,@null)
                data<"docCobros*"> : dbr.list(db,sql_doc_cobros,@null)
                data<"docDepositos*"> : dbr.list(db,sql_doc_depositos,@null)
                data<"list_series*">:dbr.list(db,qry_list_series,dcxc)
                data<"folio">:1

                ref itm_block=@item(data.list_series,0)
                if not(isnull(itm_block))
                {
                    data<"folio">:dbr.folios.get_new(db,@@(itm_block,"#sys_pk"))
                    reference=dbr.autocode.reference(@@(itm_block,"$serie"),data.folio,dbr.autocode.get.mascara(db,@@(itm_block,"#sys_pk")),parse.num(dbr.vars.getd(db,"ventas_fix_ref_size",8)))
                    
                    if not(field.exist(data,"form")){data<"form*">:record.create()}
                    
                    data<"form/referencia">:reference
                }
                break
            }
            case "bonificacion"
            {
                ref dcxc = entity.read(db,params)
                if @@(dcxc,"#debe") <= 0 { do rise_error(500,"No es posible bonificar el documento proporcionado") }

                sql_documentos = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxc_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.apl_bonific,0);"

                data<"infoDoc*"> : dcxc
                data<"documentos*"> : dbr.list(db,sql_documentos,@null)
                break
            }
            case "intmoratorios"
            {
                ref dcxc = entity.read(db,params)
                if @@(dcxc,"#debe") <= 0 { do rise_error(500,"No es posible aplicar intereses moratorios al documento proporcionado") }

                sql_documentos = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxc_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.apl_int_mor,0);"

                data<"infoDoc*"> : dcxc
                data<"documentos*"> : dbr.list(db,sql_documentos,@null)
                break
            }
        }

        using data
        {
            @"dvsPred*": dbr.localize.money(db,@dbr.localize.default.money_code)
            @"decimals": @@(params,"#decimals")
        }
    }

    cxc.crearDocumento::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.apps.action.pre("GB11")
        do dbr.begin(db)

        new p { @"_entity_id": erp.cxc.movimientos.crearCxC(db,data) }
        ref entity = entity.read(db,p)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        // @url_redir = @CXC_DOCUMENTOS

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do cxc.prepareView(db,params,data)
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cxc.cobrarDocumento::&db,&params,&data
    {
        @use_transaction = @false

        do dbr.apps.action.pre("GB13")
        do dbr.begin(db)

        if @@(data,"#pkparent")>0{params<"pkparent">:@@(data,"#pkparent")}
        do cxc.validateAplicable(db,params)
        
        id_block=dbr.folios.id_block(db,@@(data,"#documento_cobro"),@@(data,"$serie"))

        folio=dbr.folios.set_new(db,id_block,@@(data,"#folio"),3)
        ref info=dbr.folios.info(db,id_block,folio)
        data<"ifolio">:@@(info,"#sys_pk")

        // if folio > 0 && folio != @@(data,"#folio")
        // {
        //     data<"referencia">:dbr.autocode.reference(@@(data,"$serie"),folio,dbr.autocode.get.mascara(db,id_block),parse.num(dbr.vars.getd(db,"ventas_fix_ref_size",8)))
        // }

        new p { @"_entity_id": erp.cxc.movimientos.cobrarCxC(db,data) }
        ref entity = entity.read(db,p)

        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        // @url_redir = @CXC_DOCUMENTOS

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do cxc.prepareView(db,params,data)
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

