#include "dkli.dkh"
#!
module "cxc.intmor.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "../config.dk"

    do @context.begin(@crud_context)
    
    fmoneda = "$ #,0.00"
    ref infoDoc = ifnull(@("&./infoDoc"),record.create())
    ref documentos = ifnull(@('&./documentos'),list.create())

    new sel_documento
    {
        @"datatable*": documentos
        @"id": "sel_documento"
        new member "attributes"
        {
            @"class": "form-select"
            @"name": "documento"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @("$input/documento")
    }

    #$
    div(class="container")
    {
        h1(class="h4"){$"Aplicar intereses moratorios"}

        form(action="." method="post" id="form_aplintmor")
        {
            input(type="hidden" name="pkparent" value="#<@@(infoDoc,'#sys_pk')>")
            input(type="hidden" name="icliente" value="#<@@(infoDoc,'#icliente')>")
            input(type="hidden" name="destino" value="#<@CXC_DESTINO_APLICACION_INT_MORATORIOS>")

            div(class="row")
            {
                div(class="col-lg-8 col-12 d-flex gap-2") {
                    p(class="mb-0") {
                        b{$"Cliente: "}
                        $"#<@@(infoDoc,'$cliente')>"
                    }
                }
                div(class="col-lg-4"){$""}
                div(class="col-lg-4 col-md-6 col-sm-12") {
                    p(class="mb-0") {
                        b{$"Referencia del documento: "}
                        $"#<@@(infoDoc,'$referencia')>"
                    }
                }
                div(class="col-lg-4 col-md-6 col-sm-12") {
                    p(class="mb-0") {
                        b{$"Vencimiento: "}
                        $"#<@@(infoDoc,'$fultmoratorios')>"
                    }
                }
                div(class="col-lg-4"){$""}
                div(class="col-lg-4 col-md-6 col-sm-12") {
                    p(class="mb-0") {
                        b{$"Divisa: "}
                        $"#<@@(infoDoc,'$divisa')>"
                    }
                }
                div(class="col-lg-4 col-md-6 col-sm-12") {
                    p(class="mb-0") {
                        b{$"Tipo de cambio: "}
                        $"#<@@(infoDoc,'$tipocambio')>"
                    }
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Capital:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#haber'),fmoneda)>"
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Intereses Financieros:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#intereses_financieros'),fmoneda)>"
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Intereses Moratorios:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#intereses_moratorios'),fmoneda)>"
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Bonificaciones:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#bonificaciones'),fmoneda)>"
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder"){$"Saldo:"}
                        div(class="col-6") {
                            $"#<format(@@(infoDoc,'#saldo'),fmoneda)>"
                        }
                    }
                    
                    hr{}
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_documento"){$"Tipo de documento:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_documento)
                            ##
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_referencia"){$"Referencia:"}
                        div(class="col-6") {
                            input(type="text" class="form-control" name="referencia" id="txt_referencia" value="#<@('$input/referencia')>" required="true")
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_fdoc"){$"Fecha del documento:"}
                        div(class="col-6") {
                            input(type="date" class="form-control" name="fecha_documento" id="txt_fdoc" value="#<@('$input/fecha_documento')>" required="true")
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_faplicacion"){$"Fecha de aplicación:"}
                        div(class="col-6") {
                            input(type="date" class="form-control" name="fecha_aplicacion" id="txt_faplicacion" value="#<@('$input/fecha_aplicacion')>" required="true")
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_tcambio"){$"Tipo de cambio:"}
                        div(class="col-6") {
                            input(type="number" class="form-control" name="tcambio" min="1" id="txt_tcambio" value="#<@('#input/tcambio')>" required="true")
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_importe"){$"Importe:"}
                        div(class="col-6") {
                            input(type="number" class="form-control" name="importe" min="1" id="txt_importe" value="#<@('#input/importe')>")
                        }
                    }

                    div(class="row mt-2 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_notas"){$"Notas:"}
                        div(class="col-6") {
                            textarea(class="form-control" name="notas" id="txt_notas" required="true")
                            {
                                #!
                                if @('$input/notas') == "" {#$ $"Cargos moratorios al documento con referencia #<@@(infoDoc,'$referencia')>" #!}
                                else {#$ $"#<@('$input/notas')>" }
                            }
                        }
                    }

                    hr{}
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label"){$"Nuevo saldo:"}
                        div(class="col-4") {
                            input(type="number" class="form-control" name="nuevo_saldo" id="txt_nuevo_saldo" value="" disabled="disabled" readonly="readonly")
                        }
                    }

                    div(class="mt-2 d-flex gap-1 justify-content-end")
                    {
                        button(type="submit" class="btn btn-primary"){$"Aceptar"}
                        A(type="reset" class="btn btn-danger" href="../../"){$"Cancelar"}
                    }
                }
            }
        }

        p{$"#<@('$error/message')>"}

        script
        {$'
            window.onload = function(){
                let txt_importe = document.getElementById("txt_importe");
                let form_aplintmor = document.getElementById("form_aplintmor");
                
                txt_importe.addEventListener("input",function(data) {
                    let saldo = #<@@(infoDoc,"#saldo")>;
                    let txt_nvosaldo = document.getElementById("txt_nuevo_saldo");
                    
                    txt_nvosaldo.value = Math.add(saldo,Number(txt_importe.value));
                });

                form_aplintmor.addEventListener("reset", () => {
                    window.location.href = "#<@CXC_DOCUMENTOS>";
                });
            }
        '}
    }
}