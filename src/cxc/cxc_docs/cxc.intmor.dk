#include "dkli.dkh"
#!
module "cxc.intmor.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"
    #include "dbr.dkh"
    #include "dbr.vars.dkl"

    do @context.begin(@crud_context)
    
    ref formData = ifnull(@("&./form"),record.create())
    ref infoDoc = ifnull(@("&./infoDoc"),record.create())
    ref documentos = ifnull(@('&./documentos'),list.create())
    ref dvsPred = ifnull(@("&./dvs_pred"),record.create())

    cDIVISA_PRED = field.dstr(dvsPred,"codigo","MXN")
    tCAMBIO_PRED = field.dnum(dvsPred,"tcambio",1)

    @DECIMAL_PRECISION = @("#parameters/decimals")

    num_step = "0."+padright("",(@DECIMAL_PRECISION-1),"0")+"1"
    num_max = "9999999999."+padright("",@DECIMAL_PRECISION,"9")

    new sel_documento
    {
        @"datatable*": documentos
        @"id": "sel_documento"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento","nm",@null)
    }

    format_decs=dbr.vars.get(@("&database"),"FORMAT_DECS")
    if trim(format_decs)==""{format_decs=@FMT_MONEY}

    vdecs=dbr.vars.get(@("&database"),"CANT_DECS")
    if trim(vdecs)==""{decs=6}
    else{decs=parse.num(vdecs)}

    #$
    div(class="container-md")
    {
        div(class="row container-section m-0 px-0 py-2 my-2 border-bottom sticky-top bg-white" id="main_action_bar")
        {
            div(class="col-4 d-flex align-items-center p-0") { h5(class="tex-no-break m-0"){$"Aplicar intereses moratorios"} }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn_save"){$"#<@ICON_SAVE> Guardar"}
                a(href="#<@CXC_DOCUMENTOS>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Salir"){$"#<@ICON_X_LG>"}
            }
        }

        form(action="." method="POST" id="form_intmor") //onsubmit="return cliente.form.ValidateForm(event)"
        {
            input(type="hidden" name="pkparent" value="#<@@(infoDoc,'#sys_pk')>")
            input(type="hidden" name="icliente" value="#<@@(infoDoc,'#icliente')>")

            div(class="row")
            {
                div(class="col-lg-8") {
                    div(class="row")
                    {
                        div(class="col-lg-4 col-md-4") {
                            p(class="mb-0") {
                                b{$"Cliente: "}
                                $"#<@@(infoDoc,'$cliente')>"
                            }
                        }
                        div(class="col-lg-4 col-md-4") {
                            p(class="mb-0") {
                                b{$"Divisa: "}
                                $"#<@@(infoDoc,'$divisa')>"
                            }
                        }
                        div(class="col-lg-4 col-md-4") {
                            p(class="mb-0") {
                                b{$"Tipo de cambio: "}
                                $"#<@@(infoDoc,'$tipocambio')>"
                            }
                        }
                        div(class="col-lg-6 col-md-6 col-sm-12") {
                            p(class="mb-0") {
                                b{$"Referencia del documento: "}
                                $"#<@@(infoDoc,'$referencia')>"
                            }
                        }
                        div(class="col-lg-6 col-md-6 col-sm-12") {
                            p(class="mb-0") {
                                b{$"Vencimiento: "}
                                $"#<@@(infoDoc,'$fultmoratorios')>"
                            }
                        }
                    }
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Capital:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" name="" value="#<@@(infoDoc,'#debe')>"
                                disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Intereses Financieros:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" name="" value="#<@@(infoDoc,'#intfinancieros')>"
                                disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Intereses Moratorios:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" name="" value="#<@@(infoDoc,'#intmoratorios')>"
                                disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Bonificaciones:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" name="" value="#<@@(infoDoc,'#bonificaciones')>"
                                disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Pagos:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" name="" value="#<@@(infoDoc,'#pagos')>"
                                disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bolder py-0"){$"Saldo:"}
                        div(class="col-6 text-end") {
                            input(
                                class="form-control-plaintext induxsoft-num-field mw-100 py-0"
                                type="number" name="" value="#<@@(infoDoc,'#saldo')>"
                                disabled=""
                                "num-style"="currency"
                                "num-currency"="#<@@(infoDoc,'$divisa')>"
                                "num-currency-display"="symbol"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }
                    
                    hr{}
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_documento"){$"Tipo de documento:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_documento)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_referencia"){$"Referencia:"}
                        div(class="col-6") {
                            input(type="text" class="form-control form-control-sm rounded-0" name="referencia" id="txt_referencia" value="#<form('referencia','tx',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_fdoc"){$"Fecha del documento:"}
                        div(class="col-6") {
                            input(type="date" class="form-control form-control-sm rounded-0" name="fecha" id="txt_fdoc" value="#<form('fecha','dt',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_faplicacion"){$"Fecha de aplicación:"}
                        div(class="col-6") {
                            input(type="date" class="form-control form-control-sm rounded-0" name="faplicacion" id="txt_faplicacion" value="#<form('faplicacion','dt',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center" id="div_tcambio")
                    {
                        label(class="col-auto col-form-label" "for"="txt_tcambio"){$"Tipo de cambio:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm") {
                                input(
                                    class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100"
                                    type="number" name="tipocambio" value="#<form('tipocambio','nm',infoDoc)>" id="txt_tcambio"
                                    step="#<num_step>" min="1" required="true"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                )
                                span(class="input-group-text rounded-0"){$"#<cDIVISA_PRED> = 1 #<@@(infoDoc,'$divisa')>"}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_importe"){$"Importe:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm") {
                                input(
                                    class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100 validate-number"
                                    type="number" name="importe" value="#<form('importe','nm',@null)>" id="txt_importe"
                                    step="#<num_step>" min="1" required="true"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                    onkeypress="return InduxsoftNumberFields.filterFloat(event,this,#<@DECIMAL_PRECISION>)"
                                )
                                span(class="input-group-text rounded-0"){$"#<@@(infoDoc,'$divisa')>"}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_notas"){$"Notas:"}
                        div(class="col-6") {
                            textarea(class="form-control form-control-sm rounded-0" name="notas" id="txt_notas" required="true")
                            {
                                #!
                                concepto = form("notas","tx",@null)
                                if concepto == "" { concepto = "Intereses moratorios al documento con referencia " + @@(infoDoc,'$referencia') }
                                #$
                                $"#<concepto>"
                            }
                        }
                    }

                    hr{}
                }
            }

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label"){$"Nuevo saldo:"}
                        div(class="col-4") {
                            #!
                            saldo = @@(infoDoc,"#saldo")
                            importe = form("importe","nm",@null)

                            nuevo_saldo =round((saldo + importe),decs)
                            #$
                            input(
                                class="form-control form-control-sm rounded-0 text-end induxsoft-num-field1"
                                type="number" name="nuevo_saldo" value="#<nuevo_saldo>"
                                id="txt_nuevo_saldo"
                                disabled="disabled"
                                readonly="readonly"
                                "num-style"="currency"
                                "num-decs"="#<@DECIMAL_PRECISION>"
                            )
                        }
                    }
                }
            }
        }

        p{$"#<@('$error/message')>"}

        div
        {
            script(src="#<@JS_DOCUMENTOS>"){$""}
            script(src="#<@JS_CLIENTES>"){$""}
            script(type="text/javascript")
            {$'
                document.addEventListener("DOMContentLoaded", () => {
                    documento.intmor.dtCxC = #<to.json(infoDoc)>;
                    documento.intmor.dvsPred = #<to.json(dvsPred)>;
                    documento.intmor.decimals = #<@DECIMAL_PRECISION>;
                    documento.intmor.init();
                    InduxsoftNumberFields.Init();
                });
            '}
        }
    }
}