#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../_lib/icons.dk"
    #include "../_lib/config.dk"
    #include "../_lib/date_filter.dk"
    
    do @context.begin(@crud_context)
    ref @http_context = @('&http')
    ref get = @@(@http_context,"&request/get")
    ref docs = ifnull(@("&."),list.create())

    tf::
    {
        #$ h6(class="pt-2 pe-2"){$"Fecha de emisión"} #!
    }

    point title_filter to tf
    
    #$
    div(class="container p-0")
    {
        div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Documentos por cobrar"}
            }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                a(href="#<@DOC_AGREGAR>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Agregar"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="documento.goTo('#<@DOC_CONSULTAR>')"){"Consultar"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="documento.goTo('#<@DOC_COBROS>')"){$"Cobrar documento"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="documento.goTo('#<@DOC_BONIFICACIONES>')"){$"Bonificaciones"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="documento.goTo('#<@DOC_INTMORATORIOS>')"){$"Int. Moratorios"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="documento.goTo('#<@DOC_APLICAR_ABONOS>')"){$"Aplicar abonos"}
                button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Imprimir" onclick="window.print()"){$"#<@ICON_PRINTER>"}
                a(href="/" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Salir" target="_top"){$"#<@ICON_X_LG>"}
            }
        }
        div(id="work_area" class="container-section mt-1")
        {
            p{$"#<@('$error/message')>"}
            #! do print_date_filter(get, title_filter, @null)
            #$ form(action="./" method="GET" id="form_search" class="d-flex mb-2 no-print")
            {
                input(class="induxsoft-form-control flex-grow-1" type="text" name="s" placeholder="Buscar" id="input_search" value='#<@@(get,"$s")>')
                button(class="btn btn-sm btn-primary induxsoft-corners d-flex gap-2 align-items-center") {
                    $"Buscar"
                    $"#<@ICON_SEARCH>"
                }
            }
            div
            {
                div(style="overflow-y:auto;max-height: 75vh;" class="mb-2" id="list_table_container")
                {
                    "edit-table"(class="w-100" id="tbl_cxc" data='#<to.json(docs)>' "html-encode"="true")
                    {
                        "edit-thead"
                        {
                            "edit-tr"
                            {
                                "edit-th"(type="NoEditable" field="ccliente"){$"Código"}
                                "edit-th"(type="NoEditable" field="cliente"){$"Cliente"}
                                "edit-th"(type="NoEditable" field="documento"){$"Documento"}
                                "edit-th"(type="NoEditable" field="referencia"){$"Referencia"}
                                "edit-th"(type="NoEditable" field="emision"){$"Emisión"}
                                "edit-th"(type="NoEditable" field="aplicacion"){$"Aplicación"}
                                "edit-th"(type="NoEditable" field="debe"){$"Debe"}
                                "edit-th"(type="NoEditable" field="haber"){$"Haber"}
                                "edit-th"(type="NoEditable" field="divisa"){$"Divisa"}
                            }
                        }
                    }
                }
            }
            #! lenght = @count(docs)
                
            if lenght <= 0
            {
                message = ""
                if field.exist(get,"s") && @@(get,"$s") == "" { message = "Sin registros." }
                else { message = "Sin resultados." }
                
                #$ div(class="text-center") {
                    h6(style="background-color: #F5F5F5; padding: 10rem 0;"){"#<message>"}
                }
            }
            #! else 
            {
                txt = ftext("Mostrando los primeros #<lenght> Documentos ordenados por fecha de emisión.")
                #$ small(class="text-secondary"){$"#<a1>"}
            }
        }

        div
        {
            script(src="#<@JS_DOCUMENTOS>"){$""}
            script(src="#<@JS_FILTER>"){$""}
            script(type="text/javascript")
            {$'
                document.addEventListener("DOMContentLoaded", () => {
                    documento.tableId = "tbl_cxc";
                    documento.init();
                });
            '}
        }
    }
}