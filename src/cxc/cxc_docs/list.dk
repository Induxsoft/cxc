#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"
    
    do @context.begin(@crud_context)
    
    #$
    div(class="container")
    {
        h1(class="h4 text-primary"){$"Documentos por cobrar"}

        div
        {
            div(class="bg-light my-1")
            {
                div(class="btn-group" role="group")
                {
                    a(href="#<@CXC_MENU>" class="btn btn-secondary btn-sm fw-bolder"){$"<--"}
                    a(href="#<@DOC_AGREGAR>" class="btn btn-light btn-sm fw-bolder"){$"Agregar"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@DOC_COBROS>')"){$"Cobrar documento"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@DOC_BONIFICACIONES>')"){$"Bonificaciones"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@DOC_INTMORATORIOS>')"){$"IntMoratorios"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@DOC_APLICAR_ABONOS>')"){$"Aplicar abonos"}
                    a(href="./" class="btn btn-light btn-sm fw-bolder"){$"Refrescar"}
                }
            }

            "edit-table"(class="w-100" id="tbl_dcxc" data="#<to.json(@('&.'))>")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="NoEditable" field="ccliente"){$"Código"}
                        "edit-th"(type="NoEditable" field="cliente"){$"Cliente"}
                        "edit-th"(type="NoEditable" field="documento"){$"Documento"}
                        "edit-th"(type="NoEditable" field="referencia"){$"Referencia"}
                        "edit-th"(type="NoEditable" field="emision"){$"Emisión"}
                        "edit-th"(type="NoEditable" field="aplicacion"){$"Aplicación"}
                        "edit-th"(type="NoEditable" field="debe"){$"Debe"}
                        "edit-th"(type="NoEditable" field="haber"){$"Haber"}
                        "edit-th"(type="NoEditable" field="divisa"){$"Divisa"}
                    }
                }
                /* "edit-tbody"
                {
                    // contenido...
                } */
            }
        }

        p{$"#<@('$error/message')>"}

        script
        {$'
            var table = document.getElementById("tbl_dcxc");

            function goTo(url)
            {
                if (!url) { alert("No se ha indicado un destino."); return; }
                if (table.CurrentRowIndex() < 0) { alert("Debe seleccionar una fila"); return; }

                var data = table.DataArray[table.CurrentRowIndex()];

                var url = url.replace("_documento",data.sys_pk);
                window.location.href = url;
            }
        '}
    }
}