#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    do @context.begin(@crud_context)

    ref cliente = ifnull(@("&./cliente"), record.create())

    @_entities_type = @("$parameters/_entities_type")
    @_entity_id     = @("$parameters/_entity_id")
    @is_new         = (@_entity_id == "_new")
    @form_id        = "frm_"+@_entities_type

    // Serializar datos del cliente para el InputKey (data-value)
    cliente_json = to.json(cliente)

    function printNavButtons()
    {
        cls = "btn btn-main-action btn-sm border-secondary induxsoft-corners"
        #$
        button(class="#<cls>" type="submit" form="#<@form_id>" title="Guardar"){$"Guardar"}
        #!
    }
    point buttons to printNavButtons

    new nav_config
    {
        @"title": ifstr(@is_new,"Agregar","Editar") + " contacto de cobranza"
        @"buttons*": buttons
        member @"hidden"
        {
            @"copy":  @true
            @"csv":   @true
            @"print": @true
            @"send":  @true
        }
    }

    #$
    div(class="container-lg" id="view")
    {
        section(id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$
        }

        section(id="work_area" style="overflow-y:auto; overflow-x:hidden;")
        {
            #!
            error = @("$error/message")
            if error != ""
            {
                #$
                div(class="alert alert-danger alert-dismissible fade show mb-2 pb-1" role="alert")
                {
                    div(class="w-100 overflow-auto pb-2"){$"#<error>"}
                    button(type="button" class="btn-close" "data-bs-dismiss"="alert" "aria-label"="Close"){""}
                }
                #!
            }
            #$

            form(class="px-1" action="./" method="POST" id="#<@form_id>")
            {
                input(type="hidden" name="sys_pk"     value="#<@('#./sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@('#./sys_recver')>")
                #!
                do uie.print_from_url_field()
                #$

                div(class="row g-3")
                {
                    // Cliente
                    div(class="col-12")
                    {
                        label(class="form-label" "for"="icliente"){$"Cliente"}
                        "input-key"(
                            id="icliente"
                            name="icliente"
                            "data-key"="sys_pk"
                            "data-search"="codigo"
                            "data-text"="nombre"
                            "data-value"="#<cliente_json>"
                            "data-source"="#<@CXC_BUSCAR_CLIENTE>"
                            columns="codigo,nombre"
                            colcaptions="Código,Nombre"
                            "box-title-text"="Seleccione un cliente"
                            required=""
                        ){$""}
                    }
                    // Nombre
                    div(class="col-12 col-md-6")
                    {
                        label(class="form-label" "for"="nombre"){$"Nombre del contacto"}
                        input(class="form-control rounded-0" type="text" name="nombre" id="nombre" value="#<@('$./nombre')>" maxlength="80" required="")
                    }
                    // Puesto
                    div(class="col-12 col-md-6")
                    {
                        label(class="form-label" "for"="puesto"){$"Puesto"}
                        input(class="form-control rounded-0" type="text" name="puesto" id="puesto" value="#<@('$./puesto')>" maxlength="50")
                    }
                    // Teléfono
                    div(class="col-12 col-md-6")
                    {
                        label(class="form-label" "for"="telefono"){$"Teléfono"}
                        div(class="input-group")
                        {
                            input(class="form-control rounded-0" type="tel" name="telefono" id="telefono" value="#<@('$./telefono')>" placeholder="+52 1 123 456 7890")
                        }
                    }
                    // WhatsApp
                    div(class="col-12 col-md-6")
                    {
                        label(class="form-label" "for"="whatsapp"){$"WhatsApp"}
                        div(class="input-group")
                        {
                            input(class="form-control rounded-0" type="tel" name="whatsapp" id="whatsapp" value="#<@('$./whatsapp')>" maxlength="25" placeholder="+52 1 123 456 7890")
                        }
                    }
                    // Email
                    div(class="col-12 col-md-6")
                    {
                        label(class="form-label" "for"="email"){$"Correo electrónico"}
                        input(class="form-control rounded-0" type="email" name="email" id="email" value="#<@('$./email')>" maxlength="150")
                    }
                    // Notas
                    div(class="col-12")
                    {
                        label(class="form-label" "for"="notas"){$"Notas"}
                        textarea(class="form-control rounded-0" name="notas" id="notas" rows="3"){$"#<@('$./notas')>"}
                    }
                }
            }
        }

        section(id="bottom_area")
        {
            div(id="_custom_area")
            {
                script(type="text/javascript")
                {$'
                    document.addEventListener("DOMContentLoaded", () => {
                        // Script injection
                        #<@@(@crud_context,"$script")>
                    });
                '}
            }
        }
    }
    #!

    do @context.end()
}
