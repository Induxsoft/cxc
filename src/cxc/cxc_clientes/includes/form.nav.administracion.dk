#include "dkli.dkh"
#$
section(class="" id="")
{
    div(class="row")
    {
        div(class="col-lg-6 col-md-6 col-sm-6")
        {
            label(class="form-label" "for"="sel_divisa"){$"Divisa:" sup{$"*"}}
            ##
            do uie.dbSelect(sel_divisa)
            ##
        }
        div(class="col-lg-6 col-md-6 col-sm-6")
        {
            label(class="form-label" "for"="sel_agente"){$"Agente:"}
            ##
            do uie.dbSelect(sel_agente)
            ##
        }
        div(class="col-lg-6 col-md-6 col-sm-6")
        {
            label(class="form-label" "for"="sel_precio"){$"Precio:"}
            ##
            do uie.dbSelect(sel_precio)
            ##
        }
        div(class="col-lg-6 col-md-6 col-sm-6")
        {
            label(class="form-label" "for"="txt_descuento"){$"%Descuento:"}
            input(class="form-control form-control-sm rounded-0" type="number" name="descuento" value="#<form('descuento','nm',cliente)>" id="txt_descuento" min="0" max="#<num_max>" step="#<num_step>")
        }

        div(class="col-lg-6 col-md-6 col-sm-6")
        {
            #!
            limitecredito = form('limitecredito','nm',cliente)
            has_credit = (limitecredito > 0 || limitecredito == -1)
            unlimited = (limitecredito == -1)

            limitecredito_ipt=if(limitecredito<0,0,limitecredito)
            #$ div(class="form-check") {
                input(type="checkbox" class="form-check-input" name="chq_otorgar_credito" id="chq_otorgar_credito" "#<ifstr(has_credit,'checked','')>"="")
                label(class="form-check-label" "for"="chq_otorgar_credito"){$"Otorgar crédito"}
            }
            hr(class="my-1"){}
            div(class="bg-light #<ifstr(has_credit,'','disable-form')>" id="div_otorgar_credito")
            {
                div(class="form-check form-check-inline")
                {
                    label(class="form-check-label") {
                        input(class="form-check-input" type="radio" name="rd_limitar_credito" value="0" id="rd_credito_ilimitado" "#<ifstr(unlimited,'checked','')>"="")
                        $"Ilimitado"
                    }
                }
                div(class="form-check form-check-inline")
                {
                    label(class="form-check-label") {
                        input(class="form-check-input" type="radio" name="rd_limitar_credito" value="1" id="rd_credito_limitado" "#<ifstr(has_credit && not(unlimited),'checked','')>"="")
                        $"Limite"
                    }
                }
                div(class="form-check form-check-inline ps-0")
                {
                    input(type="#<ifstr(has_credit && not(unlimited),'number','hidden')>" class="form-control form-control-sm rounded-0" name="limitecredito" value="#<limitecredito_ipt>" id="txt_limite_credito" min="-1" max="#<num_max>" step="#<num_step>")
                }
            }
        }
        div(class="col-lg-6 col-md-6 col-sm-6")
        {
            label(class="form-label" "for"="txt_dias_credito"){$"Dias de crédito:"}
            input(class="form-control form-control-sm rounded-0" type="number" name="diascredito" min="0" value="#<form('diascredito','nm',cliente)>" id="txt_dias_credito")
        }

        div(class="col-lg-4 col-md-4 col-sm-4")
        {
            label(class="form-label" "for"="txt_cuenta_contable"){$"Cuenta contable:"}
            input(class="form-control form-control-sm rounded-0" type="text" name="codcuenta" maxlength="50" value="#<form('codcuenta','tx',cliente)>" id="txt_cuenta_contable")
        }
        div(class="col-lg-4 col-md-4 col-sm-4")
        {
            label(class="form-label" "for"="sel_zona"){$"Zona:"}
            ##
            do uie.dbSelect(sel_zona)
            ##
        }
        div(class="col-lg-4 col-md-4 col-sm-4")
        {
            label(class="form-label" "for"="sel_status"){$"Status:"}
            ##
            do uie.dbSelect(sel_status)
            ##
        }

        div(class="col-lg-4 col-md-4 col-sm-4")
        {
            label(class="form-label" "for"="txt_saldo_xcobrar"){$"Saldo por cobrar:"}
            input(class="form-control form-control-sm rounded-0" type="number" name="saldo" value="#<form('saldo','nm',cliente)>" id="txt_saldo_xcobrar" readonly="")
        }
        div(class="col-lg-4 col-md-4 col-sm-4")
        {
            label(class="form-label" "for"="txt_saldo_monedero"){$"Saldo en monedero:"}
            input(class="form-control form-control-sm rounded-0" type="number" name="monedero" value="#<form('monedero','nm',cliente)>" id="txt_saldo_monedero" readonly="")
        }
        div(class="col-lg-4 col-md-4 col-sm-4")
        {
            label(class="form-label" "for"="txt_puntos_disponibles"){$"Puntos disponibles:"}
            input(class="form-control form-control-sm rounded-0" type="number" name="puntos" value="#<form('puntos','nm',cliente)>" id="txt_puntos_disponibles" readonly="")
        }

        div(class="col-12")
        {
            #!
            checked = ifstr(not(field.exist(@("&."),"form")), "checked", form("chq_addenda","ch",@null))
            if @("$parameters/_entity_id") != "_new" { checked = ifstr(parse.bool(@@(cliente,"#uf_addenda")),"checked","") }
            #$
            div(class="form-check") {
                input(type="checkbox" class="form-check-input" name="chq_addenda" id="chq_addenda" "#<checked>"="")
                label(class="form-check-label" "for"="chq_addenda"){$"Incluir addenda en comprobante fiscal digital"}
            }
        }
    }
}