#include "dkli.dkh"
#!
module "cte.balance.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "dbr.vars.dkl"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"
    #include "../_lib/icons.dk"
    
    do @context.begin(@crud_context)
    ref @http_context = @('&http')
    ref get = @@(@http_context,"&request/get")
    ref @_GET=get
    
    get<"filter-mode">: ifstr(trim(@@(get,"filter-mode"))!="", @@(get,"filter-mode"), "month")
    get<"year">: ifstr(trim(@@(get,"year"))!="", @@(get,"year"), str(ndatetime.year(ndatetime.now())))
    get<"month">: ifstr(trim(@@(get,"month"))!="", @@(get,"month"), str(ndatetime.month(ndatetime.now())))

    new nav_config
    {
        @"title": "Balance"
        @"buttons*": @null
        @"urlexit": @CXC_CLIENTES
        @"main": "GB11,GB12,GB13,GB14,GB15,GB16"
        @"actions*": dbr.apps.itemactions(@('&database'),"DET01D","action","",0)
        @"reports*": dbr.apps.itemactions(@('&database'),"DET01D","report","",0)
        @"jscurrentcontext": "getCurrentContext"
    }
     ref list_years = list_years(10,0)
    fdr_year_opt = ""
    for i = 0; i < list.count(list_years) { fdr_year_opt = fdr_year_opt + list.str(list_years,i) + "," }
    fdr_year_opt = rremove(fdr_year_opt,1)

    new fdr_init
    {
        @"fdr_mode": field.dstr(@_GET,"fdr_mode","month")
        // [month]
        @"fdr_year": field.dnum(@_GET,"fdr_year",@curr_year)
        @"fdr_month": field.dnum(@_GET,"fdr_month",@curr_month)
        // [lastdays]
        @"fdr_range": field.dnum(@_GET,"fdr_range",30)
        // [range]
        @"fdr_from": field.dstr(@_GET,"fdr_from","")
        @"fdr_to": field.dstr(@_GET,"fdr_to","")
    }

    new fil_fdr_field
    {
        @"datatable*": from.json('[
            {"id":1, "const":"Emisión"},
            {"id":2, "const":"Vencimiento"},
        ]')
        @"id": "fil_fdr_field"
        member "attributes"
        {
            @"name": "fil_fdr_field"
            @"class": "induxsoft-form-select"
            @"title": "Elegir método de filtro para el rango de fechas"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @("#parameters/fil_fdr_field")
    }

    vdecs=dbr.vars.get(@("&database"),"CANT_DECS")
    if trim(vdecs)==""{decs=2}
    else{decs=parse.num(vdecs)}

    format_decs=dbr.vars.get(@("&database"),"FORMAT_DECS")
    if trim(format_decs)==""{format_decs="$ #,#.00"}

    #$ div(class="v12-list-view" id="view")
    {
        section(class="container-fluid bg-white" id="top_area")
        {
            #! do uie.printV12FormBar(nav_config)
            #$ form(action="./" method="GET" id="form_filter" class="no-print my-1")
            {
                div(class="d-flex align-items-center")
                {
                    div
                    {
                        ##
                        do uie.dbSelect(fil_fdr_field)
                        ##
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-date-range"(
                            "form"="#form_filter"
                            "auto-submit"="true"
                            "custom-range"="true"
                            "selection"='#<to.json(fdr_init)>'

                            "mode-field"="fdr_mode"
                            "year-field"="fdr_year"
                            "month-field"="fdr_month"
                            "range-field"="fdr_range"
                            "from-field"="fdr_from"
                            "to-field"="fdr_to"
                            
                            "lastdays-options"="15,30,45,60,90"
                            "years-options"="#<fdr_year_opt>"
                            "month-names"="Enero,Febrero,Marzo,Abril,Mayo,Junio,Julio,Agosto,Septiembre,Octubre,Noviembre,Diciembre"
                            
                            "label-months"="Ver por cada mes"
                            "label-days"="Últ. @lastdays días"
                            "label-custom"="Personalizado"
                            "label-from"="Desde:"
                            "label-to"="Hasta:"
                        ){$""}
                    }
                }
                div(class="flex-grow-1 py-1")
                {
                    #$ "filter-text"(
                        "id"="ft_search"
                        "text-field"="s"
                        "placeholder"="Buscar por referencia"
                        "form"="#form_filter"
                        "value"="#<@@(get,'$s')>"
                        "auto-submit"="true"
                        "class"="w-100"
                    ){$""}
                }
            }

            div(class="d-flex justify-content-between")
            {
                h6(class=""){$"#<@('$./nombre')>"}
                h6(class=""){$"#<@('$./divisa')>"}
            }

            table(class="table table-sm table-bordered")
            {
                thead
                {
                    tr
                    {
                        th(class="text-center"){$"Saldo inicial"}
                        th(class="text-center"){$"Debe"}
                        th(class="text-center"){$"Haber"}
                        th(class="text-center"){$"Saldo al final"}
                        th(class="text-center"){$"Saldo docs"}
                        th(class="text-center"){$"Por aplicar"}
                    }
                }
                tbody
                {
                    tr
                    {
                        td(class="text-end"){$"#<format(@('#./saldos/saldo_inicial'),format_decs)>"}
                        td(class="text-end"){$"#<format(@('#./saldos/debe'),format_decs)>"}
                        td(class="text-end"){$"#<format(@('#./saldos/haber'),format_decs)>"}
                        td(class="text-end"){$"#<format(@('#./saldos/saldo_alfinal'),format_decs)>"}
                        td(class="text-end"){$"#<format(@('#./saldos/saldo_docs'),format_decs)>"}
                        td(class="text-end"){$"#<format(@('#./saldos/por_aplicar'),format_decs)>"}
                    }
                }
            }
        }

        section(class="container-fluid" id="work_area")
        {
            "edit-table"(class="w-100" id="tbl_dcxc" data="#<to.json(@('&./docs'))>")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="NoEditable" field="documento"){$"Documento"}
                        "edit-th"(type="NoEditable" field="referencia"){$"Referencia"}
                        "edit-th"(type="NoEditable" field="emision"){$"Emisión"}
                        "edit-th"(type="NoEditable" field="aplicacion"){$"Aplicación"}
                        "edit-th"(type="NoEditable" field="debe" textalign="end" format="true" decs="#<decs>" prefix="$ " thousandssep="true"){$"Debe"}
                        "edit-th"(type="NoEditable" field="haber" textalign="end" format="true" decs="#<decs>" prefix="$ " thousandssep="true"){$"Haber"}
                        "edit-th"(type="NoEditable" field="notas"){$"Concepto"}
                    }
                }
            }
        }

        p{$"#<@('$error/message')>"}

        script(type="text/javascript")
		{$'
			function getCurrentContext()
			{
				const table = document.getElementById("tbl_dcxc");
				const id = (table?.DataArray[table.CurrentRowIndex()]?.sys_pk ?? "");
    			return { item_id:id, context: {} }
			}

            document.addEventListener("DOMContentLoaded", () => {
                const table = document.getElementById("tbl_dcxc");
                const event = table.EdiTable.Const.Events;

                table.Events[event.RowChanged] = (e) => {
                    let obj = table.DataArray[e.index];

                    v12navbar.toggleButtonInteraction(!obj);
                    
                    const btn_cobrar = document.getElementById("v12_GB13");
                    const btn_bonif = document.getElementById("v12_GB14");
                    const btn_intmor = document.getElementById("v12_GB15");
                    const btn_aplicar = document.getElementById("v12_GB16");

                    if (btn_cobrar) btn_cobrar.parentElement.hidden = (Number(obj?.debe) <= 0);
                    if (btn_bonif) btn_bonif.parentElement.hidden = (Number(obj?.debe) <= 0);
                    if (btn_intmor) btn_intmor.parentElement.hidden = (Number(obj?.debe) <= 0);
                    if (btn_aplicar) btn_aplicar.parentElement.hidden = (Number(obj?.haber) <= 0);
                }

                v12navbar.toggleButtonInteraction(true);
            });
		'}
    }
}