#include "dkli.dkh"
#!
module "model"
{
    @table_name = "cliente"
    @read_query = "
    SELECT
        sys_pk,
        sys_guid,
        sys_recver,
        IFNULL(codcuenta,'') codcuenta,
        codigo,
        IFNULL(curp,'') curp,
        IFNULL(descuento,0) descuento,
        IFNULL(diascredito,0) diascredito,
        IFNULL(email,'') email,
        IFNULL(fax,'') fax,
        IFNULL(limitecredito,0) limitecredito,
        IFNULL(monedero,0) monedero,
        nombre,
        IFNULL(notas,'') notas,
        IFNULL(precio,0) precio,
        IFNULL(puntos,0) puntos,
        IFNULL(rfc,'') rfc,
        IFNULL(saldo,0) saldo,
        IFNULL(saldopuntos,0) saldopuntos,
        status,
        IFNULL(telefonos,'') telefonos,
        IFNULL(website,'') website,
        agente,
        contacto1,
        contacto2,
        contacto3,
        domicilio1,
        domicilio2,
        domicilio3,
        idivisa,
        tipo,
        zona,
        uf_addenda,
        regfiscal
    FROM cliente
    WHERE #<@keyfield> = @_entity_id
    "

    cte.buscarCliente::&db,&params
    {
        sql = "
        SELECT
            cte.sys_pk,
            cte.sys_guid,
            cte.sys_recver,
            cte.codigo,
            cte.nombre,
            IFNULL(cte.rfc,'') AS rfc,
            IFNULL(cte.saldo,0) AS saldo,
            tpc.descripcion AS tipo,
            dvs.codigo AS divisa,
            dvs.tcambio,
            IFNULL(zna.nombre,'') AS zona
        FROM cliente AS cte
            INNER JOIN tipocliente AS tpc ON tpc.sys_pk = cte.tipo
            INNER JOIN divisa AS dvs ON dvs.sys_pk = cte.idivisa
            LEFT JOIN zona AS zna ON zna.sys_pk = cte.zona
        WHERE #<condition>
        "
        
        if trim(@@(params,"$id")) != "" {
            condition = "(cte.sys_pk = @id OR cte.sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = ftext("IF(IFNULL(@search,'')='',true,(cte.codigo LIKE CONCAT('%',@search,'%') OR cte.nombre LIKE CONCAT('%',@search,'%') OR cte.rfc LIKE CONCAT('%',@search,'%')))
                ORDER BY cte.codigo
                LIMIT #<@default_max_rows>;

            ")
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.buscarContacto::&db,&params
    {
        sql = "
        SELECT
            sys_pk,
            sys_guid,
            IFNULL(apellidos,'') apellidos,
            IFNULL(nombre,'') nombre,
            IFNULL(empresa,'') empresa,
            IFNULL(tratamiento,'') tratamiento
        FROM contacto
        WHERE #<condition>
        "
        if trim(@@(params,"$id")) != "" {
            condition = "(sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = "(apellidos LIKE CONCAT('%',@search,'%') OR nombre LIKE CONCAT('%',@search,'%') OR empresa LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.buscarEstado::&db,&params
    {
        sql = "
        SELECT
            sys_pk,
            sys_guid,
            sys_recver,
            codigo,
            nombre,
            ipais,
            CONCAT('[',codigo,'] ',nombre) AS `text`
        FROM edoprov 
        WHERE NOT IFNULL(sys_deleted,0) #<condition>
        ORDER BY sys_pk ASC;"

        if trim(@@(params,"$id")) != "" {
            condition = "AND (sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if @@(params,"#ipais") > 0 {
            condition = "AND ipais = @ipais"
            return dbr.list(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != {
            condition = "AND (codigo LIKE CONCAT('%',@search,'%') OR nombre LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.buscarCiudad::&db,params
    {
        sql = "
        SELECT
            sys_pk,
            sys_guid,
            sys_recver,
            codigo,
            nombre,
            codigotel,
            estado,
            CONCAT('[',codigo,'] ',nombre,' (',codigotel,')') AS `text`
        FROM ciudad
        WHERE NOT IFNULL(sys_deleted,0) #<condition>
        ORDER BY sys_pk ASC;
        "

        if trim(@@(params,"$id")) != "" {
            condition = "AND (sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if @@(params,"#iestado") > 0 {
            condition = "AND estado = @iestado"
            return dbr.list(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != {
            condition = "AND (codigo LIKE CONCAT('%',@search,'%') OR nombre LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.buscarTipos::&db,&params
    {
        sql = "
        SELECT
            sys_pk,
            sys_guid,
            codigo,
            descripcion,
            IFNULL(notas,'') notas
        FROM tipocliente
        WHERE #<condition>
        "
        if trim(@@(params,"$id")) != "" {
            condition = "(sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = "(codigo LIKE CONCAT('%',@search,'%') OR descripcion LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.obtenerCliente::&db,id
    {
        new params { @"id": id }
        return cte.buscarCliente(db,params)
    }

    function setPrintTitles(&db,&data)
    {
        using data
        {
            member @"titles"
            {
                @"title": dbr.vars.getd(db,"FXCA108","")
                @"subtitle": dbr.vars.getd(db,"FXCA109","")
                @"subtitle_2": dbr.vars.getd(db,"FXCA110","")
                @"footer": dbr.vars.getd(db,"FXCA111","")
            }
        }
    }

    cte.prepareView::&db,&params,&data
    {
        //#region prepareView()
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }

        switch @@(params,"$_view")
        {
            case "bonificacion"
            {
                data<"infoCliente*"> : cte.obtenerCliente(db,@@(params,"_entity_id"))
                sql = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxc_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.apl_bonific,0);"
                data<"documentos*"> : dbr.list(db,sql,@null)
                break
            }
            case "devolucion"
            {
                sql_cuentas = "SELECT c.sys_pk, d.codigo AS divisa, d.tcambio, CONCAT(c.nombre,' (',d.codigo,')') nombre FROM chequera c INNER JOIN divisa d ON d.sys_pk = c.idivisa WHERE NOT IFNULL(c.sys_deleted,0) ORDER BY c.sys_pk;"
                sql_categorias = "SELECT sys_pk,descripcion FROM categoria WHERE tipo = 2 AND NOT IFNULL(sys_deleted,0) ORDER BY sys_pk;"
                sql_doc_cargos = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxc_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.apl_int_mor,0);"
                sql_doc_retiros = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_chq_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.retiros,0);"

                data<"cliente*"> : cte.obtenerCliente(db,@@(params,"_entity_id"))
                data<"cuentas*"> : dbr.list(db,sql_cuentas,@null)
                data<"categorias*"> : dbr.list(db,sql_categorias,@null)
                data<"doc_retiros*"> : dbr.list(db,sql_doc_retiros,@null)
                data<"doc_cargos*"> : dbr.list(db,sql_doc_cargos,@null)
                break
            }
            case "cobrar"
            {
                sql_cuentas = "SELECT c.sys_pk, d.codigo AS divisa, d.tcambio, CONCAT(c.nombre,' (',d.codigo,')') nombre FROM chequera c INNER JOIN divisa d ON d.sys_pk = c.idivisa WHERE NOT IFNULL(c.sys_deleted,0) ORDER BY c.sys_pk;"
                sql_categorias = "SELECT sys_pk,descripcion FROM categoria WHERE tipo = 1 AND NOT IFNULL(sys_deleted,0) ORDER BY sys_pk;"
                sql_doc_cobros = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxc_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.apl_pago,0);"
                sql_doc_depositos = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_chq_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.depositos,0);"

                data<"infoCliente*"> : cte.obtenerCliente(db,@@(params,"_entity_id"))
                data<"cuentas*"> : dbr.list(db,sql_cuentas,@null)
                data<"categorias*"> : dbr.list(db,sql_categorias,@null)
                data<"docCobros*"> : dbr.list(db,sql_doc_cobros,@null)
                data<"docDepositos*"> : dbr.list(db,sql_doc_depositos,@null)
                break
            }
            case ""
            {
                sql_tipos_clientes = "SELECT sys_pk, CONCAT('[',codigo,'] ',descripcion) AS `text` FROM tipocliente ORDER BY sys_pk ASC;"
                sql_divisas = "SELECT sys_pk, codigo, tcambio, CONCAT('[',codigo,'] ',descripcion) AS `text` FROM divisa ORDER BY sys_pk ASC;"
                sql_pais = "SELECT sys_pk, codigo, CONCAT('[',codigo,'] ',nombre,' (',codigotel,')') AS `text` FROM pais WHERE NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
                sql_estado = "SELECT sys_pk, codigo, ipais, CONCAT('[',codigo,'] ',nombre) AS `text` FROM edoprov WHERE NOT IFNULL(sys_deleted,0) AND ipais = @ipais ORDER BY sys_pk ASC;"
                sql_ciudad = "SELECT sys_pk, codigo, estado, CONCAT('[',codigo,'] ',nombre,' (',codigotel,')') AS `text` FROM ciudad WHERE NOT IFNULL(sys_deleted,0) AND estado = @iestado ORDER BY sys_pk ASC;"
                sql_agente = "SELECT sys_pk, CONCAT('[',codigo,'] ',nombre) AS `text` FROM agente WHERE NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
                sql_zona = "SELECT sys_pk, nombre AS `text` FROM zona WHERE NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
                sql_status = "SELECT id, const FROM cstatusorg ORDER BY id ASC;"

                new p {}
                ref list_pais = dbr.list(db,sql_pais,@null)
                ref list_estado = @null
                ref list_ciudad = @null

                if @@(params,"$_entity_id") != "_new"
                {
                    sql_domicilio = "
                    SELECT
                        dm.sys_pk,
                        dm.sys_guid,
                        dm.sys_recver,
                        IFNULL(dm.codpos,'') codpos,
                        IFNULL(dm.colonia,'') colonia,
                        IFNULL(dm.direccion,'') direccion,
                        IFNULL(dm.numint,'') numint,
                        IFNULL(dm.numext,'') numext,
                        IFNULL(dm.telefonos,'') telefonos,
                        IFNULL(dm.notas,'') notas,
                        dm.iciudad,
                        cd.estado iestado,
                        ed.ipais
                    FROM domicilio dm
                        INNER JOIN ciudad cd ON dm.iciudad = cd.sys_pk
                        INNER JOIN edoprov ed ON cd.estado = ed.sys_pk
                    WHERE #<condition>
                    "
                    ref cliente = entity.read(db,params)
                    using p
                    {
                        @"domicilio1": @@(cliente,"#domicilio1")
                        @"domicilio2": @@(cliente,"#domicilio2")
                        @"domicilio3": @@(cliente,"#domicilio3")
                    }
                    
                    data<"cliente*"> : cliente
                    condition = "dm.sys_pk = @domicilio1"
                    data<"domicilio1*"> : dbr.rec(db,ftext(sql_domicilio),p)
                    condition = "dm.sys_pk = @domicilio2"
                    data<"domicilio2*"> : dbr.rec(db,ftext(sql_domicilio),p)
                    condition = "dm.sys_pk = @domicilio3"
                    data<"domicilio3*"> : dbr.rec(db,ftext(sql_domicilio),p)
                }

                data<"list_tclientes*"> : dbr.list(db,sql_tipos_clientes,@null)
                data<"list_divisas*"> : dbr.list(db,sql_divisas,@null)
                data<"list_pais*"> : list_pais
                data<"list_estado*"> : list_estado
                data<"list_ciudad*"> : list_ciudad
                data<"list_agente*"> : dbr.list(db,sql_agente,@null)
                data<"list_zona*"> : dbr.list(db,sql_zona,@null)
                data<"list_status*"> : dbr.list(db,sql_status,@null)
                break
            }
        }

        using data
        {
            @"dvsPred*": dbr.localize.money(db,@dbr.localize.default.money_code)
            @"decimals": @@(params,"#decimals")
        }
    }

    cte.obtenerSaldos::&db,&params
    {
        ejercicio = @@(params,"#fdr_year")
        periodo = @@(params,"#fdr_month")

        if ejercicio <= 0 { ejercicio = val(hoy("yyyy")) }
        if periodo <= 0 || periodo > 12 { periodo = val(hoy("MM")) }

        first_day = str(ejercicio) + "-" + format(periodo,"00") + "-01"
        
        params<"ejercicio"> : ejercicio
        params<"periodo"> : periodo
        params<"fd"> : first_day
        
        conditions=@@(params,"$conditions")
        
        fdr_field=@@(params,"$fdr_field")
        if trim(fdr_field)==""{fdr_field="aplicacion"}

        c_sql_sinicial = ""
        c_sql_dbe_hbr=""
        
        switch @@(params,"$fdr_mode")
        {
            case "month"
            {
                c_sql_sinicial = c_sql_sinicial +  " AND DATE(#<fdr_field>) < @fd; "
                c_sql_dbe_hbr=c_sql_dbe_hbr + " AND DATE(#<fdr_field>) BETWEEN @fd AND LAST_DAY(@fd); "
            }
            default
            {
                c_sql_sinicial = c_sql_sinicial +" and DATE(#<fdr_field>) < @fdr_month;"
                c_sql_dbe_hbr=c_sql_dbe_hbr + conditions
                break
            }
        }

        sql_sinicial = "SELECT IFNULL(SUM(IFNULL(debe,0) - IFNULL(haber,0)),0) AS saldo_inicial 
        FROM dcxc as cxc WHERE icliente = @_entity_id #<ftext(c_sql_sinicial)>"
        
        sql_dbe_hbr = "SELECT IFNULL(SUM(IFNULL(haber,0)),0) AS haber, IFNULL(SUM(IFNULL(debe,0)),0) AS debe 
        FROM dcxc as cxc WHERE icliente = @_entity_id #<ftext(c_sql_dbe_hbr)>;"

        sql_stotal = "SELECT IFNULL(SUM(IFNULL(debe,0) - IFNULL(haber,0)),0) AS saldo_total 
        FROM dcxc as cxc WHERE icliente = @_entity_id;"

        sql_sdocs = "SELECT IFNULL(SUM(IFNULL(debe,0) + IFNULL(intmoratorios,0) - IFNULL(pagos,0) - IFNULL(bonificaciones,0)),0) AS saldo_docs 
        FROM dcxc as cxc WHERE icliente = @_entity_id AND aplicable;"

        sql_haber="select IFNULL(SUM(IFNULL(debe,0)-IFNULL(haber,0)),0) from dcxc as cxc WHERE icliente = @_entity_id "
        debe=dbr.num(db,sql_haber,params)

        sInicial = dbr.num(db,ftext(sql_sinicial),params)
        
        ref DebeHaber = dbr.rec(db,ftext(sql_dbe_hbr),params)
        sTotal = dbr.num(db,ftext(sql_stotal),params)
        sDocs = dbr.num(db,ftext(sql_sdocs),params)
        
        xAplicar = abs(sDocs - debe)
        // Saldo al final del periodo
        sFinalP = (sInicial + @@(DebeHaber,"#debe") - @@(DebeHaber,"#haber"))

        new saldos
        {
            @"saldo_inicial": sInicial
            @"debe": @@(DebeHaber,"#debe")
            @"haber": @@(DebeHaber,"#haber")
            @"saldo_total": sTotal
            @"saldo_docs": sDocs
            @"por_aplicar": xAplicar
            @"saldo_alfinal": sFinalP
        }

        return saldos
    }

    cte.getConditionFilter::&params
    {
        // fdr_init
        if not(field.exist(params,"fdr_mode")) { params<"fdr_mode"> : "month" }
        // [month]
        if not(field.exist(params,"fdr_year")) { params<"fdr_year"> : @curr_year }
        if not(field.exist(params,"fdr_month")) { params<"fdr_month"> : @curr_month }
        // [lastdays]
        if not(field.exist(params,"fdr_range")) { params<"fdr_range"> : 30 }
        // [range]
        if not(field.exist(params,"fdr_from")) { params<"fdr_from"> : "" }
        if not(field.exist(params,"fdr_to")) { params<"fdr_to"> : "" }
        //#endregion

        conditions = ""

        //#region filter-date-range
        new vnt_date_fields
        {
            @"1": "cxc.fecha" // Emisión
            @"2": "cxc.aplicacion" // Vencimiento
        }
        fdr_field = @@(vnt_date_fields,str(@@(params,"#fil_fdr_field")))
        if trim(fdr_field)==""{fdr_field=@@(vnt_date_fields,"1")}
        
        switch @@(params,"$fdr_mode")
        {
            case "month"
            {
                curr_ndt = ndatetime.now()
                curr_year = ndatetime.year(curr_ndt)
                curr_month = ndatetime.month(curr_ndt)
                curr_day = ndatetime.day(curr_ndt)

                if not(field.exist(params,"fdr_year")) { params<"fdr_year"> : curr_year }
                if not(field.exist(params,"fdr_month")) { params<"fdr_month"> : curr_month }

                conditions = conditions + " AND YEAR(#<fdr_field>) = @fdr_year AND MONTH(#<fdr_field>) = @fdr_month"
                break
            }
            case "lastdays"
            {
                if not(field.exist(params,"fdr_range")) { params<"fdr_range"> : 30 } // Últimos 30 días

                conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN ADDDATE(DATE(NOW()), INTERVAL -@fdr_range DAY) AND DATE(NOW())"
                break
            }
            case "range"
            {
                if not(field.exist(params,"fdr_from"))
                {
                    curr_ndt = ndatetime.now()
                    subt_ndt = ndatetime.add(curr_ndt, -30, "d")
                    ult_30_days = ndatetime.tostr(subt_ndt, "yyyy-MM-dd")

                    params<"fdr_from"> : ult_30_days
                }
                if not(field.exist(params,"fdr_to")) { params<"fdr_to"> : date_str(now(),"yyyy-MM-dd") }

                if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) BETWEEN @fdr_from AND @fdr_to"
                }
                else if trim(@@(params,"$fdr_from")) != "" && trim(@@(params,"$fdr_to")) == ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) >= @fdr_from"
                }
                else if trim(@@(params,"$fdr_from")) == "" && trim(@@(params,"$fdr_to")) != ""
                {
                    conditions = conditions + " AND DATE(#<fdr_field>) <= @fdr_to"
                }

                break
            }
        }

        if @@(params,"$s") != "" {
            conditions = conditions + " AND cxc.referencia LIKE CONCAT('%',@s,'%')"
        }

        conditions=ftext(conditions)
        params<"fdr_field">:fdr_field
        params<"conditions">:conditions

        return conditions
    }

    cte.obtenerBalance::&db,&params
    {
        //#region Balance()
        do dbr.apps.action.grant("GB23")

        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }
        params<"year">: ifstr(trim(@@(params,"year"))!="", @@(params,"year"), str(ndatetime.year(ndatetime.now())))
        params<"month">: ifstr(trim(@@(params,"month"))!="", @@(params,"month"), str(ndatetime.month(ndatetime.now())))

        conditions=cte.getConditionFilter(params)

        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion,'%Y-%m-%d') AS aplicacion,
            doc.const AS documento,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.notas,'') AS notas
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
        WHERE cxc.icliente = @_entity_id 
            #<conditions>
        ORDER BY cxc.fecha DESC
        LIMIT #<@default_max_rows>;
        "
        // AND IF(IFNULL(@s,'')='', true, cxc.referencia LIKE CONCAT('%',@s,'%'))
        // AND IF(IFNULL(@year,'')='', true, YEAR(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=@year)
        // AND IF(IFNULL(@month,'')='', true, (YEAR(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=IFNULL(@year,YEAR(NOW())) AND MONTH(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=@month))
        // AND IF(IFNULL(@range,'-99')='-99', true, (DATE(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion)) BETWEEN DATE_ADD(NOW(), INTERVAL -"+str(@@(params,"#range"))+" DAY) AND NOW()))
        // AND IF(IFNULL(@datefrom,'')='', true, (DATE(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion)) BETWEEN DATE(@datefrom) AND DATE(@dateto)))
        // AND IF(IFNULL(@fd,'')='', true, DATE(cxc.aplicacion) BETWEEN @fd AND LAST_DAY(@fd))

        ref data = cte.obtenerCliente(db,@@(params,"_entity_id"))
        data<"saldos*"> : cte.obtenerSaldos(db,params)
        data<"docs*"> : dbr.list(db,ftext(sql),params)

        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cte.obtenerDocsPorCobrar::&db,&params
    {
        //#region DocsPorCobrar()
        do dbr.apps.action.grant("GB24")
        
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }
        params<"year">: ifstr(trim(@@(params,"year"))!="", @@(params,"year"), str(ndatetime.year(ndatetime.now())))
        params<"month">: ifstr(trim(@@(params,"month"))!="", @@(params,"month"), str(ndatetime.month(ndatetime.now())))

        conditions=cte.getConditionFilter(params)

        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion,'%Y-%m-%d') AS aplicacion,
            IFNULL(cxc.bonificaciones,0) AS bonificaciones,
            doc.const AS documento,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.intmoratorios,0) AS int_moratorios,
            IFNULL(cxc.pagos,0) AS pagos,
            (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS saldo
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
        WHERE cxc.icliente = @_entity_id
            AND (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) > 0
            #<conditions>
        ORDER BY cxc.fecha DESC
        LIMIT #<@default_max_rows>;
        "
        // AND IF(IFNULL(@s,'')='', true, cxc.referencia LIKE CONCAT('%',@s,'%'))
        // AND IF(IFNULL(@year,'')='', true, YEAR(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=@year)
        // AND IF(IFNULL(@month,'')='', true, (YEAR(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=IFNULL(@year,YEAR(NOW())) AND MONTH(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion))=@month))
        // AND IF(IFNULL(@range,'-99')='-99', true, (DATE(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion)) BETWEEN DATE_ADD(NOW(), INTERVAL -"+str(@@(params,"#range"))+" DAY) AND NOW()))
        // AND IF(IFNULL(@datefrom,'')='', true, (DATE(IF(IFNULL(@tdate,'0')='0',cxc.fecha,cxc.aplicacion)) BETWEEN DATE(@datefrom) AND DATE(@dateto)))

        ref data = cte.obtenerCliente(db,@@(params,"_entity_id"))
        data<"saldos*"> : cte.obtenerSaldos(db,params)
        data<"docs*"> : dbr.list(db,ftext(sql),params)

        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cte.obtenerCobrosPorAplicar::&db,&params
    {
        //#region CobrosPorAplicar()
        do dbr.apps.action.grant("GB25")
        
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }
        params<"year">: ifstr(trim(@@(params,"year"))!="", @@(params,"year"), str(ndatetime.year(ndatetime.now())))
        params<"month">: ifstr(trim(@@(params,"month"))!="", @@(params,"month"), str(ndatetime.month(ndatetime.now())))

        conditions=cte.getConditionFilter(params)

        sql = "
            SELECT
                cxc.sys_pk,
                cxc.sys_guid,
                cxc.referencia,
                DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
                doc.id AS idocumento,
                doc.const AS documento,
                IFNULL(cxc.debe,0) AS debe,
                IFNULL(cxc.haber,0) AS haber,
                (IFNULL(cxc.debe,0) - IFNULL(cxc.xaplicar,0)) AS aplicado,
                IFNULL(cxc.xaplicar,0) AS xaplicar
            FROM dcxc AS cxc
                INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
            WHERE cxc.icliente = @_entity_id
                AND IFNULL(cxc.xaplicar,0) > 0
                -- AND (IFNULL(cxc.haber,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) > 0
                #<conditions>
            ORDER BY cxc.fecha DESC
            LIMIT #<@default_max_rows>;
        "
        // AND IF(IFNULL(@s,'')='', true, cxc.referencia LIKE CONCAT('%',@s,'%'))
        // AND IF(IFNULL(@year,'')='', true, YEAR(cxc.fecha)=@year)
        // AND IF(IFNULL(@month,'')='', true, (YEAR(cxc.fecha)=IFNULL(@year,YEAR(NOW())) AND MONTH(cxc.fecha)=@month))
        // AND IF(IFNULL(@range,'-99')='-99', true, (DATE(cxc.fecha) BETWEEN DATE_ADD(NOW(), INTERVAL -"+str(@@(params,"#range"))+" DAY) AND NOW()))
        // AND IF(IFNULL(@datefrom,'')='', true, (DATE(cxc.fecha) BETWEEN DATE(@datefrom) AND DATE(@dateto)))

        ref data = cte.obtenerCliente(db,@@(params,"_entity_id"))
        data<"saldos*"> : cte.obtenerSaldos(db,params)
        data<"docs*"> : dbr.list(db,ftext(sql),params)

        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }
    
