    cte.list::&db,&params
    {
        //#region list()
        do dbr.apps.action.grant("GB20")
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }
        
        sql_clientes = "
        SELECT
            cte.sys_pk,
            cte.codigo,
            cte.nombre,
            IFNULL(cte.rfc,'') AS rfc,
            IFNULL(cte.saldo,0) AS saldo,
            tpc.descripcion AS tipo,
            dvs.codigo AS divisa,
            dvs.tcambio,
            IFNULL(zna.nombre,'') AS zona
        FROM cliente AS cte
            INNER JOIN tipocliente AS tpc ON tpc.sys_pk = cte.tipo
            INNER JOIN divisa AS dvs ON dvs.sys_pk = cte.idivisa
            LEFT JOIN zona AS zna ON zna.sys_pk = cte.zona
        WHERE NOT IFNULL(cte.sys_deleted,0)
            #<conditions>
        ORDER BY cte.codigo
        LIMIT #<@default_max_rows>;
        "

        conditions = ""
        if @@(params,"#fil_tipo") > 0 { conditions = conditions + " AND tpc.sys_pk = @fil_tipo" }
        if trim(@@(params,"$fil_text")) != "" {
            conditions = conditions + " AND (
                cte.codigo = @fil_text
                OR cte.rfc = @fil_text
                OR cte.nombre LIKE CONCAT('%',@fil_text,'%')
            )
            "
        }

        new data
        {
            @"data*": dbr.list(db,ftext(sql_clientes),params)
            @"list_tipos*": dbr.list(db,"select sys_pk, descripcion from tipocliente where not ifnull(sys_deleted,0)",@null)
        }
        do setPrintTitles(db,data)
    
        return data

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

