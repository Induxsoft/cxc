    cleanFormData::&fields,&data,&output
    {
        for i = 0; i < list.count(fields)
        {
            field = trim(list.str(fields,i))
            // 1 - $ | 2 - # | 3 - * | 0 - not exist

            switch field.typeof(data,field)
            {
                case 1
                {
                    str = trim(field.str(data,field))
                    if str != "" { output<field> : str }
                    else if str == "" { output<field+"*"> : @null }
                    break
                }
                case 2
                {
                    output<field> : field.num(data,field)
                    break
                }
                case 3
                {
                    ref obj = field.obj(data,field)
                    output<field+"*"> : obj
                    break
                }
            }
        }
    }

    validateFields::&data
    {
        if trim(@@(data,"$nombre")) == "" { do rise_error(511,"El valor de 'Nombre' es requerido.") }
        if @@(data,"#tipo") < 1 { do rise_error(512,"El valor de 'Tipo' es requerido.") }
        if @@(data,"#idivisa") < 1 { do rise_error(513,"El valor de 'Divisa' es requerido.") }

        curp = toupper(trim(@@(data,"$curp")))
        if curp != ""
        {
            if length(curp) != 18 { do rise_error(514,"El valor de 'CURP' no tiene la longitud requerida (18).") }
            // Validar formato general.
            curp_regex = "^([A-Z][AEIOUX][A-Z]{2}\\d{2}(?:0\\d|1[0-2])(?:[0-2]\\d|3[01])[HM](?:AS|B[CS]|C[CLMSH]|D[FG]|G[TR]|HG|JC|M[CNS]|N[ETL]|OC|PL|Q[TR]|S[PLR]|T[CSL]|VZ|YN|ZS)[B-DF-HJ-NP-TV-Z]{3}[A-Z\\d])(\\d)$"
            if not(Regex.IsMatch(curp,curp_regex)) { do rise_error(515,"El valor de 'CURP' no tiene un formato válido.") }

            data<"curp"> : curp
        }
        rfc = toupper(trim(@@(data,"$rfc")))
        if rfc != ""
        {
            if not(between(length(rfc),12,13)) { do rise_error(516,"El valor de 'RFC' no tinene la longitud requerida (12-13).") }
            // Validar formato general.
            rfc_regex = "^[A-Z&Ñ]{3,4}[0-9]{2}(0[1-9]|1[012])(0[1-9]|[12][0-9]|3[01])[A-Z0-9]{2}[0-9A]$"
            if not(Regex.IsMatch(rfc,rfc_regex)) { do rise_error(517,"El valor de 'RFC' no tiene un formato válido.") }

            data<"rfc"> : rfc
        }
    }

    cte.create::&db,&params,&data
    {
        //#region create()
        @use_transaction = @false
        do dbr.apps.action.pre("GB21")

        ref fieldsCliente = split("codcuenta,regfiscal,codigo,curp,descuento,diascredito,email,fax,limitecredito,monedero,nombre,notas,precio,puntos,rfc,saldo,saldopuntos,status,telefonos,website,agente,contacto1,contacto2,contacto3,idivisa,tipo,zona",",")
        
        chq_domicilio1 = parse.bool(@@(data,"$chq_domicilio1"))
        chq_domicilio2 = parse.bool(@@(data,"$chq_domicilio2"))
        chq_domicilio3 = parse.bool(@@(data,"$chq_domicilio3"))
        otorgar_credito = parse.bool(@@(data,"$chq_otorgar_credito"))
        limitar_credito = parse.bool(@@(data,"$rd_limitar_credito"))
        
        // Datos del nuevo cliente
        ref cliente = record.create()
        if trim(@@(data,"$codigo")) == "" {
            sql_gen_code = "SELECT (IF(COUNT(*) >= 1,CONCAT('CL',LPAD(CAST(MAX(SUBSTR(codigo,4,4))+1 AS CHAR),'4','0')),'CL0001')) AS codigo FROM cliente WHERE codigo LIKE 'CL%';"
            codigo = dbr.str(db,sql_gen_code,@null)
            cliente<"codigo"> : codigo
            data<"codigo"> : codigo
        }
        do cleanFormData(fieldsCliente,data,cliente)
        if otorgar_credito && not(limitar_credito) { cliente<"limitecredito"> : -1 }
        cliente<"uf_addenda"> : parse.bool(@@(data,"$chq_addenda"))

        do validateFields(cliente)

        validate_rfc=dbr.vars.get(db,"VALIDAR_RFC")
        if field.exist(data,'rfc') && parse.bool(validate_rfc)
        {
            using params{@"rfc":@@(data,"$rfc")}
            ref dtrfc=dbr.rec(db,"select * from cliente c where rfc=@rfc and sys_pk<>@_entity_id",params)
            if not(isnull(dtrfc)){do rise_error(500,"Ya existe un cliente con el mismo RFC")}
        }
        
        do dbr.begin(db)

        // Datos de domicilios
        if chq_domicilio1
        {
            new domicilio1
            {
                @"codpos": trim(@@(data,"$codpos"))
                @"colonia": trim(@@(data,"$colonia"))
                @"direccion": "||" + trim(@@(data,"$calle")) + "|" + trim(@@(data,"$numext")) + "|" + trim(@@(data,"$numint")) + "||"
                @"notas": trim(@@(data,"$dm_notas"))
                @"telefonos": trim(@@(data,"$dm_telefonos"))
                @"iciudad": @@(data,"#iciudad")
                @"numint": trim(@@(data,"$numint"))
                @"numext": trim(@@(data,"$numext"))
            }
            
            cliente<"domicilio1"> : @@(dbr.save(db,"domicilio",domicilio1),"#sys_pk")
        }
        if chq_domicilio2
        {
            new domicilio2
            {
                @"codpos": trim(@@(data,"$codpos2"))
                @"colonia": trim(@@(data,"$colonia2"))
                @"direccion": "||" + trim(@@(data,"$calle2")) + "|" + trim(@@(data,"$numext2")) + "|" + trim(@@(data,"$numint2")) + "||"
                @"notas": trim(@@(data,"$dm_notas2"))
                @"telefonos": trim(@@(data,"$dm_telefonos2"))
                @"iciudad": @@(data,"#iciudad2")
                @"numint": trim(@@(data,"$numint2"))
                @"numext": trim(@@(data,"$numext2"))
            }

            cliente<"domicilio2"> : @@(dbr.save(db,"domicilio",domicilio2),"#sys_pk")
        }
        if chq_domicilio3
        {
            new domicilio3
            {
                @"codpos": trim(@@(data,"$codpos3"))
                @"colonia": trim(@@(data,"$colonia3"))
                @"direccion": "||" + trim(@@(data,"$calle3")) + "|" + trim(@@(data,"$numext3")) + "|" + trim(@@(data,"$numint3")) + "||"
                @"notas": trim(@@(data,"$dm_notas3"))
                @"telefonos": trim(@@(data,"$dm_telefonos3"))
                @"iciudad": @@(data,"#iciudad3")
                @"numint": trim(@@(data,"$numint3"))
                @"numext": trim(@@(data,"$numext3"))
            }

            cliente<"domicilio3"> : @@(dbr.save(db,"domicilio",domicilio3),"#sys_pk")
        }

        ref entity = @@(entity.create(db,params,cliente),"&cliente")
        
        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        encript_url_exit=@false
        switch toupper(trim(@@(data,"$shortcut")))
        {
            case "F6"
            {
                @url_redir = replace(@CTE_CONSULTAR,"{_cliente}",@@(entity,"$sys_pk"))
                break
            }
            case "F8"
            {
                @url_redir = @CXC_CLIENTES
                encript_url_exit=@true
                if trim(@@(params,"$url_exit"))!=""{@url_redir=url_dcode(@@(params,"$url_exit"))}
                break
            }
            case "F9"
            {
                @url_redir = @CTE_AGREGAR
                break
            }
        }
        
        if trim(@@(params,"$url_exit"))!="" && @url_redir!="" && not(encript_url_exit)
        {
            @url_redir=@url_redir + ifstr(contains(@url_redir,"?"),"&","?")+"url_exit="+ifstr(encript_url_exit,url_encode(@@(params,"$url_exit")),@@(params,"$url_exit"))
        }

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do cte.prepareView(db,params,data)
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cte.update::&db,&params,&data
    {
        //#region update()
        @use_transaction = @false
        do dbr.apps.action.pre("GB22")

        ref fieldsCliente = split("codcuenta,regfiscal,codigo,curp,descuento,diascredito,email,fax,limitecredito,monedero,nombre,notas,precio,puntos,rfc,saldo,saldopuntos,status,telefonos,website,agente,contacto1,contacto2,contacto3,idivisa,tipo,zona",",")

        chq_domicilio1 = parse.bool(@@(data,"$chq_domicilio1"))
        chq_domicilio2 = parse.bool(@@(data,"$chq_domicilio2"))
        chq_domicilio3 = parse.bool(@@(data,"$chq_domicilio3"))
        otorgar_credito = parse.bool(@@(data,"$chq_otorgar_credito"))
        limitar_credito = parse.bool(@@(data,"$rd_limitar_credito"))

        // Datos del nuevo cliente
        new cliente
        {
            @"sys_pk": @@(data,"#sys_pk")
            @"sys_timestamp*": now()
            @"sys_recver": @@(data,"#sys_recver")
        }
        if trim(@@(data,"$codigo")) == "" {
            sql_gen_code = "SELECT (IF(COUNT(*) >= 1,CONCAT('CL',LPAD(CAST(MAX(SUBSTR(codigo,4,4))+1 AS CHAR),'4','0')),'CL0001')) AS codigo FROM cliente WHERE codigo LIKE 'CL%';"
            codigo = dbr.str(db,sql_gen_code,@null)
            cliente<"codigo"> : codigo
            data<"codigo"> : codigo
        }
        do cleanFormData(fieldsCliente,data,cliente)
        if otorgar_credito && not(limitar_credito) { cliente<"limitecredito"> : -1 }
        cliente<"uf_addenda"> : parse.bool(@@(data,"$chq_addenda"))

        do validateFields(cliente)

        validate_rfc=dbr.vars.get(db,"VALIDAR_RFC")
        if field.exist(data,'rfc') && parse.bool(validate_rfc)
        {
            using params{@"rfc":@@(data,"$rfc")}
            ref dtrfc=dbr.rec(db,"select * from cliente c where rfc=@rfc and sys_pk<>@_entity_id",params)
            if not(isnull(dtrfc)){do rise_error(500,"Ya existe un cliente con el mismo RFC")}
        }
        
        do dbr.begin(db)

        // Datos de domicilios
        if chq_domicilio1
        {
            new domicilio1
            {
                @"sys_pk": @@(data,"#dm_sys_pk")
                @"sys_timestamp*": now()
                @"sys_recver": @@(data,"#dm_sys_recver")
                @"codpos": trim(@@(data,"$codpos"))
                @"colonia": trim(@@(data,"$colonia"))
                @"direccion": "||" + trim(@@(data,"$calle")) + "|" + trim(@@(data,"$numext")) + "|" + trim(@@(data,"$numint")) + "||"
                @"notas": trim(@@(data,"$dm_notas"))
                @"telefonos": trim(@@(data,"$dm_telefonos"))
                @"iciudad": @@(data,"#iciudad")
                @"numint": trim(@@(data,"$numint"))
                @"numext": trim(@@(data,"$numext"))
            }
            
            cliente<"domicilio1"> : @@(dbr.save(db,"domicilio",domicilio1),"#sys_pk")
        }
        if chq_domicilio2
        {
            new domicilio2
            {
                @"sys_pk": @@(data,"#dm_sys_pk2")
                @"sys_timestamp*": now()
                @"sys_recver": @@(data,"#dm_sys_recver2")
                @"codpos": trim(@@(data,"$codpos2"))
                @"colonia": trim(@@(data,"$colonia2"))
                @"direccion": "||" + trim(@@(data,"$calle2")) + "|" + trim(@@(data,"$numext2")) + "|" + trim(@@(data,"$numint2")) + "||"
                @"notas": trim(@@(data,"$dm_notas2"))
                @"telefonos": trim(@@(data,"$dm_telefonos2"))
                @"iciudad": @@(data,"#iciudad2")
                @"numint": trim(@@(data,"$numint2"))
                @"numext": trim(@@(data,"$numext2"))
            }

            cliente<"domicilio2"> : @@(dbr.save(db,"domicilio",domicilio2),"#sys_pk")
        }
        if chq_domicilio3
        {
            new domicilio3
            {
                @"sys_pk": @@(data,"#dm_sys_pk3")
                @"sys_timestamp*": now()
                @"sys_recver": @@(data,"#dm_sys_recver3")
                @"codpos": trim(@@(data,"$codpos3"))
                @"colonia": trim(@@(data,"$colonia3"))
                @"direccion": "||" + trim(@@(data,"$calle3")) + "|" + trim(@@(data,"$numext3")) + "|" + trim(@@(data,"$numint3")) + "||"
                @"notas": trim(@@(data,"$dm_notas3"))
                @"telefonos": trim(@@(data,"$dm_telefonos3"))
                @"iciudad": @@(data,"#iciudad3")
                @"numint": trim(@@(data,"$numint3"))
                @"numext": trim(@@(data,"$numext3"))
            }

            cliente<"domicilio3"> : @@(dbr.save(db,"domicilio",domicilio3),"#sys_pk")
        }

        ref entity = @@(entity.update(db,params,cliente),"&cliente")
        
        do dbr.apps.action.pos(entity)
        do dbr.commit(db)
        do dbr.apps.action.ext(entity)

        encript_url_exit=@false
        switch toupper(trim(@@(data,"$shortcut")))
        {
            case "F6" //guardar
            {
                @url_redir = replace(@CTE_CONSULTAR,"{_cliente}",@@(entity,"$sys_pk"))
                
                break
            }
            case "F8" //guardar y salir
            {
                @url_redir = @CXC_CLIENTES
                encript_url_exit=@true
                if trim(@@(params,"$url_exit"))!=""{@url_redir=url_dcode(@@(params,"$url_exit"))}
                break
            }
            case "F9" //guardar y nuevo
            {
                @url_redir = @CTE_AGREGAR
                break
            }
        }

        if trim(@@(params,"$url_exit"))!="" && @url_redir!="" && not(encript_url_exit)
        {
            @url_redir=@url_redir + ifstr(contains(@url_redir,"?"),"&","?")+"url_exit="+ifstr(encript_url_exit,url_encode(@@(params,"$url_exit")),@@(params,"$url_exit"))
        }

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do cte.prepareView(db,params,data)
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }

    cte.delete::&db,&params
    {
        do rise_error(500,"Acción no implementada.")
    }

    cte.createTipo::&db,&params,&data
    {
        return data
    }
}