#include "dkli.dkh"
#!
module "model"
{
    @table_name = "cliente"
    @read_query = "
    SELECT
        sys_pk,
        sys_guid,
        sys_recver,
        IFNULL(codcuenta,'') codcuenta,
        codigo,
        IFNULL(curp,'') curp,
        IFNULL(descuento,0) descuento,
        IFNULL(diascredito,0) diascredito,
        IFNULL(email,'') email,
        IFNULL(fax,'') fax,
        IFNULL(limitecredito,0) limitecredito,
        IFNULL(monedero,0) monedero,
        nombre,
        IFNULL(notas,'') notas,
        IFNULL(precio,0) precio,
        IFNULL(puntos,0) puntos,
        IFNULL(rfc,'') rfc,
        IFNULL(saldo,0) saldo,
        IFNULL(saldopuntos,0) saldopuntos,
        status,
        IFNULL(telefonos,'') telefonos,
        IFNULL(website,'') website,
        agente,
        contacto1,
        contacto2,
        contacto3,
        domicilio1,
        domicilio2,
        domicilio3,
        idivisa,
        tipo,
        zona,
        uf_addenda
    FROM cliente
    WHERE #<@keyfield> = @_entity_id
    "

    cte.buscarCliente::&db,&params
    {
        sql = "
        SELECT
            cte.sys_pk,
            cte.sys_guid,
            cte.sys_recver,
            cte.codigo,
            cte.nombre,
            IFNULL(cte.rfc,'') AS rfc,
            IFNULL(cte.saldo,0) AS saldo,
            tpc.descripcion AS tipo,
            dvs.codigo AS divisa,
            dvs.tcambio,
            IFNULL(zna.nombre,'') AS zona
        FROM cliente AS cte
            INNER JOIN tipocliente AS tpc ON tpc.sys_pk = cte.tipo
            INNER JOIN divisa AS dvs ON dvs.sys_pk = cte.idivisa
            LEFT JOIN zona AS zna ON zna.sys_pk = cte.zona
        WHERE #<condition>
        "
        
        if trim(@@(params,"$id")) != "" {
            condition = "(cte.sys_pk = @id OR cte.sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = "(cte.codigo LIKE CONCAT('%',@search,'%') OR cte.nombre LIKE CONCAT('%',@search,'%') OR cte.rfc LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.buscarContacto::&db,&params
    {
        sql = "
        SELECT
            sys_pk,
            sys_guid,
            IFNULL(apellidos,'') apellidos,
            IFNULL(nombre,'') nombre,
            IFNULL(empresa,'') empresa,
            IFNULL(tratamiento,'') tratamiento
        FROM contacto
        WHERE #<condition>
        "
        if trim(@@(params,"$id")) != "" {
            condition = "(sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != "" {
            condition = "(apellidos LIKE CONCAT('%',@search,'%') OR nombre LIKE CONCAT('%',@search,'%') OR empresa LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.buscarEstado::&db,&params
    {
        sql = "
        SELECT
            sys_pk,
            sys_guid,
            sys_recver,
            codigo,
            nombre,
            ipais,
            CONCAT('[',codigo,'] ',nombre) AS `text`
        FROM edoprov 
        WHERE NOT IFNULL(sys_deleted,0) #<condition>
        ORDER BY sys_pk ASC;"

        if trim(@@(params,"$id")) != "" {
            condition = "AND (sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if @@(params,"#ipais") > 0 {
            condition = "AND ipais = @ipais"
            return dbr.list(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != {
            condition = "AND (codigo LIKE CONCAT('%',@search,'%') OR nombre LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.buscarCiudad::&db,params
    {
        sql = "
        SELECT
            sys_pk,
            sys_guid,
            sys_recver,
            codigo,
            nombre,
            codigotel,
            estado,
            CONCAT('[',codigo,'] ',nombre,' (',codigotel,')') AS `text`
        FROM ciudad
        WHERE NOT IFNULL(sys_deleted,0) #<condition>
        ORDER BY sys_pk ASC;
        "

        if trim(@@(params,"$id")) != "" {
            condition = "AND (sys_pk = @id OR sys_guid = @id)"
            return dbr.rec(db,ftext(sql),params)
        }
        if @@(params,"#iestado") > 0 {
            condition = "AND estado = @iestado"
            return dbr.list(db,ftext(sql),params)
        }
        if trim(@@(params,"$search")) != {
            condition = "AND (codigo LIKE CONCAT('%',@search,'%') OR nombre LIKE CONCAT('%',@search,'%'))"
            return dbr.list(db,ftext(sql),params)
        }
        return list.create()
    }

    cte.obtenerCliente::&db,id
    {
        new params { @"id": id }
        return cte.buscarCliente(db,params)
    }

    cte.prepareView::&db,&params,&data
    {
        params<"pk_dvs"> : get_idivisa_predeterminada()
        sql_divisa_predeterminada = "SELECT sys_pk, codigo, tcambio FROM divisa WHERE sys_pk = @pk_dvs;"

        switch @@(params,"$_view")
        {
            case "bonificacion"
            {
                data<"infoCliente*"> : cte.obtenerCliente(db,@@(params,"_entity_id"))
                sql = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxp_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.apl_bonific,0);"
                data<"documentos*"> : dbr.list(db,sql,@null)
                data<"dvsPred*"> : dbr.rec(db,sql_divisa_predeterminada,params)
                break
            }
            case "cobrar"
            {
                sql_cuentas = "SELECT c.sys_pk, d.codigo AS divisa, d.tcambio, CONCAT(c.nombre,' (',d.codigo,')') nombre FROM chequera c INNER JOIN divisa d ON d.sys_pk = c.idivisa WHERE NOT IFNULL(c.sys_deleted,0) ORDER BY c.sys_pk;"
                sql_categorias = "SELECT sys_pk,descripcion FROM categoria WHERE tipo = 1 AND NOT IFNULL(sys_deleted,0) ORDER BY sys_pk;"
                sql_doc_cobros = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_cxp_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.apl_pago,0);"
                sql_doc_depositos = "SELECT doc.id, doc.const FROM cdocumentos AS doc INNER JOIN cfg_chq_docs AS cfg ON cfg.documento = doc.id WHERE IFNULL(cfg.depositos,0);"

                data<"infoCliente*"> : cte.obtenerCliente(db,@@(params,"_entity_id"))
                data<"cuentas*"> : dbr.list(db,sql_cuentas,@null)
                data<"categorias*"> : dbr.list(db,sql_categorias,@null)
                data<"docCobros*"> : dbr.list(db,sql_doc_cobros,@null)
                data<"docDepositos*"> : dbr.list(db,sql_doc_depositos,@null)
                data<"dvsPred*"> : dbr.rec(db,sql_divisa_predeterminada,params)
                break
            }
            case ""
            {
                sql_tipos_clientes = "SELECT sys_pk, CONCAT('[',codigo,'] ',descripcion) AS `text` FROM tipocliente ORDER BY sys_pk ASC;"
                sql_divisas = "SELECT sys_pk, codigo, tcambio, CONCAT('[',codigo,'] ',descripcion) AS `text` FROM divisa ORDER BY sys_pk ASC;"
                sql_pais = "SELECT sys_pk, codigo, CONCAT('[',codigo,'] ',nombre,' (',codigotel,')') AS `text` FROM pais WHERE NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
                sql_estado = "SELECT sys_pk, codigo, ipais, CONCAT('[',codigo,'] ',nombre) AS `text` FROM edoprov WHERE NOT IFNULL(sys_deleted,0) AND ipais = @ipais ORDER BY sys_pk ASC;"
                sql_ciudad = "SELECT sys_pk, codigo, estado, CONCAT('[',codigo,'] ',nombre,' (',codigotel,')') AS `text` FROM ciudad WHERE NOT IFNULL(sys_deleted,0) AND estado = @iestado ORDER BY sys_pk ASC;"
                sql_agente = "SELECT sys_pk, CONCAT('[',codigo,'] ',nombre) AS `text` FROM agente WHERE NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
                sql_zona = "SELECT sys_pk, nombre AS `text` FROM zona WHERE NOT IFNULL(sys_deleted,0) ORDER BY sys_pk ASC;"
                sql_status = "SELECT id, const FROM cstatusorg ORDER BY id ASC;"

                new p {}
                ref list_pais = dbr.list(db,sql_pais,@null)
                ref list_estado = @null
                ref list_ciudad = @null

                if @@(params,"$_entity_id") != "_new"
                {
                    sql_domicilio = "
                    SELECT
                        dm.sys_pk,
                        dm.sys_guid,
                        dm.sys_recver,
                        IFNULL(dm.codpos,'') codpos,
                        IFNULL(dm.colonia,'') colonia,
                        IFNULL(dm.direccion,'') direccion,
                        IFNULL(dm.numint,'') numint,
                        IFNULL(dm.numext,'') numext,
                        IFNULL(dm.telefonos,'') telefonos,
                        IFNULL(dm.notas,'') notas,
                        dm.iciudad,
                        cd.estado iestado,
                        ed.ipais
                    FROM domicilio dm
                        INNER JOIN ciudad cd ON dm.iciudad = cd.sys_pk
                        INNER JOIN edoprov ed ON cd.estado = ed.sys_pk
                    WHERE #<condition>
                    "
                    ref cliente = entity.read(db,params)
                    using p
                    {
                        @"domicilio1": @@(cliente,"#domicilio1")
                        @"domicilio2": @@(cliente,"#domicilio2")
                        @"domicilio3": @@(cliente,"#domicilio3")
                    }
                    
                    data<"cliente*"> : cliente
                    condition = "dm.sys_pk = @domicilio1"
                    data<"domicilio1*"> : dbr.rec(db,ftext(sql_domicilio),p)
                    condition = "dm.sys_pk = @domicilio2"
                    data<"domicilio2*"> : dbr.rec(db,ftext(sql_domicilio),p)
                    condition = "dm.sys_pk = @domicilio3"
                    data<"domicilio3*"> : dbr.rec(db,ftext(sql_domicilio),p)
                }

                data<"list_tclientes*"> : dbr.list(db,sql_tipos_clientes,@null)
                data<"list_divisas*"> : dbr.list(db,sql_divisas,@null)
                data<"list_pais*"> : list_pais
                data<"list_estado*"> : list_estado
                data<"list_ciudad*"> : list_ciudad
                data<"list_agente*"> : dbr.list(db,sql_agente,@null)
                data<"list_zona*"> : dbr.list(db,sql_zona,@null)
                data<"list_status*"> : dbr.list(db,sql_status,@null)
                break
            }
        }
    }

    cte.obtenerSaldos::&db,&params
    {
        ejercicio = @@(params,"#ejercicio")
        periodo = @@(params,"#periodo")

        if ejercicio <= 0 { ejercicio = val(hoy("yyyy")) }
        if periodo <= 0 || periodo > 12 { periodo = val(hoy("MM")) }

        first_day = str(ejercicio) + "-" + str(periodo) + "-01"
        
        params<"ejercicio"> : ejercicio
        params<"periodo"> : periodo
        params<"fd"> : first_day

        sql_sinicial = "SELECT IFNULL(SUM(IFNULL(debe,0) - IFNULL(haber,0)),0) AS saldo_inicial FROM dcxc WHERE icliente = @_entity_id AND DATE(aplicacion) < @fd;"
        sql_dbe_hbr = "SELECT IFNULL(SUM(IFNULL(haber,0)),0) AS haber, IFNULL(SUM(IFNULL(debe,0)),0) AS debe FROM dcxc WHERE icliente = @_entity_id AND DATE(aplicacion) BETWEEN @fd AND LAST_DAY(@fd);"
        sql_stotal = "SELECT IFNULL(SUM(IFNULL(debe,0) - IFNULL(haber,0)),0) AS saldo_total FROM dcxc WHERE icliente = @_entity_id;"
        sql_sdocs = "SELECT IFNULL(SUM(IFNULL(haber,0) + IFNULL(intmoratorios,0) - IFNULL(pagos,0) - IFNULL(bonificaciones,0)),0) AS saldo_docs FROM dcxc WHERE icliente = @_entity_id AND aplicable;"

        sInicial = dbr.num(db,sql_sinicial,params)
        ref DebeHaber = dbr.rec(db,sql_dbe_hbr,params)
        sTotal = dbr.num(db,sql_stotal,params)
        sDocs = dbr.num(db,sql_sdocs,params)
        xAplicar = abs(sDocs - sTotal)
        // Saldo al final del periodo
        sFinalP = (sInicial + @@(DebeHaber,"#debe") - @@(DebeHaber,"#haber"))

        new saldos
        {
            @"saldo_inicial": sInicial
            @"debe": @@(DebeHaber,"#debe")
            @"haber": @@(DebeHaber,"#haber")
            @"saldo_total": sTotal
            @"saldo_docs": sDocs
            @"por_aplicar": xAplicar
            @"saldo_alfinal": sFinalP
        }

        return saldos
    }

    cte.obtenerBalance::&db,&params
    {
        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion,'%Y-%m-%d') AS aplicacion,
            doc.const AS documento,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.notas,'') AS notas
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
        WHERE cxc.icliente = @_entity_id 
            AND DATE(cxc.aplicacion) BETWEEN @fd AND LAST_DAY(@fd);
        "
        ref data = cte.obtenerCliente(db,@@(params,"_entity_id"))
        data<"saldos*"> : cte.obtenerSaldos(db,params)
        data<"docs*"> : dbr.list(db,sql,params)

        return data
    }

    cte.obtenerDocsPorCobrar::&db,&params
    {
        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            DATE_FORMAT(cxc.aplicacion,'%Y-%m-%d') AS aplicacion,
            IFNULL(cxc.bonificaciones,0) AS bonificaciones,
            doc.const AS documento,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.intmoratorios,0) AS int_moratorios,
            IFNULL(cxc.pagos,0) AS pagos,
            (IFNULL(cxc.haber,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS saldo
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
        WHERE cxc.icliente = @_entity_id
            AND (IFNULL(cxc.haber,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) > 0;
        "
        ref data = cte.obtenerCliente(db,@@(params,"_entity_id"))
        data<"saldos*"> : cte.obtenerSaldos(db,params)
        data<"docs*"> : dbr.list(db,sql,params)

        return data
    }

    cte.obtenerCobrosPorAplicar::&db,&params
    {
        sql = "
        SELECT
            cxc.sys_pk,
            cxc.sys_guid,
            cxc.referencia,
            DATE_FORMAT(cxc.fecha,'%Y-%m-%d') AS emision,
            doc.id AS idocumento,
            doc.const AS documento,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            (IFNULL(cxc.debe,0) - IFNULL(cxc.xaplicar,0)) AS aplicado,
            IFNULL(cxc.xaplicar,0) AS xaplicar
        FROM dcxc AS cxc
            INNER JOIN cdocumentos AS doc ON doc.id = cxc.documento
        WHERE cxc.icliente = @_entity_id
            AND IFNULL(cxc.xaplicar,0) > 0;
        "
        ref data = cte.obtenerCliente(db,@@(params,"_entity_id"))
        data<"saldos*"> : cte.obtenerSaldos(db,params)
        data<"docs*"> : dbr.list(db,sql,params)

        return data
    }
    
    cte.cobrarCliente::&db,&params,&data
    {
        do errordet(@false)
        do erp.cxc.movimientos.cobrarCliente(db,data)
        @url_redir = @CXC_CLIENTES

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do cte.prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    cte.bonificarCliente::&db,&params,&data
    {
        do errordet(@false)
        do erp.cxc.movimientos.bonificarCliente(db,data)
        @url_redir = @CXC_CLIENTES

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do cte.prepareView(db,params,data)
            do rise_error(last_error_code(),last_error())
        }
    }

    cte.list::&db,&params
    {
        buscar = trim(@@(params,"$buscar"))
        tipo = trim(@@(params,"$tipo"))

        sql = "
        SELECT
            cte.sys_pk,
            cte.codigo,
            cte.nombre,
            IFNULL(cte.rfc,'') AS rfc,
            IFNULL(cte.saldo,0) AS saldo,
            tpc.descripcion AS tipo,
            dvs.codigo AS divisa,
            dvs.tcambio,
            IFNULL(zna.nombre,'') AS zona
        FROM cliente AS cte
            INNER JOIN tipocliente AS tpc ON tpc.sys_pk = cte.tipo
            INNER JOIN divisa AS dvs ON dvs.sys_pk = cte.idivisa
            LEFT JOIN zona AS zna ON zna.sys_pk = cte.zona
        WHERE TRUE
        "
        if buscar != "" {
            sql = sql + " AND (
                cte.codigo LIKE CONCAT('%',@buscar,'%')
                OR cte.nombre LIKE CONCAT('%',@buscar,'%')
                OR cte.rfc LIKE CONCAT('%',@buscar,'%')
            )"
        }
        if tipo != "" {
            sql = sql + " AND (
                tpc.sys_pk = @tipo
                OR tpc.codigo = @tipo
                OR tpc.descripcion LIKE CONCAT('%',@tipo,'%')
            )"
        }

        return dbr.list(db,sql,params)
    }

    cte.read::&db,&params
    {
        new data {}
        do cte.prepareView(db,params,data)
        return data
    }

    cte.blank::&db,&params
    {
        new data {}
        do cte.prepareView(db,params,data)
        return data
    }

    cleanFormData::&fields,&data,&output
    {
        for i = 0; i < list.count(fields)
        {
            field = trim(list.str(fields,i))
            // 1 - $ | 2 - # | 3 - * | 0 - not exist
            switch field.typeof(data,field)
            {
                case 1
                {
                    str = trim(field.str(data,field))
                    if str != "" { output<field> : str }
                    break
                }
                case 2
                {
                    output<field> : field.num(data,field)
                    break
                }
                case 3
                {
                    ref obj = field.obj(data,field)
                    if not(isnull(obj)) { output<field+"*"> : obj }
                    break
                }
            }
        }
    }

    cte.create::&db,&params,&data
    {
        do errordet(@false)
        @use_transaction = @false

        ref fieldsCliente = split("codcuenta,codigo,curp,descuento,diascredito,email,fax,limitecredito,monedero,nombre,notas,precio,puntos,rfc,saldo,saldopuntos,status,telefonos,website,agente,contacto1,contacto2,contacto3,idivisa,tipo,zona",",")

        chq_domicilio1 = parse.bool(@@(data,"$chq_domicilio1"))
        chq_domicilio2 = parse.bool(@@(data,"$chq_domicilio2"))
        chq_domicilio3 = parse.bool(@@(data,"$chq_domicilio3"))

        // Datos del nuevo cliente
        ref cliente = record.create()
        if trim(@@(data,"$codigo")) == "" {
            sql_gen_code = "SELECT (IF(COUNT(*) >= 1,CONCAT('CL',LPAD(CAST(MAX(SUBSTR(codigo,4,4))+1 AS CHAR),'4','0')),'CL0001')) AS codigo FROM cliente WHERE codigo LIKE 'CL%';"
            cliente<"codigo"> : dbr.str(db,sql_gen_code,@null)
        }
        do cleanFormData(fieldsCliente,data,cliente)
        cliente<"uf_addenda"> : parse.bool(@@(data,"$chq_addenda"))

        do dbr.begin(db)
        // Datos de domicilios
        if chq_domicilio1
        {
            new domicilio1
            {
                @"codpos": trim(@@(data,"$codpos"))
                @"colonia": trim(@@(data,"$colonia"))
                @"direccion": "||" + trim(@@(data,"$calle")) + "|" + trim(@@(data,"$numext")) + "|" + trim(@@(data,"$numint")) + "||"
                @"notas": trim(@@(data,"$dm_notas"))
                @"telefonos": trim(@@(data,"$dm_telefonos"))
                @"iciudad": @@(data,"#iciudad")
                @"numint": trim(@@(data,"$numint"))
                @"numext": trim(@@(data,"$numext"))
            }
            
            cliente<"domicilio1"> : @@(dbr.save(db,"domicilio",domicilio1),"#sys_pk")
        }
        if chq_domicilio2
        {
            new domicilio2
            {
                @"codpos": trim(@@(data,"$codpos2"))
                @"colonia": trim(@@(data,"$colonia2"))
                @"direccion": "||" + trim(@@(data,"$calle2")) + "|" + trim(@@(data,"$numext2")) + "|" + trim(@@(data,"$numint2")) + "||"
                @"notas": trim(@@(data,"$dm_notas2"))
                @"telefonos": trim(@@(data,"$dm_telefonos2"))
                @"iciudad": @@(data,"#iciudad2")
                @"numint": trim(@@(data,"$numint2"))
                @"numext": trim(@@(data,"$numext2"))
            }

            cliente<"domicilio2"> : @@(dbr.save(db,"domicilio",domicilio2),"#sys_pk")
        }
        if chq_domicilio3
        {
            new domicilio3
            {
                @"codpos": trim(@@(data,"$codpos3"))
                @"colonia": trim(@@(data,"$colonia3"))
                @"direccion": "||" + trim(@@(data,"$calle3")) + "|" + trim(@@(data,"$numext3")) + "|" + trim(@@(data,"$numint3")) + "||"
                @"notas": trim(@@(data,"$dm_notas3"))
                @"telefonos": trim(@@(data,"$dm_telefonos3"))
                @"iciudad": @@(data,"#iciudad3")
                @"numint": trim(@@(data,"$numint3"))
                @"numext": trim(@@(data,"$numext3"))
            }

            cliente<"domicilio3"> : @@(dbr.save(db,"domicilio",domicilio3),"#sys_pk")
        }

        ref entity = @@(entity.create(db,params,cliente),"&cliente")
        do dbr.commit(db)

        switch toupper(trim(@@(data,"$shortcut")))
        {
            case "F6"
            {
                @url_redir = replace(@CTE_CONSULTAR,"{_cliente}",@@(entity,"$sys_pk"))
                break
            }
            case "F8"
            {
                @url_redir = @CXC_CLIENTES
                break
            }
            case "F9"
            {
                @url_redir = @CTE_AGREGAR
                break
            }
        }

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do cte.prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    cte.update::&db,&params,&data
    {
        do errordet(@false)
        @use_transaction = @false

        ref fieldsCliente = split("codcuenta,codigo,curp,descuento,diascredito,email,fax,limitecredito,monedero,nombre,notas,precio,puntos,rfc,saldo,saldopuntos,status,telefonos,website,agente,contacto1,contacto2,contacto3,idivisa,tipo,zona",",")

        chq_domicilio1 = parse.bool(@@(data,"$chq_domicilio1"))
        chq_domicilio2 = parse.bool(@@(data,"$chq_domicilio2"))
        chq_domicilio3 = parse.bool(@@(data,"$chq_domicilio3"))

        // Datos del nuevo cliente
        new cliente
        {
            @"sys_pk": @@(data,"#sys_pk")
            @"sys_timestamp*": now()
            @"sys_recver": @@(data,"#sys_recver")
        }
        if trim(@@(data,"$codigo")) == "" {
            sql_gen_code = "SELECT (IF(COUNT(*) >= 1,CONCAT('CL',LPAD(CAST(MAX(SUBSTR(codigo,4,4))+1 AS CHAR),'4','0')),'CL0001')) AS codigo FROM cliente WHERE codigo LIKE 'CL%';"
            cliente<"codigo"> : dbr.str(db,sql_gen_code,@null)
        }
        do cleanFormData(fieldsCliente,data,cliente)
        cliente<"uf_addenda"> : parse.bool(@@(data,"$chq_addenda"))

        do dbr.begin(db)
        // Datos de domicilios
        if chq_domicilio1
        {
            new domicilio1
            {
                @"sys_pk": @@(data,"#dm_sys_pk")
                @"sys_timestamp*": now()
                @"sys_recver": @@(data,"#dm_sys_recver")
                @"codpos": trim(@@(data,"$codpos"))
                @"colonia": trim(@@(data,"$colonia"))
                @"direccion": "||" + trim(@@(data,"$calle")) + "|" + trim(@@(data,"$numext")) + "|" + trim(@@(data,"$numint")) + "||"
                @"notas": trim(@@(data,"$dm_notas"))
                @"telefonos": trim(@@(data,"$dm_telefonos"))
                @"iciudad": @@(data,"#iciudad")
                @"numint": trim(@@(data,"$numint"))
                @"numext": trim(@@(data,"$numext"))
            }
            
            cliente<"domicilio1"> : @@(dbr.save(db,"domicilio",domicilio1),"#sys_pk")
        }
        if chq_domicilio2
        {
            new domicilio2
            {
                @"sys_pk": @@(data,"#dm_sys_pk2")
                @"sys_timestamp*": now()
                @"sys_recver": @@(data,"#dm_sys_recver2")
                @"codpos": trim(@@(data,"$codpos2"))
                @"colonia": trim(@@(data,"$colonia2"))
                @"direccion": "||" + trim(@@(data,"$calle2")) + "|" + trim(@@(data,"$numext2")) + "|" + trim(@@(data,"$numint2")) + "||"
                @"notas": trim(@@(data,"$dm_notas2"))
                @"telefonos": trim(@@(data,"$dm_telefonos2"))
                @"iciudad": @@(data,"#iciudad2")
                @"numint": trim(@@(data,"$numint2"))
                @"numext": trim(@@(data,"$numext2"))
            }

            cliente<"domicilio2"> : @@(dbr.save(db,"domicilio",domicilio2),"#sys_pk")
        }
        if chq_domicilio3
        {
            new domicilio3
            {
                @"sys_pk": @@(data,"#dm_sys_pk3")
                @"sys_timestamp*": now()
                @"sys_recver": @@(data,"#dm_sys_recver3")
                @"codpos": trim(@@(data,"$codpos3"))
                @"colonia": trim(@@(data,"$colonia3"))
                @"direccion": "||" + trim(@@(data,"$calle3")) + "|" + trim(@@(data,"$numext3")) + "|" + trim(@@(data,"$numint3")) + "||"
                @"notas": trim(@@(data,"$dm_notas3"))
                @"telefonos": trim(@@(data,"$dm_telefonos3"))
                @"iciudad": @@(data,"#iciudad3")
                @"numint": trim(@@(data,"$numint3"))
                @"numext": trim(@@(data,"$numext3"))
            }

            cliente<"domicilio3"> : @@(dbr.save(db,"domicilio",domicilio3),"#sys_pk")
        }

        ref entity = @@(entity.update(db,params,cliente),"&cliente")
        do dbr.commit(db)

        switch toupper(trim(@@(data,"$shortcut")))
        {
            case "F6"
            {
                @url_redir = replace(@CTE_CONSULTAR,"{_cliente}",@@(entity,"$sys_pk"))
                break
            }
            case "F8"
            {
                @url_redir = @CXC_CLIENTES
                break
            }
            case "F9"
            {
                @url_redir = @CTE_AGREGAR
                break
            }
        }

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }

            ref formData = record.copy(data,"*")
            code = last_error_code()
            error = last_error()

            do record.clear(data)
            data<"form*"> : formData
            
            do cte.prepareView(db,params,data)
            do rise_error(code,error)
        }
    }

    cte.delete::&db,&params
    {
        do rise_error(500,"Acción no implementada.")
    }
}