#include "dkli.dkh"
#!
module "cte.cobro.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"
    #include "../_lib/icons.dk"
    
    do @context.begin(@crud_context)

    ref formData = ifnull(@("&./form"),record.create())
    ref cliente = ifnull(@("&./infoCliente"),record.create())
    ref cuentas = ifnull(@('&./cuentas'),list.create())
    ref categorias = ifnull(@('&./categorias'),list.create())
    ref docCobros = ifnull(@('&./docCobros'),list.create())
    ref docDepositos = ifnull(@('&./docDepositos'),list.create())
    ref dvsPred = ifnull(@("&./dvsPred"),record.create())

    cDIVISA_PRED = field.dstr(dvsPred,"codigo","MXN")
    tCAMBIO_PRED = field.dnum(dvsPred,"tcambio",1)

    @DECIMAL_PRECISION = @("#parameters/decimals")

    num_step = "0."+padright("",(@DECIMAL_PRECISION-1),"0")+"1"
    num_max = "9999999999."+padright("",@DECIMAL_PRECISION,"9")

    new sel_cuenta_deposito
    {
        @"datatable*": cuentas
        @"id": "sel_cuenta_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "cuenta_deposito"
            @"required": ""
        }
        new member "attr_options"
        {
            @"data-divisa": "#<@@(row,'$divisa')>"
            @"data-tcambio": "#<@@(row,'#tcambio')>"
        }
        @"value_field": "sys_pk"
        @"text_field": "nombre"
        @"selected": form("cuenta_deposito","nm",@null)
    }

    new sel_categoria_deposito
    {
        @"datatable*": categorias
        @"id": "sel_categoria_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "categoria_deposito"
            @"required": ""
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": form("categoria_deposito","nm",@null)
    }

    new sel_documento_deposito
    {
        @"datatable*": docDepositos
        @"id": "sel_documento_deposito"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento_deposito"
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento_deposito","nm",@null)
    }

    new sel_documento_cobro
    {
        @"datatable*": docCobros
        @"id": "sel_documento_cobro"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "documento_cobro"
            @"required": ""
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": form("documento_cobro","nm",@null)
    }

    #$
    div(class="container-lg")
    {
        div(class="row container-section m-0 px-0 py-2 my-2 border-bottom sticky-top bg-white" id="main_action_bar")
        {
            div(class="col-4 d-flex align-items-center p-0") { h5(class="tex-no-break m-0"){$"Cobro a cliente"} }
            div(class="col-8 d-flex justify-content-end align-items-center p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@ICON_ARROW_CLOCKWISE>"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn_save"){$"#<@ICON_SAVE> Guardar"}
                a(href="#<@CXC_CLIENTES>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Salir"){$"#<@ICON_X_LG>"}
            }
        }

        form(action="." method="POST" id="form_cobro") //onsubmit="return cliente.form.ValidateForm(event)"
        {
            input(type="hidden" name="icliente" value="#<@@(cliente,'#sys_pk')>")

            div(class="row")
            {
                div(class="col-lg-8")
                {
                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bold"){$"Cliente:"}
                        div(class="col-6") {
                            $"[#<@@(cliente,'$codigo')>] #<@@(cliente,'$nombre')>"
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label fw-bold"){$"Divisa:"}
                        div(class="col-6") {
                            $"#<@@(cliente,'$divisa')>"
                        }
                    }

                    hr{}

                    h6(class="tex-no-break m-0"){$"Información bancaria"}

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_cuenta_deposito"){$"Cuenta:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_cuenta_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_categoria_deposito"){$"Categoria:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_categoria_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_documento_deposito"){$"Documento:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_documento_deposito)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center d-none" id="div_tcambio_deposito")
                    {
                        label(class="col-auto col-form-label" "for"="txt_tcambio_deposito"){$"Tipo de cambio:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm") {
                                input(
                                    class="form-control rounded-0 induxsoft-num-field mw-100"
                                    type="number" name="tcambio_deposito" value="#<form('tcambio_deposito','nm',@null)>" id="txt_tcambio_deposito"
                                    step="#<num_step>" min="1" max="#<num_max>" required="true"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                )
                                span(class="input-group-text rounded-0" id="spn_tcambio_deposito"){$"#<cDIVISA_PRED>"}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center d-none" id="div_importe_deposito")
                    {
                        label(class="col-auto col-form-label" "for"="txt_importe_deposito"){$"Importe:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm"){
                                input(
                                    class="form-control rounded-0 induxsoft-num-field mw-100"
                                    type="number" name="importe_deposito" value="#<form('importe_deposito','nm',@null)>" id="txt_importe_deposito"
                                    step="#<num_step>" min="1" max="#<num_max>"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                )
                                span(class="input-group-text rounded-0" id="spn_importe_deposito"){$""}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        div(class="col-6") {
                            div(class="form-check") {
                                input(class="form-check-input" type="checkbox" name="conciliado" id="ch_conciliado" checked="checked")
                                label(class="form-check-label" "for"="ch_conciliado"){$"Conciliado"}
                            }
                        }
                    }

                    hr{}

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="sel_documento_cobro"){$"Tipo de documento:"}
                        div(class="col-6") {
                            ##
                            do uie.dbSelect(sel_documento_cobro)
                            ##
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_referencia"){$"Referencia:"}
                        div(class="col-6") {
                            input(type="text" class="form-control form-control-sm rounded-0" name="referencia" id="txt_referencia" value="#<form('referencia','tx',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_fdoc"){$"Fecha del documento:"}
                        div(class="col-6") {
                            input(type="date" class="form-control form-control-sm rounded-0" name="fecha" id="txt_fdoc" value="#<form('fecha','dt',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_faplicacion"){$"Fecha de aplicación:"}
                        div(class="col-6") {
                            input(type="date" class="form-control form-control-sm rounded-0" name="faplicacion" id="txt_faplicacion" value="#<form('faplicacion','dt',@null)>" required="true")
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center d-none" id="div_tcambio")
                    {
                        label(class="col-auto col-form-label" "for"="txt_tcambio"){$"Tipo de cambio:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm") {
                                input(
                                    class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100"
                                    type="number" name="tcambio" value="#<form('tcambio','nm',cliente)>" id="txt_tcambio"
                                    step="#<num_step>" min="1" max="#<num_max>" required="true"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                )
                                span(class="input-group-text rounded-0"){$"#<cDIVISA_PRED> = 1 #<@@(cliente,'$divisa')>"}
                            }
                        }
                    }

                    div(class="row d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_importe"){$"Importe:"}
                        div(class="col-6") {
                            div(class="input-group input-group-sm") {
                                input(
                                    class="form-control form-control-sm rounded-0 induxsoft-num-field mw-100 validate-number"
                                    type="number" name="importe" value="#<form('importe','nm',@null)>" id="txt_importe"
                                    step="#<num_step>" min="1" max="#<num_max>" required="true"
                                    "num-decs"="#<@DECIMAL_PRECISION>"
                                    onkeypress="return InduxsoftNumberFields.filterFloat(event,this,#<@DECIMAL_PRECISION>)"
                                )
                                span(class="input-group-text rounded-0"){$"#<@@(cliente,'$divisa')>"}
                            }
                        }
                    }

                    div(class="row mt-1 d-flex justify-content-end align-items-center")
                    {
                        label(class="col-auto col-form-label" "for"="txt_notas"){$"Notas:"}
                        div(class="col-6") {
                            textarea(class="form-control rounded-0" name="notas" id="txt_notas" required="true")
                            {
                                #!
                                concepto = form('notas','tx',@null)
                                if concepto == "" { concepto = "Cobro a: [" + @@(cliente,'$codigo') + "] " + @@(cliente,'$nombre') }
                                #$
                                $"#<concepto>"
                            }
                        }
                    }
                }
            }
        }

        p{$"#<@('$error/message')>"}

        div
        {
            script(src="#<@JS_CLIENTES>"){$""}
            script(type="text/javascript")
            {$'
                document.addEventListener("DOMContentLoaded", () => {
                    cliente.cobro.dtCliente = #<to.json(cliente)>;
                    cliente.cobro.dvsPred = #<to.json(dvsPred)>;
                    cliente.cobro.decimals = #<@DECIMAL_PRECISION>;
                    cliente.cobro.init();
                    cliente.cobro.pedirTCambio();
                    InduxsoftNumberFields.Init();
                });
            '}
        }
    }
}