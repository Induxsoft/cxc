#include "dkli.dkh"
#!
module "controller"
{
    switch @@(@http_context,"$request/get/_view")
    {
        case "buscar-cliente"
        {
            point @list to cte.buscarCliente
            break
        }
        case "buscar-contacto"
        {
            point @list to cte.buscarContacto
            break
        }
        case "buscar-edoprov"
        {
            point @list to cte.buscarEstado
            break
        }
        case "buscar-ciudad"
        {
            point @list to cte.buscarCiudad
            break
        }
        case "buscar-tcliente"
        {
            point @list to cte.buscarTipos
            break
        }
        case "bonificacion"
        {
            point @read to cte.blank
            point @update to cte.bonificarCliente
            @form_view = "cte.bonificacion.dk"
            break
        }
        case "cobrar"
        {
            point @read to cte.blank
            point @update to cte.cobrarCliente
            @form_view = "cte.cobro.dk"
            break
        }
        case "balance"
        {
            point @read to cte.obtenerBalance
            @form_view = "cte.balance.dk"
            break
        }
        case "pendientes"
        {
            point @read to cte.obtenerDocsPorCobrar
            @form_view = "cte.pendientes.dk"
            break
        }
        case "xaplicar"
        {
            point @read to cte.obtenerCobrosPorAplicar
            @form_view = "cte.poraplicar.dk"
            break
        }
        case "tipo"
        {
            point @create to cte.createTipo
            break
        }
        case ""
        {
            point @list to cte.list
            point @read to cte.read
            point @blank to cte.blank

            point @create to cte.create
            point @update to cte.update
            point @delete to cte.delete
            break
        }
    }
}