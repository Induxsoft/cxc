#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"
    #include "../_lib/lib.dk"
    
    do @context.begin(@crud_context)
    ref @http_context = @('&http')
    ref get = @@(@http_context,"&request/get")
    ref listClientes = ifnull(@("&."),list.create())

    context = to.json(@null)

    new table_definition
    {
        @"datatable*": listClientes
        @"table_footer": "Mostrando los primeros # clientes ordenados por código"
        member @"columns"
        {
            member @"codigo" { @"caption":"Código" }
            member @"nombre" { @"caption":"Nombre" }
            member @"rfc" { @"caption":"RFC" }
            member @"saldo" { @"caption":"Saldo" }
            member @"tipo" { @"caption":"Tipo de cliente" }
            member @"divisa" { @"caption":"Divisa" }
            member @"zona" { @"caption":"Zona" }
            member @"_actions" 
            { 
                @"caption":"Acciones" 
                @"template":'<a href="./${DataRow.sys_pk}/" class="no-print">Editar</a>'
                @"no-print":@true
            }
        }
    }
    
    header_act::
    {
        jg = dbr.num(@("&database"),"SELECT sys_pk FROM jobsgroup WHERE name = 'CXC'",@null)

        #! if AppExist(@("&database"),"batch") {
            #$
            a(href="#<@BATCH_TASKMAN>#<jg>/importar.cliente?exit_url_encode=#<url_encode(@CXC_CLIENTES)>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Importar clientes") {
                $"#<@ICON_FILE_CSV>"
            }
        }

        #$
        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="cliente.goTo('#<@CTE_EDO_CTA>')"){$"Estado de cuenta"}

        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="cliente.goTo('#<@CTE_DOCS_XCOBRAR>')"){$"Documentos por cobrar"}

        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="cliente.goTo('#<@CTE_COBROS_XAPLICAR>')"){$"Cobros por aplicar"}

        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="cliente.goTo('#<@CTE_COBROS>')"){$"Cobro a cliente"}

        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" onclick="cliente.goTo('#<@CTE_BONIFICACIONES>')"){$"Bonificaciones"}
    }

    #! point general_act to header_act

    new nav_config
    {
        @"title": "Clientes"
        member @"hidden"
        {
            @"print": @false
        }
        @"buttons*": general_act
        @"urlexit": "/"
        @"actions*": dbr.apps.itemactions(@('&database'),"cliente","action","",0)
        @"reports*": dbr.apps.itemactions(@('&database'),"cliente","report","",0)
        @"jscurrentcontext": "cliente.getCurrentContext"
    }

    #$
    div(class="container-fluid p-0")
    {
        #! do uie.printV12FormBar(nav_config)
        
        #$ div(id="work_area" class="container-section mt-1 p-2 pt-0")
        {
            p{$"#<@('$error/message')>"}

            form(action="./" method="GET" id="form_search" class="no-print my-1 d-flex py-1")
            {
                "filter-text"(
                    "id"="ft_search"
                    "text-field"="buscar"
                    "placeholder"="Buscar por código, nombre o RFC"
                    "form"="#form_search"
                    "value"="#<@@(get,'$buscar')>"
                    "auto-submit"="true"
                    "class"="w-100"
                ){$""}
                a(href="#<@CTE_AGREGAR>" class="btn btn-light btn-sm induxsoft-corners" type="button" id="btn_new_cliente" title="Nuevo cliente" style="outline: 1px solid #DDD;"){$"#<@ICON_USER_ADD>"}
            }

            #! do uie.dbeditable(table_definition, "tbl_clientes")
        }

        #$ div
        {
            script(src="#<@JS_CLIENTES>"){$""}
            script(type="text/javascript")
            {$'
                document.addEventListener("DOMContentLoaded", () => {
                    cliente.tableId = "tbl_clientes";
                    cliente.init();
                    cliente.list.init();
                    cliente.encode = #<context>;
                });
            '}
        }
    }
}