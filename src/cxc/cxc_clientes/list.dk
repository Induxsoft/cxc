#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"
    
    do @context.begin(@crud_context)
    
    #$
    div(class="container")
    {
        h1(class="h4 text-primary"){$"Clientes"}

        div
        {
            div(class="bg-light my-1")
            {
                div(class="btn-group" role="group")
                {
                    a(href="#<@CXC_MENU>" class="btn btn-secondary btn-sm fw-bolder"){$"<--"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@CTE_EDO_CTA>')"){$"Estado de cuenta"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@CTE_DOCS_XCOBRAR>')"){$"Documentos por cobrar"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@CTE_COBROS_XAPLICAR>')"){$"Cobros por aplicar"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@CTE_COBROS>')"){$"Cobro a cliente"}
                    button(type="button" class="btn btn-light btn-sm fw-bolder" onclick="goTo('#<@CTE_BONIFICACIONES>')"){$"Bonificaciones"}
                    a(href="./" class="btn btn-light btn-sm fw-bolder"){$"Refrescar"}
                }
            }

            "edit-table"(class="w-100" id="tbl_clientes" data="#<to.json(@('&.'))>")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="NoEditable" field="codigo"){$"Código"}
                        "edit-th"(type="NoEditable" field="nombre"){$"Nombre"}
                        "edit-th"(type="NoEditable" field="rfc"){$"RFC"}
                        "edit-th"(type="NoEditable" field="saldo"){$"Saldo"}
                        "edit-th"(type="NoEditable" field="tipo"){$"Tipo de cliente"}
                        "edit-th"(type="NoEditable" field="divisa"){$"Divisa"}
                        "edit-th"(type="NoEditable" field="zona"){$"Zona"}
                    }
                }
            }
        }

        p{$"#<@('$error/message')>"}

        script
        {$'
            var table = document.getElementById("tbl_clientes");

            function goTo(url)
            {
                if (!url) { alert("No se ha indicado un destino."); return; }
                if (table.CurrentRowIndex() < 0) { alert("Debe seleccionar una fila"); return; }

                var data = table.DataArray[table.CurrentRowIndex()];

                var url = url.replace("_cliente",data.sys_pk);
                window.location.href = url;
            }
        '}
    }
}