#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "dbr.vars.dkl"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"
    #include "../_lib/lib.dk"
    
    do @context.begin(@crud_context)
    context = to.json(@null)

    new fil_tipo_cliente
    {
        @"id": "fil_tipo"
        @"datatable*": ifnull(@("&./list_tipos"),list.create())
        new member @"attributes"
        {
            @"class": "induxsoft-form-select"
            @"name": "fil_tipo"
            @"title": "Filtrar por tipo de cliente"
            @"onchange": "document.querySelector('#form_filter').submit()"
        }
        @"first_text": "(Todos los tipos)"
        @"first_value": "-1"
        @"text_field": "descripcion"
        @"value_field": "sys_pk"
        @"selected": @("#parameters/fil_tipo")
    }

    new table_definition
    {
        @"datatable*": ifnull(@("&./data"),list.create())
        @"table_footer": "Mostrando los primeros # clientes ordenados por código"
        member @"columns"
        {
            member @"codigo" { @"caption":"Código" }
            member @"nombre" { @"caption":"Nombre" }
            member @"rfc" { @"caption":"RFC" }
            member @"tipo" { @"caption":"Tipo de cliente" }
            member @"saldo"
            {
                @"caption":"Saldo"
                @"align": "end"
                @"format": @true
                @"thousandssep": @true
                @"decs": @("#parameters/decimals")
            }
            member @"divisa"
            {
                @"caption":"Divisa"
                @"align": "center"
            }
            member @"zona" { @"caption":"Zona" }
        }
    }

    new nav_config
    {
        @"title": "Clientes"
        member @"hidden"
        {
            @"print": @false
        }
        @"buttons*": @null
        @"urlexit": "/"
        @"main": "GB28,GB21,GB22,GB23,GB24,GB25,GB26,GB27"
        @"actions*": dbr.apps.itemactions(@('&database'),"DET014","action","",0)
        @"reports*": dbr.apps.itemactions(@('&database'),"DET014","report","",0)
        @"jscurrentcontext": "cliente.getCurrentContext"
    }

    #$ div(class="v12-list-view" id="view")
    {
        section(class="container-fluid bg-white" id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$
            
            form(action="./" method="GET" id="form_filter" class="mb-1")
            {
                div(class="py-1 w-100 d-flex gap-2 flex-wrap align-items-center")
                {
                    div(class="d-flex gap-2")
                    {
                        div{#! do uie.dbSelect(fil_tipo_cliente) } #$
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-text"(
                            "id"="fil_text"
                            "text-field"="fil_text"
                            "placeholder"="Buscar por código, nombre o RFC"
                            "form"="#form_filter"
                            "value"="#<@('$parameters/fil_text')>"
                            "auto-submit"="true"
                            "class"="w-100"
                        ){$""}
                    }
                }
            }
        }
        
        section(class="container-fluid" id="work_area")
        {
            #!
            do uie.dbeditable(table_definition, "tbl_clientes")
            #$
        }

        div
        {
            script(src="#<@JS_CLIENTES>"){$""}
            script(type="text/javascript")
            {$'
                document.addEventListener("DOMContentLoaded", () => {
                    cliente.tableId = "tbl_clientes";
                    cliente.init();
                    cliente.list.init();
                    cliente.encode = #<context>;
                });
            '}
        }
    }
}