    cobrarCliente::&db,&data
    {
        namespace "erp.cxc.movimientos"

        start_transaction = @false

        tcambio_cte = @@(data,"#tcambio")
        tcambio_dep = @@(data,"#tcambio_deposito")

        importe_cte = @@(data,"#importe")
        importe_dep = (importe_cte * tcambio_cte)
        importe_dep = (importe_dep / tcambio_dep)

        new deposito
        {
            @"faplicacion": @@(data,"$faplicacion")
            @"conciliado": @@(data,"$conciliado")
            @"fecha": @@(data,"$fecha")
            @"importe": importe_dep
            @"concepto": @@(data,"$notas")
            @"referencia": @@(data,"$referencia")
            @"documento": @@(data,"#documento_deposito")
            @"icategoria": @@(data,"#categoria_deposito")
            @"icuenta": @@(data,"cuenta_deposito")
        }

        new dcxc
        {
            @"aplicable": @false
            @"aplicacion": @@(data,"$faplicacion")
            @"basecm": 0
            @"documento": @@(data,"#documento_cobro")
            @"fecha": @@(data,"$fecha")
            @"fultmoratorios": @@(data,"$faplicacion")
            @"notas": @@(data,"$notas")
            @"referencia": @@(data,"$referencia")
            @"tipocambio": tcambio_cte
            @"xaplicar": importe_cte
            @"icliente": @@(data,"#icliente")
        }

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        new p
        {
            @"icliente": @@(data,"#icliente")
            @"importe_cte": importe_cte
        }

        // Realizar deposito a la cuenta.
        dcxc<"imovcuenta"> : erp.efectivo.movimientos.deposito(db,deposito)
        // Generar documento por cobrar (dcxc) y Afectar saldo del cliente.
        do determinarImporteCxC(dcxc,importe_cte)
        do saveCxC(db,dcxc)

        if start_transaction { do dbr.commit(db) }

        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    bonificarCliente::&db,&data
    {
        namespace "erp.cxc.movimientos"

        start_transaction = @false

        new dcxc
        {
            @"aplicable": @false
            @"aplicacion": @@(data,"$faplicacion")
            @"basecm": 0
            @"documento": @@(data,"#documento")
            @"fecha": @@(data,"$fecha")
            @"fultmoratorios": @@(data,"$faplicacion")
            @"notas": @@(data,"$notas")
            @"referencia": @@(data,"$referencia")
            @"tipocambio": @@(data,"#tcambio")
            @"xaplicar": @@(data,"#importe")
            @"icliente": @@(data,"#icliente")
        }

        if @@(data,"#iventa") > 0 { dcxc<"iventa"> : @@(data,"#iventa") }

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }

        // Generar documento por cobrar (dcxc) y Afectar saldo del cliente.
        do determinarImporteCxC(dcxc,@@(data,"#importe"))
        do saveCxC(db,dcxc)

        if start_transaction { do dbr.commit(db) }

        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }
    
    desaplicarCobros::&db,&params
    {
        @use_transaction = @false

        do dbr.apps.action.pre("GB17")
        //do dbr.begin(db)

        // Obtener registros de aplicación de pagos no timbrados
        sql_aplicados = "
        SELECT
            apl.sys_pk AS id_aplicado,
            apl.fk_dcxc_aplicadoa AS id_origen,
            apl.aplicadoa as id_destino,
            IFNULL(apl.uf_cfdi,'') AS uf_cfdi,
            cxc.referencia,
            IFNULL(cxc.bonificaciones,0) AS bonificaciones,
            IFNULL(cxc.debe,0) AS debe,
            IFNULL(cxc.haber,0) AS haber,
            IFNULL(cxc.intmoratorios,0) AS int_moratorios,
            IFNULL(cxc.pagos,0) AS pagos,
            (IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) AS saldo,
            IFNULL(apl.importe,0) AS aplicado,
            ((IFNULL(cxc.debe,0) + IFNULL(cxc.intmoratorios,0) - IFNULL(cxc.pagos,0) - IFNULL(cxc.bonificaciones,0)) + IFNULL(apl.importe,0)) AS santerior
        FROM aplcxc AS apl
            INNER JOIN dcxc AS cxc ON apl.aplicadoa = cxc.sys_pk
        WHERE apl.fk_dcxc_aplicadoa = @_entity_id AND (TRIM(IFNULL(apl.uf_cfdi,''))='' OR apl.uf_cfdi='0')
        ORDER BY apl.sys_dtcreated ASC
        "
        // Documentos con importes aplicados del documento por aplicar
        ref aplicados = dbr.list(db,sql_aplicados,params)

        go foreach.lobj(value:apl) with(aplicados)
        {
            do dbr.begin(db)

            // Disminuir en pago al documento aplicado
            sql_disminuir_pago = "
            UPDATE dcxc 
                SET pagos = (IFNULL(pagos,0) - @aplicado) 
            WHERE sys_pk = @id_destino
            "
            do dbr.execute(db,sql_disminuir_pago,apl)
            
            // Aumentar en xaplicar al documento de origen
            sql_aumentar_xaplicar = "
            UPDATE dcxc 
                SET xaplicar = (IFNULL(xaplicar,0) + @aplicado)
            WHERE sys_pk = @id_origen
            "
            do dbr.execute(db,sql_aumentar_xaplicar,apl)

            // Eliminar registro de aplicado
            do dbr.delete(db,"aplcxc","sys_pk=@id_aplicado",apl)

            apl<"aplicado"> : 0

            do dbr.apps.action.pos(apl)
            do dbr.commit(db)
            
            exception
            {
                if dbr.in_transaction(db) { do dbr.rollback(db) }
                apl<"error"> : last_error()
            }
        }

        //do dbr.apps.action.pos(aplicados)
        //do dbr.commit(db)
        do dbr.apps.action.ext(aplicados)

        return aplicados

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            code = last_error_code()
            error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
    }
}